FROM fedora:latest

# Install core tools from Fedora repos
RUN dnf install -y \
    fish tmux neovim git gh eza fzf bat zoxide direnv glow \
    stow git-lfs openssh-clients curl procps-ng xz \
    golang python3 \
    && dnf clean all

# Bake GitHub's ed25519 host key. Verified at build time by cross-referencing
# ssh-keyscan against api.github.com/meta (different trust paths) — fails on
# mismatch. Lets git push/fetch over SSH run unattended.
RUN set -e; \
    SCANNED=$(ssh-keyscan -t ed25519 github.com 2>/dev/null); \
    SCANNED_FP=$(echo "$SCANNED" | ssh-keygen -lf - | awk '{print $2}' | sed 's/^SHA256://'); \
    META_FP=$(curl -fsSL https://api.github.com/meta \
        | python3 -c "import json,sys; print(json.load(sys.stdin)['ssh_key_fingerprints']['SHA256_ED25519'])" \
        | sed 's/^SHA256://'); \
    [ "$SCANNED_FP" = "$META_FP" ] || { \
        echo "github.com ed25519 fingerprint mismatch:" >&2; \
        echo "  ssh-keyscan: SHA256:$SCANNED_FP" >&2; \
        echo "  api/meta:    SHA256:$META_FP" >&2; \
        exit 1; \
    }; \
    mkdir -p /etc/ssh; \
    echo "$SCANNED" > /etc/ssh/ssh_known_hosts

# Install starship (not in Fedora repos). Pin the installer SCRIPT by sha256 (supply-
# chain: a tampered installer fails the build) — the tool version it fetches still floats.
# Bump the hash when upstream legitimately changes the script (see docker/claude/README).
RUN curl -fsSL https://starship.rs/install.sh -o /tmp/i.sh \
    && echo "52c64f14a558034ebeb1907ea9364e802b32474576fd3e68265f73bc33cc8fbb  /tmp/i.sh" | sha256sum -c - \
    && sh /tmp/i.sh -y && rm /tmp/i.sh

# Install lazygit (not in Fedora repos)
RUN dnf copr enable -y atim/lazygit && dnf install -y lazygit && dnf clean all

# Install TPM (tmux plugin manager)
RUN git clone https://github.com/tmux-plugins/tpm /usr/share/tmux-plugin-manager

# Create non-root user matching host UID for socket permissions
ARG HOST_UID=1000
RUN useradd -m -s /usr/bin/fish -u $HOST_UID dev

USER dev
WORKDIR /home/dev

# Install Claude Code (native binary into ~/.local/bin). Installer script pinned.
RUN curl -fsSL https://claude.ai/install.sh -o /tmp/i.sh \
    && echo "cde4f1702d3b1695f92b73d26888364e17bca476e17f0fd676484c951d36c125  /tmp/i.sh" | sha256sum -c - \
    && bash /tmp/i.sh && rm /tmp/i.sh

# Clone and stow dotfiles. DOT_PROFILE=headless → setup.sh stows shared + headless
# and skips host-only ssh-agent activation (no init system here; the agent is
# forwarded from the host via -e SSH_AUTH_SOCK at run time).
ENV DOT_PROFILE=headless
# DOT_REF bakes a specific branch (default main). docker-claude passes the dot repo's
# current branch so a rebuild tests the branch you're working on. The branch must be
# pushed; Docker caches the clone layer, so re-test a re-pushed branch with --no-cache.
ARG DOT_REF=main
RUN git clone --branch "$DOT_REF" --single-branch https://github.com/dmitriyb/dot.git /home/dev/dot \
    && cd /home/dev/dot \
    && bash setup.sh

# Install Nix (single-user, daemonless — there is no systemd in the container). Pairs
# with direnv for per-project devshells: a project with a flake.nix/.envrc pulls its
# exact toolchain (e.g. its own JDK) instead of baking versions into the image.
# /nix must be created by root, then handed to dev for the single-user install.
USER root
RUN mkdir -m 0755 /nix && chown dev /nix
USER dev
RUN curl -fsSL https://nixos.org/nix/install -o /tmp/i.sh \
    && echo "e9d447ce3d2ff62d7ff9cb6ef401de6fa8acb148839dd00f7271945d7b638b14  /tmp/i.sh" | sha256sum -c - \
    && sh /tmp/i.sh --no-daemon && rm /tmp/i.sh \
    && mkdir -p /home/dev/.config/nix \
    && echo 'experimental-features = nix-command flakes' > /home/dev/.config/nix/nix.conf

# Nix's curl (GnuTLS) rejects Fedora's CA bundle, so bootstrap from the store's nss-cacert
# for build-time TLS, then add nix-direnv. PATH is set directly: nix.sh no-ops under RUN
# since Docker doesn't export the $USER it guards on.
# The Nix installer already adds nss-cacert to the profile, so only top it up if missing —
# installing nixpkgs#cacert unconditionally collides when the registry's nss-cacert version
# differs from the installer's (both are unpinned), aborting the build non-deterministically.
RUN export PATH=/home/dev/.nix-profile/bin:$PATH \
        NIX_SSL_CERT_FILE="$(ls -d /nix/store/*-nss-cacert-*/etc/ssl/certs/ca-bundle.crt | head -n1)" \
    && { [ -e /home/dev/.nix-profile/etc/ssl/certs/ca-bundle.crt ] \
            || nix profile install nixpkgs#cacert; } \
    && nix profile install nixpkgs#nix-direnv \
    && mkdir -p /home/dev/.config/direnv \
    && echo 'source /home/dev/.nix-profile/share/nix-direnv/direnvrc' \
        > /home/dev/.config/direnv/direnvrc

# Nix env for fish (single-user install exposes ~/.nix-profile; installer only wires bash)
RUN printf '%s\n' \
    'set -gx PATH /home/dev/.nix-profile/bin $PATH' \
    'set -gx NIX_PATH /home/dev/.nix-defexpr/channels' \
    'set -gx NIX_SSL_CERT_FILE /home/dev/.nix-profile/etc/ssl/certs/ca-bundle.crt' \
    > /home/dev/.config/fish/conf.d/02-nix.fish

# Theme is set per-variant image (personal=catppuccin, work=gruvbox)

# Add cargo and go to PATH
RUN echo 'set -gx PATH ~/go/bin $PATH' \
    > /home/dev/.config/fish/conf.d/01-docker-path.fish

# Re-apply theme after __fish_config_interactive overwrites colors on first prompt
RUN printf '%s\n' \
    'function __fix_theme_colors --on-event fish_prompt' \
    '    source ~/.config/themes/current/fish.theme 2>/dev/null' \
    '    functions -e __fix_theme_colors' \
    'end' \
    > /home/dev/.config/fish/conf.d/99-theme-reload.fish

# Skip onboarding, set vim mode and theme
RUN echo '{"hasCompletedOnboarding":true}' > /home/dev/.claude.json

# Pre-create volume mount points (Docker copies ownership to new named volumes).
# ~/.claude already exists from setup.sh; only fish/tmux dirs are volume mountpoints.
RUN mkdir -p /home/dev/.local/share/fish /home/dev/.local/share/tmux

# Override tmux prefix for nested use (host uses C-a)
# Override tmux for nested use: C-b prefix, ctrl+arrow for window nav
RUN echo 'set -g prefix C-b' >> /home/dev/.config/tmux/tmux.conf \
    && echo 'bind C-b last-window' >> /home/dev/.config/tmux/tmux.conf \
    && echo 'unbind -n S-Left' >> /home/dev/.config/tmux/tmux.conf \
    && echo 'unbind -n S-Right' >> /home/dev/.config/tmux/tmux.conf \
    && echo 'bind -n C-Left previous-window' >> /home/dev/.config/tmux/tmux.conf \
    && echo 'bind -n C-Right next-window' >> /home/dev/.config/tmux/tmux.conf

# Install tmux plugins (increase git timeout for flaky Docker networking)
RUN git config --global http.lowSpeedLimit 1000 \
    && git config --global http.lowSpeedTime 60 \
    && /usr/share/tmux-plugin-manager/bin/install_plugins

# Pre-install neovim plugins
RUN nvim --headless "+Lazy! sync" +qa

# Install root-owned MANAGED Claude Code settings (highest precedence; the agent,
# running as dev, cannot override or edit these). Baseline = honest-path anti-bypass
# deny rules; the work image overlays a stricter superset. Real enforcement is the
# portitor proxy (later phase) — this is the casual/accidental-bypass floor.
USER root
RUN mkdir -p /etc/claude-code
COPY harness/managed-settings.base.json /etc/claude-code/managed-settings.json
RUN chmod 0644 /etc/claude-code/managed-settings.json
USER dev

WORKDIR /workspace
