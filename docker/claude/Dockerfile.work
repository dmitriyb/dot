FROM claude-dev-base

USER root

# Build tooling and openssh-server (for IDEA Remote Development); bun is installed below
RUN dnf install -y unzip openssh-server sudo gcc-c++ cmake ninja-build python3-pip wget && dnf clean all

# Configure sshd: non-privileged port, key-only auth
RUN ssh-keygen -A \
    && sed -i 's/^#Port 22/Port 2222/' /etc/ssh/sshd_config \
    && sed -i 's/^#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && sed -i 's/^#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
    && echo "AllowUsers dev" >> /etc/ssh/sshd_config \
    && mkdir -p /run/sshd

# Allow dev to start sshd without password
RUN echo "dev ALL=(root) NOPASSWD: /usr/sbin/sshd" >> /etc/sudoers.d/dev-sshd

# Overlay the work lockdown MANAGED settings (superset of base): the agent may not
# commit or push — you do those yourself. Root-owned, agent cannot override.
COPY harness/managed-settings.work.json /etc/claude-code/managed-settings.json
RUN chmod 0644 /etc/claude-code/managed-settings.json

USER dev

# Install bun. Installer script pinned by sha256.
RUN curl -fsSL https://bun.sh/install -o /tmp/i.sh \
    && echo "bab8acfb046aac8c72407bdcce903957665d655d7acaa3e11c7c4616beae68dd  /tmp/i.sh" | sha256sum -c - \
    && bash /tmp/i.sh && rm /tmp/i.sh

# Add bun to PATH
RUN echo 'set -gx PATH ~/.bun/bin $PATH' \
    >> /home/dev/.config/fish/conf.d/01-docker-path.fish

# Prepare SSH authorized_keys with host's dedicated key
RUN mkdir -p /home/dev/.ssh && chmod 700 /home/dev/.ssh
ARG DOCKER_CLAUDE_PUBKEY=""
RUN if [ -n "$DOCKER_CLAUDE_PUBKEY" ]; then \
        echo "$DOCKER_CLAUDE_PUBKEY" > /home/dev/.ssh/authorized_keys \
        && chmod 600 /home/dev/.ssh/authorized_keys; \
    fi

RUN /home/dev/.local/bin/theme-set gruvbox

COPY --chown=dev:dev entrypoint.work.fish /home/dev/entrypoint.fish

WORKDIR /workspace

# Debug logging and timeout tuning for large projects
ENV CLAUDE_CODE_DEBUG_LOG_LEVEL=verbose
ENV CLAUDE_ENABLE_STREAM_WATCHDOG=1
ENV API_TIMEOUT_MS=900000
ENV CLAUDE_STREAM_IDLE_TIMEOUT_MS=180000

EXPOSE 2222

ENTRYPOINT ["fish", "/home/dev/entrypoint.fish"]
