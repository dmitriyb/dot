{
  "effortLevel": "high",
  "permissions": {
    "deny": [
      "Bash(git commit --no-gpg-sign:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git config core.hooksPath:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/dev/.claude/budget/gate.py /home/dev/.claude/budget",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
