FROM claude-dev-base

USER root

# Install Zig
RUN dnf install -y zig && dnf clean all \
    || (curl -fsSL https://ziglang.org/download/0.14.0/zig-linux-aarch64-0.14.0.tar.xz \
        | tar -xJ -C /usr/local --strip-components=1)

USER dev

# Install beads_rust (pre-built binary)
RUN curl -fsSL https://raw.githubusercontent.com/Dicklesworthstone/beads_rust/main/install.sh | bash

# Install beads_viewer (TUI for beads dependency graphs)
RUN GOPATH=/home/dev/go go install github.com/Dicklesworthstone/beads_viewer/cmd/bv@latest

# Install Rust toolchain (needed for bvr)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

# Install beads_viewer_rust (graph-aware issue triage engine for .beads data)
RUN . "$HOME/.cargo/env" && cargo install --git https://github.com/Dicklesworthstone/beads_viewer_rust.git bvr

# Add cargo bin to PATH
RUN echo 'set -gx PATH ~/.cargo/bin $PATH' \
    >> /home/dev/.config/fish/conf.d/01-docker-path.fish

RUN /home/dev/.local/bin/theme-set catppuccin

COPY --chown=dev:dev entrypoint.personal.fish /home/dev/entrypoint.fish

WORKDIR /workspace
ENTRYPOINT ["fish", "/home/dev/entrypoint.fish"]
