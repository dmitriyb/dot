FROM claude-dev-base

USER root

# Install jq + minisign (Zig signature verification), plus openssh-server + sudo
# (for IDE Remote Development, mirrors work)
RUN dnf install -y jq minisign openssh-server sudo && dnf clean all

# Configure sshd: non-privileged port 2223 (work uses 2222; distinct so both can run), key-only auth
RUN ssh-keygen -A \
    && sed -i 's/^#Port 22/Port 2223/' /etc/ssh/sshd_config \
    && sed -i 's/^#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && sed -i 's/^#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
    && echo "AllowUsers dev" >> /etc/ssh/sshd_config \
    && mkdir -p /run/sshd

# Allow dev to start sshd without password
RUN echo "dev ALL=(root) NOPASSWD: /usr/sbin/sshd" >> /etc/sudoers.d/dev-sshd

# Install Zig (latest stable from upstream — Fedora's package lags releases). Verify the
# tarball with minisign against the Zig Software Foundation's public key (baked in below,
# reviewed once in git). This is genuine signature verification, not the index.json shasum
# — which is served from the same ziglang.org origin as the tarball, so a compromised
# origin/CDN would serve a matching hash. A signature cannot be forged without the ZSF
# private key, so it survives an origin compromise. minisign does not enforce that the
# signed file matches what you fetched, so we additionally assert the trusted comment
# names the exact tarball (blocks a valid-but-older-file substitution). The index's own
# tarball URL is used (robust to zig's archive-naming changes).
# ZSF public key, published at https://ziglang.org/download/ (long-lived, not per-release):
RUN PUBKEY=RWSGOq2NVecA2UPNdBUZykf1CCb147pkmdtYxgb3Ti+JO/wCYvhbAb/U \
    && IDX=$(curl -fsSL https://ziglang.org/download/index.json) \
    && ARCH=$(uname -m) \
    && KEY=$(echo "$IDX" | jq -r 'to_entries | map(select(.key != "master")) | .[0].key') \
    && URL=$(echo "$IDX" | jq -r ".\"${KEY}\".\"${ARCH}-linux\".tarball") \
    && FN=$(basename "$URL") \
    && curl -fsSL "$URL" -o /tmp/zig.tar.xz \
    && curl -fsSL "${URL}.minisig" -o /tmp/zig.tar.xz.minisig \
    && OUT=$(minisign -Vm /tmp/zig.tar.xz -x /tmp/zig.tar.xz.minisig -P "$PUBKEY" 2>&1) \
    && printf '%s\n' "$OUT" \
    && printf '%s\n' "$OUT" | grep -qF "file:${FN}" \
    && tar -xJ -C /usr/local --strip-components=1 -f /tmp/zig.tar.xz \
    && rm /tmp/zig.tar.xz /tmp/zig.tar.xz.minisig

USER dev

# Install beads_rust (pre-built binary). Not script-pinned — see README "Installer trust".
RUN curl -fsSL https://raw.githubusercontent.com/Dicklesworthstone/beads_rust/main/install.sh | bash

# Install beads_viewer (TUI for beads dependency graphs)
RUN GOPATH=/home/dev/go go install github.com/Dicklesworthstone/beads_viewer/cmd/bv@latest

# Install Rust toolchain (needed for bvr). Not script-pinned — see README "Installer trust".
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

# Install beads_viewer_rust (graph-aware issue triage engine for .beads data).
# --locked uses the upstream Cargo.lock for reproducible dependency versions.
RUN . "$HOME/.cargo/env" && cargo install --locked --git https://github.com/Dicklesworthstone/beads_viewer_rust.git beads_viewer_rust

# Add cargo bin to PATH
RUN echo 'set -gx PATH ~/.cargo/bin $PATH' \
    >> /home/dev/.config/fish/conf.d/01-docker-path.fish

RUN /home/dev/.local/bin/theme-set catppuccin

# Prepare SSH authorized_keys with host's dedicated key (same key as work; the
# entrypoint also appends any forwarded-agent keys at runtime)
RUN mkdir -p /home/dev/.ssh && chmod 700 /home/dev/.ssh
ARG DOCKER_CLAUDE_PUBKEY=""
RUN if [ -n "$DOCKER_CLAUDE_PUBKEY" ]; then \
        echo "$DOCKER_CLAUDE_PUBKEY" > /home/dev/.ssh/authorized_keys \
        && chmod 600 /home/dev/.ssh/authorized_keys; \
    fi

COPY --chown=dev:dev entrypoint.personal.fish /home/dev/entrypoint.fish

WORKDIR /workspace

EXPOSE 2223

ENTRYPOINT ["fish", "/home/dev/entrypoint.fish"]
