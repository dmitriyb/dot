#!/usr/bin/env bash
# on_failure hook (implement) — runs HOST-SIDE after a failed implement step,
# with the failed step's inputs as FABER_INPUT_* and the error record as JSON on
# stdin. Idempotent by design (it also runs between retry attempts).
#
# In this model the claim commit lived only in the box's ephemeral clone
# (discarded with --rm), so the CANONICAL bead state on main is untouched by a
# failure before merge — there is usually nothing to reopen. The one durable
# side-effect a failed step can leave is a pushed feature branch on portitor;
# deleting it is the portitor client's job and is wired at the portitor step.
set -euo pipefail

err="$(cat || true)"    # {"reason":...,"detail":...,"handoff":...}
bead="${FABER_INPUT_BEAD:-<unknown>}"

echo "release-bead: implement failed for $bead: $err" >&2

# Best-effort branch cleanup (portitor step): once the portitor/pr client is on
# the host PATH, delete the abandoned feature branch here, e.g.:
#   pr close-branch --repo "${FABER_INPUT_REPO}" --bead "$bead"   # or portitor equivalent
# Kept as a no-op until then so the hook never fails the retry path.
exit 0
