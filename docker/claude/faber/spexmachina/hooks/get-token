#!/usr/bin/env bash
# faber credentials resolver — get_token(service).
#
# faber invokes this HOST-SIDE as `get-token <service>`, stdin closed, and reads
# the token from stdout (trailing newline trimmed). It NEVER runs inside the box;
# only its output is delegated (file mode -> a tmpfs /run/secrets/<service> file
# the box's secrets phase exports into the agent env, shredded after the run).
#
# Personal-account wiring, mirroring dot's dcp: the Claude Code OAuth setup-token
# lives in the macOS keychain under service=anthropic account=personal. The
# service name `claude_code_oauth_token` is chosen so the box exports it as
# CLAUDE_CODE_OAUTH_TOKEN — the env var Claude Code honors for a setup-token.
#
# Create the token once:
#   claude setup-token
#   security add-generic-password -s anthropic -a personal -w '<token>'
set -euo pipefail

service="${1:?usage: get-token <service>}"

case "$service" in
  claude_code_oauth_token)
    security find-generic-password -s anthropic -a personal -w
    ;;
  *)
    echo "get-token: no wiring for service '$service'" >&2
    exit 1
    ;;
esac
