{
  "default_branch": "main",
  "allowed_signers": "/etc/portitor/allowed_signers",
  "upstream_remote": "upstream",
  "upstream_slug": "dmitriyb/spexmachina",
  "require_up_to_date_with_default": true,
  "roles": {
    "SHA256:REPLACE_WITH_IMPLEMENTER_KEY_FINGERPRINT": "implementer",
    "SHA256:REPLACE_WITH_REVIEWER_KEY_FINGERPRINT": "reviewer",
    "SHA256:REPLACE_WITH_MERGER_KEY_FINGERPRINT": "merger"
  },
  "role_rules": [
    {
      "name": "bead-close-reviewer-only",
      "path_glob": ".beads/issues.jsonl",
      "added_regex": "\"status\"\\s*:\\s*\"closed\"",
      "allowed_roles": ["reviewer", "owner"]
    }
  ]
}
