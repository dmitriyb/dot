#!/usr/bin/env python3
"""The owner's budget for the current Claude Code session (run it as `! budget ...`; the gate refuses it to Claude).
  budget                     show this session's budget, spend and main context
  budget 80M                 set: limit 80M, counted from now (replaces any budget of this session)
  budget 80M --context 150k  the same, and cap the main context: past 150k the session may not launch agents
  budget --context 150k      set or change only the context cap (--context off removes it)
  budget +20M                raise this session's limit by 20M
  budget off                 remove this session's budget"""
import datetime, glob, json, os, re, sys
D = os.path.expanduser("~/.claude/budget")
sys.path.insert(0, D)
import gate


def tokens(s):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([kKmM]?)", s)
    if not m:
        sys.exit(f"budget: not an amount: {s} (write 80M, 500k or 200000)")
    return int(float(m.group(1)) * {"": 1, "k": 10**3, "m": 10**6}[m.group(2).lower()])


def main(argv):
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        sys.exit("budget: CLAUDE_CODE_SESSION_ID is not set; run it inside the session as `! budget ...`")
    args, ctx = list(argv), None
    if "--context" in args:
        i = args.index("--context")
        if i + 1 >= len(args):
            sys.exit("budget: --context needs an amount, as `--context 150k`, or `off`")
        ctx = args[i + 1]
        del args[i:i + 2]
    path = os.path.join(D, "budgets", f"{sid}.json")
    cur = json.load(open(path)) if os.path.exists(path) else None
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
    if args == ["off"] and ctx is None:
        if cur:
            os.remove(path)
        print(f"budget: none for session {sid}")
        return 0
    if len(args) > 1 or args == ["off"]:
        sys.exit(__doc__)
    if args:
        if args[0].startswith("+"):
            if not cur or cur.get("limit") is None:
                sys.exit("budget: no token limit to raise; set one first, as `budget 80M`")
            cur["limit"] += tokens(args[0][1:])
        else:
            cur = {"session_id": sid, "start": now, "limit": tokens(args[0])}
    if ctx is not None:
        cur = cur or {"session_id": sid, "start": now, "limit": None}
        cur["context_limit"] = None if ctx == "off" else tokens(ctx)
    if args or ctx is not None:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        json.dump(cur, open(path, "w"))
        cur = json.load(open(path))
    if not cur:
        print(f"budget: none for session {sid}")
        return 0
    tp = next(iter(glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl"))), None)
    spent, cross, _ = gate.spend(tp, cur["start"], cur.get("limit")) if tp else (0, None, {})
    limit = f"{cur['limit']:,}" if cur.get("limit") is not None else "no limit"
    line = f"budget: session {sid}: {spent:,} of {limit} tokens since {cur['start']}" + (f"; limit reached at {cross}" if cross else "")
    if cur.get("context_limit"):
        line += f"; main context {gate.context(tp) if tp else 0:,} of a {cur['context_limit']:,} cap"
    print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
