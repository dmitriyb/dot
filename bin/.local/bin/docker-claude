#!/usr/bin/env bash
set -euo pipefail

BASE_IMAGE="claude-dev-base"
PERSONAL_IMAGE="claude-dev-personal"
WORK_IMAGE="claude-dev-work"
MODE=""
REBUILD=false
NO_CACHE=false

# Parse flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--personal)
            MODE="personal"
            shift
            ;;
        -w|--work)
            MODE="work"
            shift
            ;;
        --direct)
            MODE="direct"
            shift
            ;;
        -r|--rebuild)
            REBUILD=true
            shift
            ;;
        --no-cache)
            NO_CACHE=true
            REBUILD=true
            shift
            ;;
        --workspace)
            WORKSPACE="$2"
            shift 2
            ;;
        *)
            echo "Unknown flag: $1"
            echo "Usage: docker-claude (-p|--personal | -w|--work | --direct) [-r] [--no-cache] [--workspace <path>]"
            exit 1
            ;;
    esac
done

# Build images if missing or rebuild requested
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && cd ../../.. && pwd)/docker/claude"
BUILD_ARGS=(--build-arg HOST_UID="$(id -u)")

build_base() {
    echo "Building $BASE_IMAGE..."
    if [[ "$NO_CACHE" == true ]]; then
        docker build --no-cache "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
    else
        docker build "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
    fi
}

build_personal() {
    echo "Building $PERSONAL_IMAGE..."
    docker build -f "$SCRIPT_DIR/Dockerfile.personal" -t "$PERSONAL_IMAGE" "$SCRIPT_DIR"
}

build_work() {
    # Generate dedicated SSH key for IDEA Remote Development if missing
    local key_path="$HOME/.ssh/docker_claude_id_ed25519"
    if [[ ! -f "$key_path" ]]; then
        echo "Generating SSH key for Docker Claude IDEA access..."
        ssh-keygen -t ed25519 -f "$key_path" -N "" -C "docker-claude"
    fi
    local pubkey
    pubkey=$(cat "$key_path.pub")

    echo "Building $WORK_IMAGE..."
    docker build \
        --build-arg "DOCKER_CLAUDE_PUBKEY=$pubkey" \
        -f "$SCRIPT_DIR/Dockerfile.work" -t "$WORK_IMAGE" "$SCRIPT_DIR"
}

if [[ "$REBUILD" == true ]]; then
    build_base
    if [[ -z "$MODE" ]]; then
        build_personal
        build_work
        exit 0
    fi
    [[ "$MODE" == "personal" ]] && build_personal
    [[ "$MODE" == "work" || "$MODE" == "direct" ]] && build_work
else
    if ! docker image inspect "$BASE_IMAGE" &>/dev/null; then
        build_base
    fi
    if [[ "$MODE" == "personal" ]] && ! docker image inspect "$PERSONAL_IMAGE" &>/dev/null; then
        build_personal
    fi
    if [[ "$MODE" == "work" || "$MODE" == "direct" ]] && ! docker image inspect "$WORK_IMAGE" &>/dev/null; then
        build_work
    fi
fi

if [[ -z "$MODE" ]]; then
    echo "Error: specify account mode."
    echo "Usage: docker-claude (-p|--personal | -w|--work | --direct) [-r] [--workspace <path>]"
    exit 1
fi

# Platform-specific default workspace
if [[ -z "${WORKSPACE:-}" ]]; then
    if [[ "$(uname)" == "Darwin" ]]; then
        WORKSPACE="$HOME/work"
    else
        WORKSPACE="$HOME/Work"
    fi
fi


# Resolve credentials from OS keychain
get_personal_token() {
    if [[ "$(uname)" == "Darwin" ]]; then
        security find-generic-password -s anthropic -a personal -w 2>/dev/null
    else
        secret-tool lookup service anthropic account personal 2>/dev/null
    fi
}

get_work_key() {
    if [[ "$(uname)" == "Darwin" ]]; then
        security find-generic-password -s "Claude Code" -w 2>/dev/null
    else
        secret-tool lookup service "Claude Code" 2>/dev/null
    fi
}

get_personal_gh_token() {
    if [[ "$(uname)" == "Darwin" ]]; then
        security find-generic-password -s gh -a personal -w 2>/dev/null
    else
        secret-tool lookup service gh account personal 2>/dev/null
    fi
}

get_work_gh_token() {
    if [[ "$(uname)" == "Darwin" ]]; then
        security find-generic-password -s gh -a work -w 2>/dev/null
    else
        secret-tool lookup service gh account work 2>/dev/null
    fi
}

# Fill GH_ARGS with "-e GH_TOKEN=<token>" if a token is stored for $1,
# else leave GH_ARGS empty and warn. GH_TOKEN makes the in-container
# `gh` CLI stateless — no hosts.yml written, auth owned by host keychain.
resolve_gh_args() {
    local label="$1" token
    case "$label" in
        personal) token=$(get_personal_gh_token) ;;
        work)     token=$(get_work_gh_token) ;;
    esac
    GH_ARGS=()
    if [[ -n "${token:-}" ]]; then
        GH_ARGS=(-e "GH_TOKEN=$token")
    else
        echo "Note: no gh token in keychain (service=gh, account=$label). 'gh' CLI in container will be unauthenticated." >&2
        echo "  macOS: security add-generic-password -s gh -a $label -w '<PAT>'" >&2
        echo "  Linux: secret-tool store --label='gh $label' service gh account $label" >&2
    fi
}

# Persistent volumes for fish history and tmux resurrect (targeted mounts
# so image-baked binaries like claude and nvim plugins aren't shadowed)
# SSH agent forwarding
SSH_AGENT_ARGS=(-v "$SSH_AUTH_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent)
# Docker Desktop (macOS) mounts sockets as root:root — need group access
if [[ "$(uname)" == "Darwin" ]]; then
    SSH_AGENT_ARGS+=(--group-add 0)
fi

FISH_DATA_VOLUME="claude-fish-data"
TMUX_DATA_VOLUME="claude-tmux-data"

if [[ "$MODE" == "personal" ]]; then
    TOKEN=$(get_personal_token)
    if [[ -z "$TOKEN" ]]; then
        echo "Error: No personal OAuth token found in keychain."
        echo ""
        echo "Generate a setup token from an authenticated Claude Code instance:"
        echo "  claude setup-token"
        echo ""
        echo "Then store it:"
        echo "  macOS: security add-generic-password -s anthropic -a personal -w '<token>'"
        echo "  Linux: secret-tool store --label='anthropic' service anthropic account personal"
        exit 1
    fi
    PERSONAL_REPO_VOLUME="claude-personal-repos"
    resolve_gh_args personal

    exec docker run -it --rm \
        --memory=8g --cpus=4 \
        -e CLAUDE_CODE_OAUTH_TOKEN="$TOKEN" \
        -v claude-personal:/home/dev/.claude \
        -v "$PERSONAL_REPO_VOLUME":/workspace \
        -v "$FISH_DATA_VOLUME":/home/dev/.local/share/fish \
        -v "$TMUX_DATA_VOLUME":/home/dev/.local/share/tmux \
        "${SSH_AGENT_ARGS[@]}" \
        ${GH_ARGS[@]+"${GH_ARGS[@]}"} \
        "$PERSONAL_IMAGE"
fi

# Common work args (shared between wire and direct modes)
WORK_REPO_VOLUME="claude-work-repos"
WORK_COMMON_ARGS=(
    -it --rm
    --memory=8g --cpus=4
    -e JETBRAINS_MCP_STREAM_URL=http://host.docker.internal:64342/stream
    -v claude-work:/home/dev/.claude
    -v "$WORK_REPO_VOLUME":/workspace
    -v "$FISH_DATA_VOLUME":/home/dev/.local/share/fish
    -v "$TMUX_DATA_VOLUME":/home/dev/.local/share/tmux
    "${SSH_AGENT_ARGS[@]}"
    -p 2222:2222
)

if [[ "$MODE" == "work" ]]; then
    # Wire proxy mode (default work mode)
    if ! command -v wire &>/dev/null; then
        echo "Error: wire CLI not found. Install it first."
        exit 1
    fi
    WIRE_KEY=$(wire proxy start --ensure-updated --return-key)
    if [[ -z "$WIRE_KEY" ]]; then
        echo "Error: failed to start wire proxy or get key."
        exit 1
    fi
    WIRE_PORT=$(wire config 2>&1 | awk '/Proxy port:/{print $3}')
    WIRE_BASE_URL="http://host.docker.internal:${WIRE_PORT}/wire/${WIRE_KEY}/claude-code/anthropic"
    resolve_gh_args work

    exec docker run \
        "${WORK_COMMON_ARGS[@]}" \
        -e ANTHROPIC_API_KEY=wire-proxy \
        -e ANTHROPIC_BASE_URL="$WIRE_BASE_URL" \
        ${GH_ARGS[@]+"${GH_ARGS[@]}"} \
        "$WORK_IMAGE"
fi

if [[ "$MODE" == "direct" ]]; then
    # Direct API key mode (from OS keychain)
    KEY=$(get_work_key)
    if [[ -z "$KEY" ]]; then
        echo "Error: No work API key found in keychain."
        echo ""
        echo "Log into Claude Code with your work account first (claude login)."
        echo "The key is stored automatically in macOS Keychain."
        exit 1
    fi
    resolve_gh_args work

    exec docker run \
        "${WORK_COMMON_ARGS[@]}" \
        -e ANTHROPIC_API_KEY="$KEY" \
        ${GH_ARGS[@]+"${GH_ARGS[@]}"} \
        "$WORK_IMAGE"
fi
