#!/bin/bash
# prelude hook (implement-next / epic pull-loop) — runs IN the box, AFTER
# next-bead-context and BEFORE the agent, with the delegated implementer
# identity. Claims the bead the context hook selected ($bundle/selected-bead):
# feature branch off the default, signed in_progress claim, branch declared as
# the step's side-effect. On a done-cycle ($bundle/epic-done) it does nothing —
# no branch, no claim, no BRANCH declaration (faber then verifies no
# side-effect), and the agent just emits {"done":true}.
set -euo pipefail

die() { echo "claim-next-bead: $*" >&2; exit 1; }
bundle="${FABER_BUNDLE_DIR:?FABER_BUNDLE_DIR is required}"

if [ -f "$bundle/epic-done" ]; then
  echo "EPIC_DONE=1" > "$bundle/bundle.env"
  echo "claim-next-bead: done-cycle; nothing to claim"
  exit 0
fi
[ -s "$bundle/selected-bead" ] || die "no selected-bead and no epic-done marker — context hook contract broken"
bead="$(cat "$bundle/selected-bead")"

default_branch() {
  local ref
  if ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"; then
    echo "${ref#origin/}"; return
  fi
  for b in main master; do
    git rev-parse --verify --quiet "refs/remotes/origin/$b^{commit}" >/dev/null 2>&1 && { echo "$b"; return; }
  done
  echo main
}

br sync --import-only >/dev/null 2>&1 || true

json="$(br show "$bead" --json)" || die "br show $bead failed"
[ "$(jq 'length' <<<"$json")" -gt 0 ] || die "bead $bead not found"
status="$(jq -r '.[0].status' <<<"$json")"
case "$status" in
  open|ready) ;;
  *) die "bead $bead status is '$status', expected open or ready" ;;
esac

# The context key next-bead-context actually resolved with — a node identity hash
# or the bead id. NOT the `spex:` label: that is the create op's idempotency key
# and `spex map context` does not accept it.
record="$(cat "$bundle/context-key" 2>/dev/null || true)"
base="origin/$(default_branch)"
branch="$bead"   # bead id verbatim (git allows the dot in refs); the id is already a safe ref token

# Branch first, so the claim commit never lands on the default branch.
git checkout -q -b "$branch" "$base" || die "branch $branch off $base failed"
br update "$bead" --status in_progress >/dev/null || die "br update $bead --status in_progress failed"
git add .beads/issues.jsonl
git commit -qS -m "$bead: start implement (claim in_progress)" || die "signed claim commit failed"

{
  echo "BEAD_ID=$bead"
  echo "BRANCH=$branch"
  echo "BASE=$base"
  [ -n "$record" ] && echo "RECORD_ID=$record"
} > "$bundle/bundle.env"

echo "claim-next-bead: $bead claimed in_progress; on branch $branch (off $base)"
