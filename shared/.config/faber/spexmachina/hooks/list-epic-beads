#!/usr/bin/env bash
# source command (epic workflow) — runs HOST-SIDE at run time. Given an epic id,
# emits the epic's child beads as {"items":[{"id":"<bead>","deps":["<bead>",...]}]}
# on stdout; faber instantiates the fan-out sub-workflow once per item and orders
# instances from each item's deps (independent children parallel, dependents wait).
#
# Membership = the epic's parent-child CHILDREN (how the spex pipeline links
# epics: `br dep add <child> <epic> --type parent-child`) UNION an explicit
# `epic:<id>` label (operator override). Only open work is listed. deps are the
# child's dependency edges that also point at epic members.
#
# HOST REQUIREMENTS (portitor/run step): `br` + `jq` on PATH and a checkout of
# the repo with .beads/issues.jsonl reachable — run faber from a repo checkout,
# or set BEADS_REPO to one. Best-effort across br output shapes.
set -euo pipefail

epic="${1:?usage: list-epic-beads <epic-id>}"
[ -n "${BEADS_REPO:-}" ] && cd "$BEADS_REPO"
command -v br >/dev/null 2>&1 || { echo "list-epic-beads: br not on PATH" >&2; exit 1; }
br sync --import-only >/dev/null 2>&1 || true

all="$(br list --all --limit 0 --json 2>/dev/null || br list --json 2>/dev/null || echo '{"issues":[]}')"

# member bead ids (label override ∪ parent-child children), open only, deduped.
members="$({
  jq -r --arg e "epic:$epic" '(.issues // .) | .[]? | select((.labels // []) | index($e)) | .id' <<<"$all" 2>/dev/null
  while read -r id; do
    { [ -n "$id" ] && [ "$id" != "$epic" ]; } || continue
    br dep list "$id" --json 2>/dev/null \
      | jq -e --arg e "$epic" 'any(.[]?; (.depends_on_id // .depends_on)==$e and (((.type // ""))|test("parent")))' >/dev/null 2>&1 \
      && echo "$id" || :   # a non-member last in the loop must NOT abort the (pipefail) substitution
  done < <(jq -r '(.issues // .) | .[]?.id' <<<"$all")
} | sort -u)"

# Build items with deps restricted to fellow members (so ordering stays inside
# the epic). One jq pass assembles the final {"items":[...]} document.
memberlist="$(printf '%s\n' "$members" | jq -R 'select(length>0)' | jq -s .)"
items="[]"
while read -r id; do
  [ -n "$id" ] || continue
  deps="$({ br dep list "$id" --json 2>/dev/null || true; } \
    | jq -r '.[]? | (.depends_on_id // .depends_on // empty)' 2>/dev/null | sort -u \
    | jq -R 'select(length>0)' | jq -s .)"
  deps="$(jq -n --argjson deps "${deps:-[]}" --argjson members "$memberlist" \
    '$deps - ($deps - $members)')"   # intersect deps with members
  items="$(jq -n --argjson items "$items" --arg id "$id" --argjson deps "$deps" \
    '$items + [{id:$id, deps:$deps}]')"
done <<<"$members"

jq -n --argjson items "$items" '{items:$items}'
