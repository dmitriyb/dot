{
  "format_version": 1,
  "action_roles": {
    "fetch": [
      "implementer",
      "reviewer",
      "merger"
    ],
    "comment": [
      "implementer",
      "reviewer",
      "merger"
    ],
    "review": [
      "reviewer"
    ],
    "reply": [
      "implementer"
    ],
    "describe": [
      "implementer"
    ],
    "resolve": [
      "reviewer"
    ],
    "checks": [
      "implementer",
      "reviewer",
      "merger"
    ],
    "logs": [
      "implementer",
      "reviewer",
      "merger"
    ],
    "rerun": [
      "merger"
    ],
    "merge": [
      "merger"
    ],
    "close": [
      "merger"
    ]
  },
  "merge_gate": {
    "review": "none",
    "checks": [
      {
        "name": "bead-closed",
        "command": [
          "/bin/sh",
          "/etc/portitor/checks/bead-closed.sh"
        ]
      }
    ]
  },
  "checks": {
    "default_budget": "3m",
    "budgets": [
      {
        "name": "build",
        "budget": "2m"
      },
      {
        "name": "vet",
        "budget": "2m"
      },
      {
        "name": "spec-gate",
        "budget": "2m"
      },
      {
        "name": "test",
        "budget": "3m"
      }
    ],
    "max_attempts": 3,
    "allow_rerun_failed": false,
    "log_tail_bytes": 65536
  },
  "content_rules": {
    "version": 1,
    "structural": {
      "rules": [
        {
          "name": "spec-frozen-for-boxes",
          "paths": [
            "spec",
            "spec/**"
          ],
          "operations": [
            "add",
            "modify",
            "delete",
            "rename"
          ],
          "effect": "deny"
        },
        {
          "name": "github-frozen-for-boxes",
          "paths": [
            ".github",
            ".github/**"
          ],
          "operations": [
            "add",
            "modify",
            "delete",
            "rename"
          ],
          "effect": "deny"
        },
        {
          "name": "beads-file-reviewer-only",
          "paths": [
            ".beads/**"
          ],
          "operations": [
            "delete",
            "rename"
          ],
          "roles": {
            "not_in": [
              "reviewer"
            ]
          },
          "effect": "deny"
        }
      ]
    },
    "semantic": {
      "files": [
        {
          "path": ".beads/issues.jsonl",
          "check": {
            "command": [
              "br",
              "--no-db",
              "list",
              "--json",
              "--all",
              "--limit",
              "0"
            ],
            "input_file": ".beads/issues.jsonl",
            "records_path": "issues",
            "id_field": "id"
          },
          "rules": [
            {
              "name": "bead-close-reviewer-only",
              "match": {
                "type": "field",
                "field": "status",
                "to": "closed"
              },
              "roles": {
                "not_in": [
                  "reviewer"
                ]
              },
              "effect": "deny"
            }
          ],
          "default": "allow"
        }
      ]
    }
  },
  "identity_only_roles": [
    "merger"
  ]
}
