# Container host keys are baked per image build, so they change on every rebuild;
# docker-claude writes the current one into known_hosts.docker-claude before each run.

Host docker-work
    HostName localhost
    Port 2222
    User dev
    IdentityFile ~/.ssh/docker_claude_id_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/known_hosts.docker-claude
    StrictHostKeyChecking yes

Host docker-personal
    HostName localhost
    Port 2223
    User dev
    IdentityFile ~/.ssh/docker_claude_id_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/known_hosts.docker-claude
    StrictHostKeyChecking yes
