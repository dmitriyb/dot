#!/usr/bin/env bash
# portitor-add-repo — interactively bootstrap a portitor per-repo gate config.
#
# Reuses the dot substrate: role keys in ~/.dca-keys, the keychain PAT, and the
# PORTITOR_CONFIG_DIR from `docker-claude --portitor init`. Writes ONLY
# non-secret config — repos.d/<name>.json + a shared allowed_signers — into the
# config dir. Private keys stay in ~/.dca-keys; the GitHub PAT stays a keychain
# / docker secret and is never written to disk here.
#
# Correctness notes baked in:
#   - portitor's `roles` map is keyed by the SSH key FINGERPRINT (ssh-keygen -lf,
#     "SHA256:..."), distinct from ~/.ssh/signing-key-hashes (role-suffix digests).
#   - allowed_signers lists only the SIGNING roles (they sign commits); the merger
#     is a commit-less landing identity — in `roles`, not in allowed_signers.
#   - the config's allowed_signers field points at the IN-CONTAINER path
#     (/etc/portitor/allowed_signers), not the host path.
#
# Uses `set -uo pipefail` (not -e): this is an interactive script whose reads
# and conditional `&&` statements legitimately return non-zero. Critical steps
# check their own errors explicitly.
set -uo pipefail

LIBDIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
# shellcheck source=/dev/null
source "$LIBDIR/agent-common.sh"

# Roles that sign commits (allowed_signers + roles map) vs auth-only (roles only).
SIGNING_ROLES=(implementer reviewer)
AUTH_ROLES=(merger)
KEYS_DIR="${DCA_KEYS_DIR:-$HOME/.dca-keys}"
CONTAINER_SIGNERS="/etc/portitor/allowed_signers"
PORTITOR_CONF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/docker-claude/portitor.env"

REPO="" SLUG="" CONFIG_DIR="" DEFAULT_BRANCH="main" DRY_RUN=false PROVISION=false NO_KEYS=false

usage() {
	cat >&2 <<'EOF'
Usage: portitor-add-repo <name> [--slug owner/repo] [--config-dir DIR]
                          [--default-branch main] [--dry-run] [--provision] [--no-keys]

Bootstraps portitor gate config for one repo: ensures role keys exist (YubiKey
resident keys by default), derives fingerprints, regenerates allowed_signers,
and writes repos.d/<name>.json. Re-runnable; adding a repo never rewrites keys.

  --slug            GitHub owner/repo (else prompted).
  --config-dir      portitor config dir (else PORTITOR_CONFIG_DIR / portitor.env
                    / the default keys-dir location).
  --dry-run         print the generated JSON + allowed_signers, write nothing.
  --provision       after writing, run `portitor add-repo` in the running container.
  --no-keys         do not create missing keys; fail if a role key is absent.
EOF
	exit "${1:-1}"
}

# ---- args -----------------------------------------------------------------
[[ $# -gt 0 ]] || usage
while [[ $# -gt 0 ]]; do
	case "$1" in
		--slug) SLUG="$2"; shift 2 ;;
		--config-dir) CONFIG_DIR="$2"; shift 2 ;;
		--default-branch) DEFAULT_BRANCH="$2"; shift 2 ;;
		--dry-run) DRY_RUN=true; shift ;;
		--provision) PROVISION=true; shift ;;
		--no-keys) NO_KEYS=true; shift ;;
		-h|--help) usage 0 ;;
		-*) echo "unknown flag: $1" >&2; usage ;;
		*) [[ -z "$REPO" ]] && { REPO="$1"; shift; } || { echo "unexpected arg: $1" >&2; usage; } ;;
	esac
done
[[ -n "$REPO" ]] || { echo "error: repo <name> is required" >&2; usage; }
[[ "$REPO" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "error: invalid repo name: $REPO" >&2; exit 1; }

# ---- config dir -----------------------------------------------------------
resolve_config_dir() {
	[[ -n "$CONFIG_DIR" ]] && { printf '%s' "$CONFIG_DIR"; return; }
	[[ -n "${PORTITOR_CONFIG_DIR:-}" ]] && { printf '%s' "$PORTITOR_CONFIG_DIR"; return; }
	[[ -f "$PORTITOR_CONF_FILE" ]] && { source "$PORTITOR_CONF_FILE"; [[ -n "${PORTITOR_CONFIG_DIR:-}" ]] && { printf '%s' "$PORTITOR_CONFIG_DIR"; return; }; }
	printf '%s' "$KEYS_DIR/portitor-config"
}
CONFIG_DIR="$(resolve_config_dir)"
REPOS_D="$CONFIG_DIR/repos.d"
SIGNERS_HOST="$CONFIG_DIR/allowed_signers"

# ---- key discovery / creation --------------------------------------------
# role_pub <role> -> path to the role's public key, or empty.
role_pub() {
	local r="$1" p
	for p in "$KEYS_DIR"/*_sk_rk_"$r".pub "$KEYS_DIR/$r.pub"; do
		[[ -f "$p" ]] && { printf '%s' "$p"; return 0; }
	done
	return 0   # no key is not an error — caller creates one
}

# fp <pubfile> -> "SHA256:..." fingerprint.
fp() { ssh-keygen -lf "$1" | awk '{print $2}'; }

# create_role_key <role> <signing|auth>: YubiKey resident by default; file fallback.
create_role_key() {
	local role="$1" kind="$2" ans key
	echo "  role '$role' has no key in $KEYS_DIR." >&2
	$NO_KEYS && { echo "  --no-keys set; aborting." >&2; exit 1; }
	read -rp "  create a key for '$role'? [Y]ubikey-resident / [f]ile / [s]kip: " ans
	case "${ans:-Y}" in
		f|F)
			key="$KEYS_DIR/$role"
			ssh-keygen -t ed25519 -N "" -C "$role@portitor" -f "$key" ;;
		s|S) echo "  skipped '$role'." >&2; return 1 ;;
		*)
			# Resident FIDO2 no-touch key, application=ssh:<role> (dot convention).
			key="$KEYS_DIR/id_ed25519_sk_rk_$role"
			ssh-keygen -t ed25519-sk -O resident -O no-touch-required \
				-O application="ssh:$role" -N "" -C "$role@portitor" -f "$key" ;;
	esac
	# Signing roles are registered in the sign-only hash list (role-suffix digest).
	if [[ "$kind" == signing ]]; then
		local h; h="$(printf '%s' "$role" | sha256sum | awk '{print $1}')"
		grep -qix "$h" "$SIGNING_HASH_FILE" 2>/dev/null || printf '%s\n' "$h" >>"$SIGNING_HASH_FILE"
	fi
}

declare -A ROLE_FP           # role -> SHA256 fingerprint
SIGNING_PUBS=()              # pub files for allowed_signers

echo "resolving role keys in $KEYS_DIR ..." >&2
gather_role() {
	local role="$1" kind="$2" pub
	pub="$(role_pub "$role")"
	if [[ -z "$pub" ]]; then
		create_role_key "$role" "$kind" || return 0
		pub="$(role_pub "$role")"
	fi
	[[ -n "$pub" ]] || return 0
	ROLE_FP["$role"]="$(fp "$pub")"
	echo "  $role: ${ROLE_FP[$role]}" >&2
	[[ "$kind" == signing ]] && SIGNING_PUBS+=("$pub")
}
for r in "${SIGNING_ROLES[@]}"; do gather_role "$r" signing; done
for r in "${AUTH_ROLES[@]}"; do gather_role "$r" auth; done
[[ ${#ROLE_FP[@]} -gt 0 ]] || { echo "error: no role keys resolved" >&2; exit 1; }

# ---- interactive repo details --------------------------------------------
[[ -n "$SLUG" ]] || read -rp "GitHub slug (owner/repo): " SLUG
[[ "$SLUG" =~ ^[^/]+/[^/]+$ ]] || { echo "error: slug must be owner/repo" >&2; exit 1; }
read -rp "default branch [$DEFAULT_BRANCH]: " _b; DEFAULT_BRANCH="${_b:-$DEFAULT_BRANCH}"
read -rp "require branches up-to-date with default? [Y/n]: " _u
UPTODATE=true; [[ "${_u:-Y}" =~ ^[nN] ]] && UPTODATE=false

echo "role_rules template:" >&2
echo "  1) bead-close-reviewer-only (only reviewer/owner may add \"status\":\"closed\" to .beads/issues.jsonl)" >&2
echo "  2) none" >&2
read -rp "choose [1]: " _rule
case "${_rule:-1}" in
	2) RULES_JSON='[]' ;;
	*) RULES_JSON='[{"name":"bead-close-reviewer-only","path_glob":".beads/issues.jsonl","added_regex":"\"status\"\\s*:\\s*\"closed\"","allowed_roles":["reviewer","owner"]}]' ;;
esac

# roles map: {fingerprint: role} for ALL resolved roles.
ROLES_JSON="$(for role in "${!ROLE_FP[@]}"; do printf '%s\t%s\n' "${ROLE_FP[$role]}" "$role"; done \
	| jq -Rn '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}')"

# allowed_signers content: one line per SIGNING role pub.
PRINCIPAL="$(git config user.email 2>/dev/null || echo portitor@local)"
signers_content() { local p; for p in "${SIGNING_PUBS[@]}"; do printf '%s namespaces="git" %s\n' "$PRINCIPAL" "$(awk '{print $1, $2}' "$p")"; done; }

CONFIG_JSON="$(jq -n \
	--arg db "$DEFAULT_BRANCH" --arg as "$CONTAINER_SIGNERS" \
	--arg ur upstream --arg us "$SLUG" \
	--argjson up "$UPTODATE" --argjson roles "$ROLES_JSON" --argjson rules "$RULES_JSON" \
	'{default_branch:$db, allowed_signers:$as, upstream_remote:$ur, upstream_slug:$us,
	  require_up_to_date_with_default:$up, roles:$roles, role_rules:$rules}')"

# ---- dry-run / write ------------------------------------------------------
if $DRY_RUN; then
	echo "=== repos.d/$REPO.json ==="; echo "$CONFIG_JSON"
	echo "=== allowed_signers (append) ==="; signers_content
	exit 0
fi
mkdir -p "$REPOS_D"
target="$REPOS_D/$REPO.json"
if [[ -f "$target" ]]; then
	read -rp "$target exists — overwrite? [y/N]: " _o; [[ "${_o:-N}" =~ ^[yY] ]] || { echo "aborted." >&2; exit 1; }
fi
printf '%s\n' "$CONFIG_JSON" >"$target"
# Merge signing keys into the shared allowed_signers (dedup by key data).
touch "$SIGNERS_HOST"
signers_content | while IFS= read -r line; do grep -qF "$line" "$SIGNERS_HOST" || printf '%s\n' "$line" >>"$SIGNERS_HOST"; done
echo "wrote $target and updated $SIGNERS_HOST" >&2

# ---- PAT presence (keychain, never written here) --------------------------
if keychain_optional portitor "${PORTITOR_KEYCHAIN_ACCOUNT:-default}" "portitor GitHub PAT" >/dev/null; then
	echo "PAT: present in keychain (service=portitor)" >&2
else
	echo "PAT: MISSING — store a Contents+PR token before \`--portitor up\`:" >&2
	echo "  keychain service=portitor account=${PORTITOR_KEYCHAIN_ACCOUNT:-default}" >&2
fi

# ---- validate ------------------------------------------------------------
if command -v portitor >/dev/null 2>&1; then
	PORTITOR_CONFIG="$target" portitor validate-config 2>&1 | sed 's/^/  validate: /' >&2 || echo "  validate: FAILED — fix before deploying" >&2
else
	echo "validate: skipped (portitor binary not on PATH; the container validates at boot)" >&2
fi

# ---- host-key pin for faber's remote.host_key_file ------------------------
PIN="$CONFIG_DIR/portitor_host_key.pub"
if ssh-keyscan -t ed25519 portitor >"$PIN.tmp" 2>/dev/null && [[ -s "$PIN.tmp" ]]; then
	mv "$PIN.tmp" "$PIN"; echo "host-key pin: $PIN (point faber remote.host_key_file here)" >&2
else
	rm -f "$PIN.tmp"; echo "host-key pin: portitor not reachable; capture it once the container is up (ssh-keyscan portitor)" >&2
fi

# ---- optional provision --------------------------------------------------
if $PROVISION; then
	echo "provisioning bare mirror + hooks ..." >&2
	docker exec -u git portitor portitor add-repo --repo "$REPO" \
		--upstream "https://github.com/$SLUG.git" 2>&1 | sed 's/^/  /' >&2 \
		|| echo "  provision failed (is the container up? run \`docker-claude --portitor up\` first)" >&2
fi

# ---- commit reminder ------------------------------------------------------
if git -C "$CONFIG_DIR" rev-parse --git-dir >/dev/null 2>&1; then
	echo "config dir is version-controlled — commit it:" >&2
	echo "  git -C $CONFIG_DIR add repos.d/$REPO.json allowed_signers && git -C $CONFIG_DIR commit" >&2
fi
echo "done: $REPO" >&2
