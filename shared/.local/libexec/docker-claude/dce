#!/usr/bin/env bash
# dce — whole-epic orchestrator (the phase-loop over `dca`). See the plan.
#
#   dce --repo <name> --epic <id> [--effort low|medium|high]
#       [--max-rounds N] [-r|--rebuild] [--no-cache] [--dry-run]
#
# Runs one orchestrated round for a whole epic, each phase a SINGLE-KEY `dca`
# container (isolation intact — never both keys in one agent):
#
#   implement-epic  → review-epic → [fix-epic → review-epic]* → done
#   (implementer)     (reviewer)     (implementer)(reviewer)
#
# Between phases `dce` reads the phase's result.json (PR number, review verdict,
# flagged beads) from a shared host result dir it mounts into each container via
# DCA_RESULT_DIR. The reviewer closes all the epic's beads (batch) only on a
# fully-clean pass; `dce` does NOT merge — it reports the PR as ready (you
# one-click, or the merger role). Beads stay `open` until that final batch close.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
DCA="$HERE/dca"
die() { echo "dce: $*" >&2; exit 1; }
log() { echo "dce: $*" >&2; }
usage() {
	cat >&2 <<EOF
dce — whole-epic orchestrator (phase loop over \`dca\`).

Runs each phase as a SINGLE-KEY \`dca\` container (key isolation intact):
  implement-epic → review-epic → [fix-epic → review-epic]* → done
  (implementer)    (reviewer)     (implementer)(reviewer)
Reads each phase's result.json between phases. The reviewer batch-closes the
epic's beads only on a fully-clean pass; dce reports the PR as ready (no merge).

usage:
  dce --repo <name> --epic <id>
      [--effort low|medium|high] [--max-rounds N] [-r|--rebuild] [--no-cache] [--dry-run]

flags:
  --repo <name>     target repository (required)
  --epic <id>       epic to implement + review (required)
  --effort <level>  low | medium | high (default: medium)
  --max-rounds N    max review/fix cycles before stopping for manual review (default: 3)
  -r, --rebuild     rebuild images — passed to the FIRST (implement) phase only
  --no-cache        rebuild with no Docker cache (first phase only; implies --rebuild)
  --dry-run         preview the phase commands without running them
  -h, --help        show this help

prerequisite: the shared proxy must be up — \`docker-claude --portitor up\`
(and for the go stack, a warmed cache — \`dca-warm --repo <name>\`).
EOF
}

REPO="" EPIC="" EFFORT="medium" MAX_ROUNDS=3 DRY=false
PASS=() # passed to the first (implement) phase only: --rebuild / --no-cache
while [ $# -gt 0 ]; do
	case "$1" in
		--repo | --repository) REPO="$2"; shift 2 ;;
		--epic) EPIC="$2"; shift 2 ;;
		--effort) EFFORT="$2"; shift 2 ;;
		--max-rounds) MAX_ROUNDS="$2"; shift 2 ;;
		-r | --rebuild) PASS+=(--rebuild); shift ;;
		--no-cache) PASS+=(--no-cache); shift ;;
		--dry-run) DRY=true; shift ;;
		-h | --help) usage; exit 0 ;;
		*) echo "dce: unknown flag: $1" >&2; usage; exit 2 ;;
	esac
done
[ -n "$REPO" ] || die "--repo is required"
[ -n "$EPIC" ] || die "--epic is required"
[ -x "$DCA" ] || command -v dca >/dev/null 2>&1 || die "dca not found next to dce or on PATH"
[ -x "$DCA" ] || DCA="dca"

RESULT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/dce.XXXXXX")"
export DCA_RESULT_DIR="$RESULT_DIR" # dca mounts this; every phase writes result.json here

read_result() { # <field> -> value (empty if absent)
	[ -f "$RESULT_DIR/result.json" ] || return 0
	jq -r --arg f "$1" '.[$f] // empty' "$RESULT_DIR/result.json" 2>/dev/null
}

run_phase() { # <skill> [extra dca args...]
	local skill="$1"; shift
	rm -f "$RESULT_DIR/result.json"
	if $DRY; then
		echo "dce (dry-run): dca --repo $REPO --skill $skill --epic $EPIC $* --effort $EFFORT ${PASS[*]:-}"
		return 0
	fi
	"$DCA" --repo "$REPO" --skill "$skill" --epic "$EPIC" "$@" --effort "$EFFORT" ${PASS[@]:+"${PASS[@]}"} \
		|| die "$skill phase failed"
	PASS=() # build the image only on the first phase
}

# --- Phase 1: implement the whole epic on one branch -> auto-PR ---------------
log "phase: implement-epic (epic $EPIC)"
run_phase implement-epic
PR="$(read_result pr)"; $DRY && PR="<pr>"
[ -n "$PR" ] || die "implement-epic produced no PR number (check $RESULT_DIR/result.json)"
log "epic PR #$PR opened"

# --- Phase 2+: review/fix loop (close happens inside review-epic on clean) ----
verdict=""
round=0
while :; do
	round=$((round + 1))
	log "phase: review-epic (round $round, PR #$PR)"
	run_phase review-epic --pr "$PR"
	verdict="$(read_result verdict)"; $DRY && verdict="clean"
	case "$verdict" in
		clean)
			log "epic clean — all beads closed by the reviewer; PR #$PR ready to merge"
			break ;;
		changes)
			if [ "$round" -ge "$MAX_ROUNDS" ]; then
				log "still flagged after $MAX_ROUNDS rounds — stopping for manual review (PR #$PR)"
				break
			fi
			log "phase: fix-epic (round $round, PR #$PR)"
			run_phase fix-epic --pr "$PR" ;;
		*)
			log "review-epic returned no verdict — stopping for manual review (PR #$PR)"
			break ;;
	esac
	$DRY && break
done

echo
echo "dce: epic $EPIC — PR #$PR, verdict=${verdict:-unknown}, rounds=$round"
echo "dce: result dir: $RESULT_DIR"
if [ "${verdict:-}" = clean ]; then
	echo "dce: PR #$PR is READY TO MERGE (you one-click, or the merger role). Beads closed."
else
	echo "dce: PR #$PR needs manual attention (not clean within $MAX_ROUNDS rounds)."
fi
