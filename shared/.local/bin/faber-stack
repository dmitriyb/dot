#!/usr/bin/env bash
# faber-stack — the environment one faber project's boxes run against: its
# internal network, its allow-listing egress proxy and its portitor gate.
#
#   faber-stack up      <project>             converge: images, config, egress, gate
#   faber-stack down    <project> [--volumes] remove the containers (and, with
#                                             --volumes, the gate's volumes and pin)
#   faber-stack status  <project>             containers, images, volumes, pin
#   faber-stack prune   <project>             remove this instance's unused images
#
# <project> is a name under ~/.config/faber or a path. Everything about the
# instance is data in <project>/stack.json (host-local, gitignored; see
# stack.example.json) and <project>/portitor/policy.json; the role keys come from
# faber's registry via `role-keys --json`. The gate itself is `portitor deploy`.
#
# What faber-stack does NOT do: create keys, register identities, store secrets,
# or run faber workflows (`faber run`, or faber's live view).
if (( ${BASH_VERSINFO[0]:-0} < 4 )); then
	for _b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
		[[ -x "$_b" ]] && exec "$_b" "${BASH_SOURCE[0]}" "$@"
	done
	echo "faber-stack: requires bash >= 4 (macOS ships 3.2); install one: brew install bash" >&2
	exit 1
fi
set -euo pipefail

die() { echo "faber-stack: $1" >&2; exit "${2:-1}"; }
say() { echo "faber-stack: $*" >&2; }

usage() {
	sed -n '4,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
	exit "${1:-0}"
}

[[ $# -ge 1 ]] || usage 2
case "$1" in -h | --help) usage 0 ;; esac
VERB="$1"; shift
case "$VERB" in up | down | status | prune) ;; *) die "unknown verb: $VERB (want up|down|status|prune)" 2 ;; esac
[[ $# -ge 1 ]] || usage 2
case "$1" in -h | --help) usage 0 ;; -*) die "the project comes first: faber-stack $VERB <project> ..." 2 ;; esac
PROJECT_ARG="$1"; shift
WITH_VOLUMES=false
while [[ $# -gt 0 ]]; do
	case "$1" in
		--volumes) [[ "$VERB" == down ]] || die "--volumes is a down flag" 2; WITH_VOLUMES=true; shift ;;
		*) die "unknown argument: $1" 2 ;;
	esac
done

for t in docker jq; do command -v "$t" >/dev/null 2>&1 || die "$t not found on PATH"; done

# ---- the project and its manifest ------------------------------------------
# A bare name resolves under ~/.config/faber only, never against the CWD.
if [[ "$PROJECT_ARG" == */* ]]; then PROJECT="$PROJECT_ARG"
else PROJECT="${XDG_CONFIG_HOME:-$HOME/.config}/faber/$PROJECT_ARG"; fi
[[ -d "$PROJECT" ]] || die "project dir not found: $PROJECT" 2
PROJECT="$(cd -- "$PROJECT" && pwd)"
MANIFEST="$PROJECT/stack.json"
[[ -f "$MANIFEST" ]] || die "no $MANIFEST — copy stack.example.json and fill it in" 2
jq -e 'type == "object"' "$MANIFEST" >/dev/null 2>&1 || die "$MANIFEST is not a JSON object" 2

# An unknown key is refused, not ignored: a renamed field (commit_email →
# commit_emails) would otherwise silently drop the policy it carried.
problems="$(jq -r '
	def strs: type == "array" and all(.[]; type == "string");
	(keys - ["instance", "slug", "pat_service", "pat_account", "repo", "policy", "config_dir",
	         "allow", "commit_emails", "map"] | .[] | "unknown key \(.)"),
	(if has("allow") and (.allow | strs | not) then "allow must be an array of strings" else empty end),
	(if (.commit_emails | strs and length > 0 and all(.[]; test("^[^@\\s<>]+@[^@\\s<>]+\\.[^@\\s<>]+$"))) | not
	 then "commit_emails must be a non-empty array of email addresses" else empty end),
	(if has("map") and ((.map | type) != "object" or (.map | [.[]] | strs | not)) then "map must be an object of strings" else empty end)
	' "$MANIFEST")"
[[ -z "$problems" ]] || die "$MANIFEST: ${problems//$'\n'/; } (see stack.example.json)" 2

field() { jq -r --arg k "$1" '.[$k] // empty | if type == "string" then . else error("not a string") end' "$MANIFEST" 2>/dev/null \
	|| die "$MANIFEST: $1 must be a string" 2; }
req() { local v; v="$(field "$1")"; [[ -n "$v" ]] || die "$MANIFEST: $1 is required" 2; printf '%s' "$v"; }
in_project() { if [[ "$1" == /* ]]; then printf '%s' "$1"; else printf '%s' "$PROJECT/$1"; fi; }

INSTANCE="$(req instance)"
# The gate is named portitor-<instance>, and portitor deploy refuses a name that
# ends in a separator or doubles one.
[[ "$INSTANCE" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] \
	|| die "instance '$INSTANCE' must be lowercase words joined by single hyphens" 2
SLUG="$(req slug)"
[[ "$SLUG" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "slug '$SLUG' is not owner/name" 2
PAT_SERVICE="$(req pat_service)"
PAT_ACCOUNT="$(field pat_account)"; PAT_ACCOUNT="${PAT_ACCOUNT:-default}"
REPO="$(field repo)"; REPO="${REPO:-${SLUG#*/}}"
{ [[ "$REPO" =~ ^[A-Za-z0-9._-]+$ ]] && [[ "$REPO" != . && "$REPO" != .. ]]; } || die "repo '$REPO' is not a portitor repo name" 2
POLICY="$(field policy)"; POLICY="$(in_project "${POLICY:-portitor/policy.json}")"
CONFIG_DIR="$(field config_dir)"
if [[ -n "$CONFIG_DIR" ]]; then CONFIG_DIR="$(in_project "$CONFIG_DIR")"
else CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/portitor/$INSTANCE"; fi
mapfile -t ALLOW < <(jq -r '.allow // [] | .[]' "$MANIFEST")
for h in ${ALLOW[@]+"${ALLOW[@]}"}; do
	[[ "$h" =~ ^[A-Za-z0-9._-]+$ ]] || die "allow host '$h' is not a plain host name" 2
done

# ---- every object name derives from the instance ---------------------------
NET="${INSTANCE}-net"
EGRESS_CT="${INSTANCE}-egress"
GATE="portitor-${INSTANCE}"
REPOS_VOL="${INSTANCE}-repos"
HOSTKEY_VOL="${INSTANCE}-hostkey"
PIN="$PROJECT/keys/portitor_host_key.pub"
GATE_CFG="$CONFIG_DIR/gate"
EGRESS_FILTER="$CONFIG_DIR/egress-filter"
DEPLOY_CFG="$CONFIG_DIR/deploy.json"
CONTAINER_SIGNERS="/etc/portitor/allowed_signers"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
EGRESS_DIR="$DATA_HOME/egress"
EGRESS_STACK="$EGRESS_DIR/egress-stack.yml"
[[ -f "$EGRESS_STACK" && -f "$EGRESS_DIR/egress-image.nix" ]] \
	|| die "egress assets not found under $EGRESS_DIR — stow the dot repo" 1
EGRESS_PORT="$(awk '$1 == "Port" { print $2; exit }' "$EGRESS_DIR/tinyproxy.conf")"
[[ "$EGRESS_PORT" =~ ^[0-9]+$ ]] || die "no Port in $EGRESS_DIR/tinyproxy.conf" 1

docker info >/dev/null 2>&1 || die "docker is not running — start docker"

export INSTANCE EGRESS_IMAGE="${EGRESS_IMAGE:-unset}"
compose() { docker compose -p "$INSTANCE" -f "$EGRESS_STACK" "$@"; }
gate_ids() { docker ps -aq --filter "label=portitor.deploy=$GATE"; }
# Containers on the instance network other than the stack's own: running faber
# boxes, or a portitor deploy in progress.
net_others() {
	docker network inspect "$NET" >/dev/null 2>&1 || return 0
	docker network inspect -f '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}' "$NET" \
		| grep -vx -e "$GATE" -e "$EGRESS_CT" -e '' || true
}

owned_images() {
	docker images --format '{{.Repository}}:{{.Tag}}' "egress-proxy-$INSTANCE"
	docker images --format '{{.Repository}}:{{.Tag}}' "portitor-gate/$GATE"
}
image_in_use() { [[ -n "$(docker ps -aq --filter "ancestor=$1")" ]]; }

# ---- status ------------------------------------------------------------------
if [[ "$VERB" == status ]]; then
	echo "instance $INSTANCE (project $PROJECT)"
	echo "-- egress"; compose ps -a
	echo "-- gate"; docker ps -a --filter "label=portitor.deploy=$GATE" --format '{{.Names}}  {{.Status}}  {{.Image}}'
	echo "-- images"
	while IFS= read -r img; do
		[[ -n "$img" ]] || continue
		if image_in_use "$img"; then echo "$img  in use"; else echo "$img  unused (prune removes it)"; fi
	done < <(owned_images)
	echo "-- volumes"
	for v in "$REPOS_VOL" "$HOSTKEY_VOL"; do
		if docker volume inspect "$v" >/dev/null 2>&1; then echo "$v  present"; else echo "$v  absent"; fi
	done
	echo "-- pin"; if [[ -f "$PIN" ]]; then echo "$PIN  present"; else echo "$PIN  absent"; fi
	exit 0
fi

# ---- prune -------------------------------------------------------------------
if [[ "$VERB" == prune ]]; then
	while IFS= read -r img; do
		[[ -n "$img" ]] || continue
		if image_in_use "$img"; then say "keeping $img (in use)"; continue; fi
		docker rmi "$img" >/dev/null || die "docker rmi $img failed"
		docker image inspect "$img" >/dev/null 2>&1 && die "$img is still present after docker rmi"
		say "removed $img"
	done < <(owned_images)
	exit 0
fi

# ---- down --------------------------------------------------------------------
# The mirror may be dropped only when GitHub holds every commit of every mirror
# branch. Tips alone cannot tell: the mirror's default branch lags GitHub after
# each merge, so the check fetches GitHub's branches and PR heads and asks
# whether anything in the mirror is unreachable from them.
CHECK_NS=refs/faber-stack-check
gx() { docker exec -u git "$GATE" git -C "/srv/git/$REPO.git" "$@"; }
clear_check_refs() {
	gx for-each-ref --format='delete %(refname)' "$CHECK_NS" | docker exec -i -u git "$GATE" git -C "/srv/git/$REPO.git" update-ref --stdin
}
# Runs in a $(…) subshell: the trap clears the temporary refs however it exits,
# and they are cleared before the fetch too, so refs left by an interrupted run
# can never vouch for a branch GitHub no longer has.
unforwarded_branches() {
	local remote heads sha name n ns="$CHECK_NS"
	clear_check_refs || die "cannot clear the temporary $ns refs in $GATE's mirror"
	trap 'clear_check_refs >/dev/null 2>&1 || true' EXIT
	remote="$(jq -r '.upstream_remote // "upstream"' "$GATE_CFG/repos.d/$REPO.json" 2>/dev/null || echo upstream)"
	heads="$(gx for-each-ref --format='%(objectname) %(refname:short)' refs/heads)" \
		|| die "cannot read the mirror's branches from $GATE"
	gx fetch --quiet --no-write-fetch-head "$remote" "+refs/heads/*:$ns/heads/*" "+refs/pull/*/head:$ns/pull/*" \
		|| die "cannot fetch $SLUG's branches and pull requests into $GATE"
	while read -r sha name; do
		[[ -n "$sha" ]] || continue
		n="$(gx rev-list --count "$sha" --not --glob="$ns/*")" || die "cannot compare $name with $SLUG"
		[[ "$n" == 0 ]] || echo "$name ($n commit(s) not on GitHub)"
	done <<<"$heads"
}

if [[ "$VERB" == down ]]; then
	# A box on the network is a running faber step; removing its gate and egress
	# would fail it mid-push.
	others="$(net_others)"
	[[ -z "$others" ]] || die "containers are still on $NET (running faber boxes, or a deploy in progress); stop them first:
$others"
	if $WITH_VOLUMES; then
		[[ -n "$(docker ps -q --filter "label=portitor.deploy=$GATE")" ]] \
			|| die "--volumes checks the mirror against GitHub through the running gate; start it with 'faber-stack up', or remove $REPOS_VOL by hand once you know nothing in it is unforwarded"
		missing="$(unforwarded_branches)"
		[[ -z "$missing" ]] || die "these mirror branches hold commits GitHub does not have; re-forward them (portitor reconcile --repo $REPO, inside $GATE) or delete them (portitor-branch delete) before removing the mirror:
$missing"
	fi
	# The gate goes first: the network cannot be removed while it is attached.
	ids="$(gate_ids)"; [[ -z "$ids" ]] || docker rm -f $ids >/dev/null || die "docker rm of the gate failed"
	compose down --remove-orphans || die "docker compose down of the egress failed"
	[[ -z "$(gate_ids)" ]] || die "gate containers remain: $(gate_ids | tr '\n' ' ')"
	if docker inspect "$EGRESS_CT" >/dev/null 2>&1; then die "$EGRESS_CT remains after compose down"; fi
	if docker network inspect "$NET" >/dev/null 2>&1; then die "$NET remains after compose down"; fi
	say "removed $GATE, $EGRESS_CT and $NET"
	if $WITH_VOLUMES; then
		for v in "$REPOS_VOL" "$HOSTKEY_VOL"; do
			docker volume inspect "$v" >/dev/null 2>&1 || continue
			docker volume rm "$v" >/dev/null || true
			if docker volume inspect "$v" >/dev/null 2>&1; then die "volume $v could not be removed; the pin $PIN is kept"; fi
			say "removed volume $v"
		done
		rm -f "$PIN"
		[[ ! -e "$PIN" ]] || die "could not remove the pin $PIN"
		say "removed the pin $PIN"
	else
		say "kept volumes $REPOS_VOL, $HOSTKEY_VOL and the pin $PIN; remove them with: faber-stack down $PROJECT_ARG --volumes"
	fi
	exit 0
fi

# ============================================================================
# up — every input is checked before anything is built, written or started.
# ============================================================================
for t in faber nix-build role-keys secret-get portitor; do command -v "$t" >/dev/null 2>&1 || die "$t not found on PATH"; done
PORTITOR_BIN="$(command -v portitor)"

# portitor deploy replaces the gate on every run, and a changed allow-list
# recreates the egress: either would cut a running box off mid-push.
others="$(net_others)"
[[ -z "$others" ]] || die "containers are on $NET (running faber boxes, or a deploy in progress); up replaces the gate, so wait for them:
$others"

# ---- 1a. the project's faber config must name exactly this instance ----------
# orchestrator.yaml's network/remote blocks and templates.yaml's PORTITOR_HOST
# restate names derived here; a mismatch would only show up as a dead run.
ORCH="$PROJECT/orchestrator.yaml"
[[ -f "$ORCH" ]] || die "no orchestrator.yaml in $PROJECT" 2

unquote() { local v="$1"; [[ "$v" =~ ^\"(.*)\"$ || "$v" =~ ^\'(.*)\'$ ]] && v="${BASH_REMATCH[1]}"; printf '%s' "$v"; }
block_value() { # <block> <key>
	unquote "$(awk -v blk="$1" -v key="$2" '
		/^[^ #]/ { inblk = ($0 ~ "^" blk ":") ; next }
		inblk && $0 ~ "^[ ]+" key ":" {
			v = $0; sub("^[ ]+" key ":[ ]*", "", v); sub("[ ]+#.*$", "", v); sub("[ ]+$", "", v)
			print v; exit
		}' "$ORCH")"
}
expect() { # <what> <got> <want>
	[[ "$2" == "$3" ]] || die "$ORCH: $1 is '$2', want '$3' for instance $INSTANCE" 2
}
expect network.name "$(block_value network name)" "$NET"
expect network.proxy "$(block_value network proxy)" "http://$EGRESS_CT:$EGRESS_PORT"
expect remote.url "$(block_value remote url)" "ssh://git@$GATE/srv/git"
no_proxy="$(block_value network no_proxy)"
[[ "$no_proxy" =~ ^\[.*\]$ ]] || die "$ORCH: network.no_proxy must be an inline [list]" 2
for need in "$GATE" localhost 127.0.0.1; do
	tr -d "[] \"'" <<<"$no_proxy" | tr ',' '\n' | grep -qx "$need" || die "$ORCH: network.no_proxy lacks $need" 2
done
hkf="$(in_project "$(block_value remote host_key_file)")"
[[ "$(cd -- "$(dirname -- "$hkf")" 2>/dev/null && pwd)/$(basename -- "$hkf")" == "$PIN" ]] \
	|| die "$ORCH: remote.host_key_file must be ./keys/portitor_host_key.pub, the pin portitor deploy writes" 2
if [[ -f "$PROJECT/templates.yaml" ]]; then
	while IFS= read -r host; do
		expect "templates.yaml PORTITOR_HOST" "$(unquote "$host")" "$GATE"
	done < <(sed -e 's/^[[:space:]]*#.*//' -e 's/[[:space:]]#.*//' "$PROJECT/templates.yaml" \
		| grep -o 'PORTITOR_HOST:[ ]*[^,} ]*' | sed 's/^PORTITOR_HOST:[ ]*//')
fi
say "faber validate ($ORCH)"
(cd "$PROJECT" && faber validate --config "$ORCH") || die "faber validate failed"

# ---- 1b. the gate policy -----------------------------------------------------
# The schema is portitor's (validate-config, step 2); here only what faber-stack
# itself relies on: the roles it registers, and the fields it computes.
[[ -f "$POLICY" ]] || die "gate policy not found: $POLICY" 2
jq -e 'type == "object"' "$POLICY" >/dev/null 2>&1 || die "$POLICY is not a JSON object" 2
computed="$(jq -r '[keys[] | select(IN("upstream_slug", "allowed_signers", "roles", "allowed_committer_emails"))] | join(", ")' "$POLICY")"
[[ -z "$computed" ]] || die "$POLICY sets $computed; faber-stack computes those from stack.json and the role registry" 2
CHECKS_SRC="$PROJECT/portitor/checks"
while IFS= read -r ref; do
	[[ -n "$ref" ]] || continue
	[[ -f "$CHECKS_SRC/${ref##*/}" ]] || die "$POLICY references $ref but $CHECKS_SRC/${ref##*/} does not exist" 2
done < <(jq -r '.merge_gate.checks[]?.command[]? | select(startswith("/etc/portitor/checks/"))' "$POLICY")
# Identity-only roles sign nothing, so they never enter allowed_signers.
mapfile -t ROLES < <(jq -r '[(.action_roles // {})[][]] + (.identity_only_roles // []) | unique[]' "$POLICY")
[[ ${#ROLES[@]} -gt 0 ]] || die "$POLICY grants no role" 2

# ---- 1c. the role keys ---------------------------------------------------------
ROLES_JSON="$(role-keys --json)" || die "role-keys --json failed"
jq -e '.assignments | type == "array"' <<<"$ROLES_JSON" >/dev/null 2>&1 || die "role-keys --json did not emit {\"assignments\":[...]}"
declare -A ROLE_FP ROLE_PUB
for r in "${ROLES[@]}"; do
	a="$(jq -r --arg r "$r" '.map[$r] // $r' "$MANIFEST")"
	fp="$(jq -r --arg a "$a" '.assignments | map(select(.role == $a)) | .[0].fingerprint // ""' <<<"$ROLES_JSON")"
	pub="$(jq -r --arg a "$a" '.assignments | map(select(.role == $a)) | .[0].pub // ""' <<<"$ROLES_JSON")"
	[[ "$fp" =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]] || die "no usable fingerprint for role '$r' in faber's registry (looked for '$a'; map it in stack.json .map)"
	[[ -f "$pub" ]] || die "role '$r' has no public key file in ~/.ssh ('$pub')"
	ROLE_FP[$r]="$fp"; ROLE_PUB[$r]="$pub"
done

# ---- 1d. the gate image's extra tools -------------------------------------------
# Beside the policy, because the policy's commands are what need them.
GATE_IMAGE="$(dirname -- "$POLICY")/gate-image.json"
GATE_OVERLAY="" GATE_PACKAGES="[]"
if [[ -f "$GATE_IMAGE" ]]; then
	problems="$(jq -r '
		def strs: type == "array" and all(.[]; type == "string");
		if type != "object" then "not a JSON object"
		else (keys - ["overlay", "packages"] | .[] | "unknown key \(.)"),
		     (if has("overlay") and (.overlay | type) != "string" then "overlay must be a string" else empty end),
		     (if has("packages") and (.packages | strs | not) then "packages must be an array of strings" else empty end)
		end' "$GATE_IMAGE" 2>&1)" || problems="not valid JSON"
	[[ -z "$problems" ]] || die "$GATE_IMAGE: ${problems//$'\n'/; }" 2
	GATE_OVERLAY="$(jq -r '.overlay // empty' "$GATE_IMAGE")"
	if [[ -n "$GATE_OVERLAY" ]]; then
		[[ "$GATE_OVERLAY" == /* ]] || GATE_OVERLAY="$(dirname -- "$GATE_IMAGE")/$GATE_OVERLAY"
		[[ -f "$GATE_OVERLAY" ]] || die "$GATE_IMAGE: overlay $GATE_OVERLAY does not exist" 2
		GATE_OVERLAY="$(cd -- "$(dirname -- "$GATE_OVERLAY")" && pwd)/$(basename -- "$GATE_OVERLAY")"
	fi
	GATE_PACKAGES="$(jq -c '.packages // []' "$GATE_IMAGE")"
fi

# ---- 2. the gate's config, staged and validated before it replaces the old one --
# Built fresh on every up from policy.json + stack.json + the registry, so a key
# removed from either never lingers.
mkdir -p "$CONFIG_DIR"
STAGE="$(mktemp -d "$CONFIG_DIR/.gate.new.XXXXXX")"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE/repos.d"
CFG="$STAGE/repos.d/$REPO.json"
jq --arg us "$SLUG" --arg as "$STAGE/allowed_signers" \
	--argjson emails "$(jq -c '.commit_emails // []' "$MANIFEST")" \
	'. + {upstream_slug: $us, allowed_signers: $as, roles: {}}
	 + (if ($emails | length) > 0 then {allowed_committer_emails: $emails} else {} end)' "$POLICY" >"$CFG" \
	|| die "failed to write $CFG"
[[ -d "$CHECKS_SRC" ]] && cp -R "$CHECKS_SRC" "$STAGE/checks"
: >"$STAGE/allowed_signers"
for r in "${ROLES[@]}"; do
	args=(add-role --repo "$REPO" --role "$r" --fingerprint "${ROLE_FP[$r]}")
	jq -e --arg r "$r" '(.identity_only_roles // []) | index($r)' "$POLICY" >/dev/null || args+=(--pub "${ROLE_PUB[$r]}")
	PORTITOR_REPOS_DIR="$STAGE/repos.d" "$PORTITOR_BIN" "${args[@]}" >&2 || die "portitor add-role failed for role '$r'"
done
"$PORTITOR_BIN" validate-config --config "$CFG" >&2 || die "the gate config built from $POLICY is invalid"
t="$(mktemp "$STAGE/repos.d/.$REPO.json.XXXXXX")"
jq --arg as "$CONTAINER_SIGNERS" '.allowed_signers = $as' "$CFG" >"$t" && mv "$t" "$CFG" || die "failed to update $CFG"
chmod 0755 "$STAGE"
OLD="$CONFIG_DIR/.gate.old.$$"
if [[ -e "$GATE_CFG" ]]; then mv "$GATE_CFG" "$OLD"; fi
mv "$STAGE" "$GATE_CFG"
rm -rf "$OLD"

# ---- 3. the box images (faber skips what is already built) -------------------
say "faber build ($ORCH)"
(cd "$PROJECT" && faber build --config "$ORCH") || die "faber build failed"

# ---- 4. egress: network + allow-listing proxy ----------------------------------
[[ ${#ALLOW[@]} -gt 0 ]] || say "warning: stack.json lists no 'allow' hosts — boxes reach nothing outside, not even the model API"
{
	echo "# egress allow-list for $INSTANCE, from stack.json .allow (extended regex, FilterDefaultDeny)"
	for h in ${ALLOW[@]+"${ALLOW[@]}"}; do
		printf '^%s$\n' "${h//./\\.}"
	done
} >"$EGRESS_FILTER"

case "$(docker info --format '{{.Architecture}}')" in
	x86_64 | amd64) NIX_SYSTEM=x86_64-linux ;;
	aarch64 | arm64) NIX_SYSTEM=aarch64-linux ;;
	*) die "unsupported Docker daemon architecture" ;;
esac
# nix resolves the expression's relative imports against its real path, not the
# stow symlink.
egress_out="$(nix-build "$(readlink -f "$EGRESS_DIR/egress-image.nix")" --argstr system "$NIX_SYSTEM" --no-out-link)" \
	|| die "nix-build of the egress image failed"
BASE_TAG="egress-proxy:$(basename "$egress_out" | cut -d- -f1)"
if ! docker image inspect "$BASE_TAG" >/dev/null 2>&1; then
	loaded="$(docker load -i "$egress_out" | sed -n 's/^Loaded image: //p' | head -1)"
	[[ -n "$loaded" ]] || die "docker load of $egress_out printed no image"
	docker tag "$loaded" "$BASE_TAG"
fi
filter_hash="$( { echo "$BASE_TAG"; cat "$EGRESS_FILTER"; } | sha256sum | cut -c1-16)"
EGRESS_IMAGE="egress-proxy-$INSTANCE:$filter_hash"
if ! docker image inspect "$EGRESS_IMAGE" >/dev/null 2>&1; then
	ctx="$(mktemp -d)"; cp "$EGRESS_FILTER" "$ctx/filter"; chmod 0644 "$ctx/filter"
	printf 'FROM %s\nCOPY --chown=0:0 filter /etc/tinyproxy/filter\n' "$BASE_TAG" | docker build -q -t "$EGRESS_IMAGE" -f - "$ctx" >/dev/null \
		|| { rm -rf "$ctx"; die "docker build of $EGRESS_IMAGE failed"; }
	rm -rf "$ctx"
fi
docker run --rm --network none --entrypoint cat "$EGRESS_IMAGE" /etc/tinyproxy/filter | cmp -s - "$EGRESS_FILTER" \
	|| die "$EGRESS_IMAGE does not carry $EGRESS_FILTER"
export EGRESS_IMAGE
compose up -d --remove-orphans || die "docker compose up of the egress failed"
[[ "$(docker inspect -f '{{.State.Running}}' "$EGRESS_CT" 2>/dev/null)" == true ]] || die "$EGRESS_CT is not running after compose up"

# ---- 5. the gate ---------------------------------------------------------------
pubs="$(for r in "${ROLES[@]}"; do printf '%s\n' "${ROLE_PUB[$r]}"; done | jq -R . | jq -sc .)"
jq -n --arg name "$GATE" --arg vol "$REPOS_VOL" --arg hk "$HOSTKEY_VOL" --arg net "$NET" \
	--arg cfg "$GATE_CFG" --argjson keys "$pubs" --arg svc "$PAT_SERVICE" --arg acct "$PAT_ACCOUNT" \
	--arg pin "$PIN" --arg overlay "$GATE_OVERLAY" --argjson packages "$GATE_PACKAGES" \
	'{name: $name, volume: $vol, host_key_volume: $hk,
	  networks: [{name: $net, aliases: [$name]}],
	  config_dir: $cfg, authorized_keys: $keys,
	  token_command: ["secret-get", $svc, $acct],
	  host_key_file: $pin,
	  image: ({packages: $packages} + (if $overlay == "" then {} else {overlay: $overlay} end))}' >"$DEPLOY_CFG"
mkdir -p "$PROJECT/keys"
"$PORTITOR_BIN" deploy --config "$DEPLOY_CFG" >&2 || die "portitor deploy failed"

cat >&2 <<EOF

faber-stack: instance '$INSTANCE' is up.
  network   $NET (egress $EGRESS_CT:$EGRESS_PORT, image $EGRESS_IMAGE)
  gate      $GATE (config $GATE_CFG, mirror volume $REPOS_VOL, host key pinned at $PIN)
  egress    $(grep -v '^#' "$EGRESS_FILTER" | tr '\n' ' ')
Run a workflow from $PROJECT with: faber run <workflow> --param ...
EOF
