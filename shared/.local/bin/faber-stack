#!/usr/bin/env bash
# faber-stack — stand up (or tear down) ONE portitor gate instance per faber repo.
#
# The faber box model is one gate PER repo: its own internal network, egress
# proxy, gate container, mirror volume, and scoped PAT, so a compromised box for
# repo A cannot reach repo B's mirror or PAT. faber-stack makes that a
# one-command, idempotent, parameterized operation.
#
# ONE knob — `--instance <name>` — derives every object name, so the box side and
# the gate side cannot drift:
#
#   network  ${name}-net (internal)   egress  ${name}-egress
#   gate     portitor-${name}         volume  ${name}-repos     project ${name}
#
# `--instance spex` therefore produces exactly what spexmachina/orchestrator.yaml
# already references (spex-net / spex-egress / portitor-spex / spex-repos).
#
#   role-keys --repo <repo> --json \
#     | faber-stack up --instance <name> --slug <owner/repo> --pat <svc>[/acct] --project <dir> [--allow <host> ...]
#   faber-stack status|down|restart --instance <name>
#
# What faber-stack does NOT do: create SSH keys (role-keys / ssh-keygen), register
# faber identities (faber add-key), run faber, or store PATs (the operator stores
# them once in the keychain). It consumes those artifacts.
#
# Non-interactive, so `set -e` is appropriate — with careful guards around greps
# and `docker image inspect` that legitimately return non-zero.
#
# This script uses associative arrays + namerefs (bash >= 4). macOS ships bash
# 3.2, so re-exec under a newer bash if one is installed, else fail clearly —
# BEFORE `set -u` trips over the first associative-array assignment.
if (( ${BASH_VERSINFO[0]:-0} < 4 )); then
	for _b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
		[[ -x "$_b" ]] && exec "$_b" "${BASH_SOURCE[0]}" "$@"
	done
	echo "faber-stack: requires bash >= 4 (macOS ships 3.2); install one: brew install bash" >&2
	exit 1
fi
set -euo pipefail

# Assets are installed under $XDG_DATA_HOME (stowed from the dot repo to
# ~/.local/share): the gate compose and the egress build context. Resolve them
# via standard XDG — no repo path, no self-location, no env to set.
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
COMPOSE_FILE="$DATA_HOME/portitor/portitor-stack.yml"
GATE_CTX="$DATA_HOME/portitor"      # self-contained gate image build context (Dockerfile + gate-entrypoint.sh)
EGRESS_CTX="$DATA_HOME/egress"
if [[ ! -f "$COMPOSE_FILE" || ! -f "$GATE_CTX/Dockerfile" || ! -f "$EGRESS_CTX/Dockerfile" ]]; then
	echo "faber-stack: faber assets not found under $DATA_HOME (need portitor/{portitor-stack.yml,Dockerfile} + egress/Dockerfile) — install them (stow the dot repo so ~/.local/share/{portitor,egress} exist)" >&2
	exit 1
fi

# Validation patterns (all match the tools faber-stack feeds).
INSTANCE_RE='^[a-z0-9][a-z0-9-]{0,30}$'          # docker/DNS/path-safe, <=31 chars
SLUG_RE='^[^/ ]+/[^/ ]+$'                         # owner/repo
FP_RE='^SHA256:[A-Za-z0-9+/]{43}$'                # portitor addrole.go's own regex (no '=', exactly 43)
HOST_RE='^[A-Za-z0-9._-]+$'                       # egress allow-list host (no metachars)
EMAIL_RE='^[^[:space:]@]+@[^[:space:]@]+$'        # committer email shape (gate compares byte-exact)

CONTAINER_SIGNERS="/etc/portitor/allowed_signers" # the in-container allowed_signers path the gate reads

# portitor per-repo policy (repos.d/<repo>.json). The STATIC gate policy —
# format_version, action_roles, merge_gate, content_rules, identity_only_roles — is
# DECLARATIVE and lives in the project's own $PROJECT/portitor/policy.json (loaded via
# --policy below), re-asserted onto the config every run so an older config converges.
# faber-stack only COMPUTES the runtime-derived fields (roles map, allowed_signers path,
# upstream_slug/remote, default_branch, allowed_committer_emails). The policy itself and
# its rationale (default-deny action_roles; the reviewer-only bead-close content rule
# whose semantic check shells `br` in the gate image; the merge_gate bead-closed
# predicate) now live next to that JSON, not here.

# Signing roles get --pub (enter allowed_signers); merger is identity-only
# (must match policy.json identity_only_roles).
PORTITOR_ROLES=(implementer reviewer merger)
declare -A IS_SIGNER=([implementer]=1 [reviewer]=1 [merger]=0)

die() { echo "faber-stack: $1" >&2; exit "${2:-1}"; }

usage() {
	cat >&2 <<'EOF'
Usage:
  role-keys --repo <repo> --json | \
    faber-stack up --instance <name> --slug <owner/repo> --pat <svc>[/acct] --project <dir> [flags]
  faber-stack restart --instance <name> --slug <owner/repo> --pat <svc>[/acct] --project <dir> [flags]
  faber-stack status  --instance <name>
  faber-stack down    --instance <name>

Verbs: up | down | status | restart   (verb is the first positional arg)

Flags:
  --instance <name>     identity knob; derives every object name. ^[a-z0-9][a-z0-9-]{0,30}$   (all verbs)
  --slug <owner/repo>   GitHub slug for the mirror upstream + repo config           (up/restart, required)
  --pat <svc>[/acct]    keychain coordinates for the scoped GitHub PAT; no default  (up/restart, required)
  --project <dir>       faber orchestrator dir; host-key pin lands in <dir>/keys/   (up/restart, required)
  --allow <host>        extra egress host beyond api.anthropic.com, which is ALWAYS
                        allowed (the agent's API lifeline); repeatable, converged per up
  --commit-email <e>    allowed committer email for the gate's email allowlist (repeatable;
                        CONVERGED like --allow: omitted on a later run = field dropped, check off;
                        requires a portitor release that knows allowed_committer_emails)
  --build               also run `faber validate` + `faber build` against
                        <project>/orchestrator.yaml before bringing the stack up —
                        one command yields images + gate, leaving only `faber run`.
                        Under --build the gate image is audited for staleness vs the
                        installed portitor and rebuilt (prompted) if it lags.
  --force-portitor-rebuild  under --build, auto-confirm the stale-gate rmi + --no-cache
                        rebuild (non-interactive; otherwise a /dev/tty Y/n prompt gates it)
  --config-dir <dir>    override config dir (default $XDG_CONFIG_HOME/portitor/<instance>)
  --repo <name>         portitor repo id / repos.d basename (default: repo half of --slug)
  --map <p>=<a>         map portitor role <p> to a differently-named stdin role <a> (repeatable)
  --portitor-bin <path> the verified-release portitor binary for host-side add-role; default:
                        the first real `portitor` on PATH (install the signed portitor release)
  --policy <file>       declarative static gate policy (action_roles / merge_gate /
                        content_rules / identity_only_roles); default $PROJECT/portitor/policy.json
  -h, --help            this help

Roles for up/restart are read as `role-keys --json` on stdin. Exit: 0 ok, 1 runtime, 2 usage.
EOF
	exit "${1:-0}"
}

# ---- argument parsing -----------------------------------------------------
[[ $# -gt 0 ]] || usage 2
case "$1" in -h|--help) usage 0 ;; esac
VERB="$1"; shift
case "$VERB" in up|down|status|restart) ;; *) die "unknown verb: $VERB (want up|down|status|restart)" 2 ;; esac

INSTANCE="" SLUG="" PAT="" PROJECT="" CONFIG_DIR="" REPO=""
ALLOW=() MAP_ARGS=() COMMIT_EMAILS=()
PORTITOR_BIN_ARG=""
POLICY_ARG=""
BUILD=false
FORCE_PORTITOR_REBUILD=false

need_val() { [[ $# -ge 2 ]] || die "$1 needs a value" 2; }
while [[ $# -gt 0 ]]; do
	case "$1" in
		--instance)     need_val "$@"; INSTANCE="$2"; shift 2 ;;
		--slug)         need_val "$@"; SLUG="$2"; shift 2 ;;
		--pat)          need_val "$@"; PAT="$2"; shift 2 ;;
		--project)      need_val "$@"; PROJECT="$2"; shift 2 ;;
		--config-dir)   need_val "$@"; CONFIG_DIR="$2"; shift 2 ;;
		--repo)         need_val "$@"; REPO="$2"; shift 2 ;;
		--allow)        need_val "$@"; ALLOW+=("$2"); shift 2 ;;
		--commit-email) need_val "$@"; COMMIT_EMAILS+=("$2"); shift 2 ;;
		--build)        BUILD=true; shift ;;
		--force-portitor-rebuild) FORCE_PORTITOR_REBUILD=true; shift ;;
		--map)          need_val "$@"; MAP_ARGS+=("$2"); shift 2 ;;
		--portitor-bin)  need_val "$@"; PORTITOR_BIN_ARG="$2"; shift 2 ;;
		--policy)        need_val "$@"; POLICY_ARG="$2"; shift 2 ;;
		-h|--help)      usage 0 ;;
		*)              die "unknown flag: $1 (see --help)" 2 ;;
	esac
done

# ---- instance name discipline (first line of defense; before ANY side effect) ----
[[ -n "$INSTANCE" ]] || die "--instance is required" 2
[[ "$INSTANCE" =~ $INSTANCE_RE ]] || die "invalid --instance '$INSTANCE' (want ^[a-z0-9][a-z0-9-]{0,30}\$: lowercase alnum + hyphen, <=31 chars)" 2

# Derived names — every object keyed off INSTANCE.
NET="${INSTANCE}-net"
EGRESS_CT="${INSTANCE}-egress"
GATE_CT="portitor-${INSTANCE}"
PORTITOR_IMAGE="portitor-${INSTANCE}"   # per-instance gate image: rmi/rebuild never touches another instance
REPOS_VOL="${INSTANCE}-repos"

# Usage-error (exit 2) validation for up/restart BEFORE any filesystem/docker
# side effect — a bad flag never leaves a half-built config dir behind.
if [[ "$VERB" == up || "$VERB" == restart ]]; then
	[[ -n "$SLUG" ]]    || die "--slug <owner/repo> is required for $VERB" 2
	[[ "$SLUG" =~ $SLUG_RE ]] || die "invalid --slug '$SLUG' (want owner/repo)" 2
	[[ -n "$PAT" ]]     || die "--pat <service>[/account] is required for $VERB" 2
	[[ -n "$PROJECT" ]] || die "--project <dir> is required for $VERB" 2
	[[ -d "$PROJECT" ]] || die "--project dir does not exist: $PROJECT" 2
	# Static gate policy: a declarative file in the project (override with --policy).
	[[ -n "$POLICY_ARG" ]] && POLICY="$POLICY_ARG" || POLICY="$PROJECT/portitor/policy.json"
	[[ -f "$POLICY" ]] || die "gate policy not found: $POLICY (expected \$PROJECT/portitor/policy.json or --policy)" 2
	jq -e 'type=="object" and has("format_version") and has("action_roles")
	       and has("merge_gate") and has("content_rules") and has("identity_only_roles")' \
		"$POLICY" >/dev/null 2>&1 \
		|| die "gate policy $POLICY malformed or missing keys (format_version, action_roles, merge_gate, content_rules, identity_only_roles)" 2
	# repo id defaults to the repo half of the slug.
	[[ -n "$REPO" ]] || REPO="${SLUG#*/}"
	# Match portitor config.ValidName exactly: [A-Za-z0-9._-]+ but never '.'/'..'
	# (those pass the charclass yet portitor's ValidName rejects them — catch it
	# here, before any repos.d/<repo>.json seed file is written).
	{ [[ "$REPO" =~ ^[A-Za-z0-9._-]+$ ]] && [[ "$REPO" != . && "$REPO" != .. ]]; } \
		|| die "invalid --repo '$REPO' (allowed: A-Za-z0-9._-; not '.' or '..')" 2
	# egress hosts: reject any regex metacharacter now (fail-fast, before mutation).
	for h in ${ALLOW[@]+"${ALLOW[@]}"}; do
		[[ "$h" =~ $HOST_RE ]] || die "invalid --allow host '$h' (allowed: A-Za-z0-9._-; no regex metacharacters — a host must never widen into a wildcard)" 2
	done
	# committer emails: gate compares byte-exact; catch obviously broken values here.
	for e in ${COMMIT_EMAILS[@]+"${COMMIT_EMAILS[@]}"}; do
		[[ "$e" =~ $EMAIL_RE ]] || die "invalid --commit-email '$e' (want local@domain, no whitespace)" 2
	done
	$BUILD && ! command -v faber >/dev/null 2>&1 && die "--build needs the faber binary on PATH" 2
fi

# Config dir (default per-instance under XDG). Absolutize (compose bind source).
[[ -n "$CONFIG_DIR" ]] || CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/portitor/$INSTANCE"
mkdir -p "$CONFIG_DIR"
CONFIG_DIR="$(cd -- "$CONFIG_DIR" && pwd)"
REPOS_D="$CONFIG_DIR/repos.d"
SIGNERS_HOST="$CONFIG_DIR/allowed_signers"
EGRESS_FILTER="$CONFIG_DIR/egress-filter"

compose() { docker compose -p "$INSTANCE" -f "$COMPOSE_FILE" "$@"; }

# ---- down / status: thin maps over compose; no slug/pat/project/stdin ------
# Compose still interpolates ${CONFIG_DIR}/${INSTANCE} and the secret/auth env,
# so export harmless empties for those (never a real PAT on these paths).
if [[ "$VERB" == status || "$VERB" == down ]]; then
	command -v docker >/dev/null 2>&1 || die "docker not found on PATH" 1
	docker info >/dev/null 2>&1 || die "docker is not running — start docker" 1
	export INSTANCE CONFIG_DIR
	export GH_TOKEN="" AGENT_AUTHORIZED_KEY=""
	case "$VERB" in
		status) compose ps ;;
		down)   compose down ;;   # keeps the ${INSTANCE}-repos volume (mirrors persist)
	esac
	exit $?
fi

# ============================================================================
# up / restart  (required-flag/shape validation already done above)
# ============================================================================
command -v docker >/dev/null 2>&1 || die "docker not found on PATH — install/start docker" 1
command -v jq >/dev/null 2>&1     || die "jq not found on PATH — install jq" 1
docker info >/dev/null 2>&1       || die "docker is not running — start docker" 1

# ---- --build: validate + build the box images first ------------------------
# Fail-fast ordering: a config error dies here, before any gate/network
# mutation. The config path is passed ABSOLUTE on purpose — with a relative
# --config faber resolves hook/skill paths against the CWD and every gated box
# dies at docker's bind-mount guard.
if $BUILD; then
	cfg="$(cd -- "$PROJECT" && pwd)/orchestrator.yaml"
	[[ -f "$cfg" ]] || die "--build: no orchestrator.yaml under --project ($cfg)" 2
	echo "faber-stack: faber validate + build ($cfg)" >&2
	faber validate --config "$cfg" || die "faber validate failed" 1
	faber build    --config "$cfg" || die "faber build failed" 1
fi

# The gh_token secret is environment-sourced (secrets.gh_token.environment in
# portitor-stack.yml). That feature landed in Docker Compose 2.20; on anything
# older `compose up` fails with a cryptic secret error. Probe + fail clearly now.
COMPOSE_VER="$(docker compose version --short 2>/dev/null || true)"
COMPOSE_VER="${COMPOSE_VER#v}"
[[ "$COMPOSE_VER" =~ ^([0-9]+)\.([0-9]+) ]] \
	|| die "could not determine 'docker compose' version ('${COMPOSE_VER:-none}') — the stack needs the Docker Compose v2 plugin (>=2.20), not docker-compose v1" 1
if (( BASH_REMATCH[1] < 2 || (BASH_REMATCH[1] == 2 && BASH_REMATCH[2] < 20) )); then
	die "docker compose $COMPOSE_VER is too old — the gh_token secret is environment-sourced, which requires Docker Compose >= 2.20; upgrade the compose plugin" 1
fi

# ---- resolve the REAL portitor binary (the VERIFIED RELEASE, never a build) --
# Host-side add-role needs the real portitor binary. We CONSUME the signed
# release — install it once with portitor's own signed install.sh (it verifies the
# archive with `ssh-keygen -Y verify` against the shared release key) so `portitor`
# lands on PATH at $INSTALL_DIR (default /usr/local/bin). faber-stack does NOT
# build portitor from source. Resolution: --portitor-bin <path> > the first REAL
# `portitor` on PATH (dot's `#!` SSH wrapper is skipped) > error.
PORTITOR_BIN="$PORTITOR_BIN_ARG"
resolve_portitor_bin() {
	if [[ -z "$PORTITOR_BIN" ]]; then
		local c
		while IFS= read -r c; do
			[[ -x "$c" ]] || continue
			# Skip dot's SSH-forwarding wrapper (a `#!` script that `exec ssh`es to
			# the gate); the real binary is an ELF/mach-o.
			[[ "$(head -c2 "$c" 2>/dev/null)" == '#!' ]] && continue
			PORTITOR_BIN="$c"; break
		done < <(type -aP portitor 2>/dev/null)
	fi
	[[ -n "$PORTITOR_BIN" ]] || die "no real portitor binary found — install the verified portitor release (run portitor's signed install.sh, which does the ssh-keygen -Y verify) so 'portitor' is on PATH, or pass --portitor-bin <path>. faber-stack does not build portitor from source." 1
	[[ -x "$PORTITOR_BIN" ]] || die "portitor binary not executable: $PORTITOR_BIN" 1
	if [[ "$(head -c2 "$PORTITOR_BIN" 2>/dev/null)" == '#!' ]]; then
		die "--portitor-bin ($PORTITOR_BIN) is a shell script, not the real portitor binary (looks like the SSH wrapper) — point it at the installed release binary" 1
	fi
}
resolve_portitor_bin

# ---- read + parse role assignments from stdin (role-keys --json) -----------
[[ ! -t 0 ]] || die "roles must be piped on stdin: role-keys --repo $REPO --json | faber-stack $VERB ..." 2
ROLES_JSON="$(cat)"
echo "$ROLES_JSON" | jq -e '.assignments | type == "array"' >/dev/null 2>&1 \
	|| die "stdin is not role-keys --json ({\"assignments\":[...]})" 2

# --map <portitor-role>=<assignment-role> (default identity).
declare -A ROLE_MAP
for r in "${PORTITOR_ROLES[@]}"; do ROLE_MAP[$r]="$r"; done
for m in ${MAP_ARGS[@]+"${MAP_ARGS[@]}"}; do
	[[ "$m" == *=* ]] || die "invalid --map '$m' (want <portitor-role>=<assignment-role>)" 2
	p="${m%%=*}" a="${m#*=}"
	[[ -n "${ROLE_MAP[$p]:-}" ]] || die "invalid --map '$m': '$p' is not a portitor role (want one of ${PORTITOR_ROLES[*]})" 2
	[[ -n "$a" ]] || die "invalid --map '$m': empty assignment role" 2
	ROLE_MAP[$p]="$a"
done

# Resolve each portitor role -> its fingerprint + host pub path from stdin.
declare -A ROLE_FP ROLE_PUB
lookup_role() { # <assignment-role> <field>
	echo "$ROLES_JSON" | jq -r --arg r "$1" --arg f "$2" \
		'.assignments | map(select(.role==$r)) | .[0][$f] // ""'
}
for pr in "${PORTITOR_ROLES[@]}"; do
	ar="${ROLE_MAP[$pr]}"
	fp="$(lookup_role "$ar" fingerprint)"
	pub="$(lookup_role "$ar" pub)"
	[[ -n "$fp" ]]  || die "stdin has no assignment for portitor role '$pr' (looked for role '$ar'; map it with --map $pr=<name>)" 2
	[[ "$fp" =~ $FP_RE ]] || die "role '$pr' fingerprint is not the SHA256:<43 base64> form portitor requires: $fp" 2
	[[ -n "$pub" ]] || die "role '$pr' (assignment '$ar') has no pub path — put its pubkey in ~/.ssh so role-keys emits a 'pub' field (needed for AGENT_AUTHORIZED_KEY and allowed_signers)" 2
	[[ -f "$pub" ]] || die "role '$pr' pub file does not exist: $pub" 2
	ROLE_FP[$pr]="$fp"
	ROLE_PUB[$pr]="$pub"
done

# ---- resolve the GitHub PAT from the keychain (never onto argv/inspect) ----
PAT_SVC="${PAT%%/*}"
PAT_ACCT="default"; [[ "$PAT" == */* ]] && PAT_ACCT="${PAT#*/}"
resolve_pat() {
	if [[ "$(uname)" == "Darwin" ]]; then
		security find-generic-password -s "$PAT_SVC" -a "$PAT_ACCT" -w 2>/dev/null || true
	else
		secret-tool lookup service "$PAT_SVC" account "$PAT_ACCT" 2>/dev/null || true
	fi
}
GH_TOKEN="$(resolve_pat)"
[[ -n "$GH_TOKEN" ]] || die "no PAT in keychain for service='$PAT_SVC' account='$PAT_ACCT' — store it: security add-generic-password -s $PAT_SVC -a $PAT_ACCT -w '<CONTENTS+PR PAT>' (Linux: secret-tool store --label=$PAT_SVC service $PAT_SVC account $PAT_ACCT)" 1

# ---- AGENT_AUTHORIZED_KEY: one `type data` line per role pub ---------------
AGENT_AUTHORIZED_KEY=""
for pr in "${PORTITOR_ROLES[@]}"; do
	AGENT_AUTHORIZED_KEY+="$(awk '{print $1, $2}' "${ROLE_PUB[$pr]}")"$'\n'
done

# ---- temp-file cleanup -----------------------------------------------------
# mktmp assigns the new path into a caller-named variable AND registers it in the
# parent's TMPS, so cleanup() actually sees it. (A `$(mktmp ...)` form would run
# the append in a command-substitution subshell and leave the parent TMPS empty —
# the trap would then remove nothing.) Called directly, never in `$(...)`.
TMPS=()
cleanup() { local t; for t in ${TMPS[@]+"${TMPS[@]}"}; do rm -f "$t"; done; }
trap cleanup EXIT INT TERM
mktmp() { # <dest-varname> <path-prefix>   -> sets $<dest-varname>, appends to TMPS
	local -n _dest="$1"
	_dest="$(mktemp "$2.XXXXXX")" || die "failed to create a temp file under $2" 1
	TMPS+=("$_dest")
}

# ---- (3) seed repos.d/<repo>.json host-side, atomic, only if absent --------
# allowed_signers field is seeded to the HOST path so host-side add-role can
# write+os.Stat-validate the real file; it is swapped to the in-container path
# just before compose up (§4.3). Never clobber a roles map a prior run filled.
mkdir -p "$REPOS_D"
CFG="$REPOS_D/$REPO.json"
if [[ ! -f "$CFG" ]]; then
	mktmp tmp "$REPOS_D/.$REPO.json"
	jq -n --argjson fv 1 --arg db main --arg as "$SIGNERS_HOST" --arg ur upstream --arg us "$SLUG" \
	      --argjson up true --argjson roles '{}' \
		'{format_version:$fv, default_branch:$db, allowed_signers:$as, upstream_remote:$ur,
		  upstream_slug:$us, require_up_to_date_with_default:$up, roles:$roles}' >"$tmp" \
		|| die "failed to render seed config for $REPO" 1
	mv "$tmp" "$CFG"
else
	# Re-run: reconcile the flag-derived upstream fields to the CURRENT flags (a
	# changed --slug otherwise leaves a stale upstream_slug while the in-container
	# add-repo mirrors from the new slug — silent divergence). Preserve the roles
	# map and everything else a prior run filled.
	mktmp rtmp "$REPOS_D/.$REPO.json"
	jq --arg db main --arg us "$SLUG" '.default_branch=$db | .upstream_slug=$us' "$CFG" >"$rtmp" \
		|| die "failed to reconcile upstream fields for $REPO" 1
	mv "$rtmp" "$CFG"
fi

# Overlay the STATIC gate policy from $POLICY onto the computed config, and DROP the
# retired role_rules / reviews_log keys so an older repos.d config converges here
# instead of failing the gate's format_version guard or its "config carries the
# retired role_rules key" refusal. Preserves the computed fields already in $CFG
# (roles map, allowed_signers, upstream_*, default_branch). allowed_committer_emails
# converges with the --commit-email flags: present when any were given, DELETED when
# none (not an empty list) — a gate release predating the key strict-decode-rejects
# any config carrying it, so an absent field keeps a flagless run compatible.
EMAILS_JSON="$(jq -cn '$ARGS.positional' --args ${COMMIT_EMAILS[@]+"${COMMIT_EMAILS[@]}"})" \
	|| die "failed to render the committer-email list" 1
mktmp ptmp "$REPOS_D/.$REPO.json"
jq --slurpfile pol "$POLICY" --argjson emails "$EMAILS_JSON" \
	'($pol[0]) as $p
	 | del(.role_rules) | del(.reviews_log)
	 | .format_version      = $p.format_version
	 | .action_roles        = $p.action_roles
	 | .content_rules       = $p.content_rules
	 | .merge_gate          = $p.merge_gate
	 | .identity_only_roles = $p.identity_only_roles
	 | if ($emails | length) > 0 then .allowed_committer_emails=$emails
	   else del(.allowed_committer_emails) end' "$CFG" >"$ptmp" \
	|| die "failed to overlay the gate policy for $REPO" 1
mv "$ptmp" "$CFG"
touch "$SIGNERS_HOST"

# ---- swap allowed_signers field to the HOST path around the add-role loop ---
swap_signers_field() { # <target-path>
	local tmp; mktmp tmp "$REPOS_D/.$REPO.json"
	jq --arg as "$1" '.allowed_signers=$as' "$CFG" >"$tmp" || die "failed to swap allowed_signers field" 1
	mv "$tmp" "$CFG"
}
swap_signers_field "$SIGNERS_HOST"

# ---- (4) build roles HOST-side via the real portitor binary ----------------
# add-role resolves its repos dir from PORTITOR_REPOS_DIR (no --config-dir flag),
# writes to the WRITABLE host config, and post-validates allowed_signers (os.Stat
# of the host path, which is why the field points host-side here). Idempotent.
export PORTITOR_REPOS_DIR="$REPOS_D"
# add-role UPSERTS but never removes, so a rotated/removed key would linger in the
# roles map + allowed_signers on re-run (a widening authorization gap). Reset both
# to empty first so the loop below rebuilds EXACTLY the current fingerprints —
# the stack converges to the roles on stdin rather than accumulating stale ones.
mktmp rtmp "$REPOS_D/.$REPO.json"
jq '.roles={}' "$CFG" >"$rtmp" || die "failed to reset roles map for $REPO" 1
mv "$rtmp" "$CFG"
: >"$SIGNERS_HOST"
for pr in "${PORTITOR_ROLES[@]}"; do
	args=(add-role --repo "$REPO" --role "$pr" --fingerprint "${ROLE_FP[$pr]}")
	[[ "${IS_SIGNER[$pr]}" == 1 ]] && args+=(--pub "${ROLE_PUB[$pr]}")
	"$PORTITOR_BIN" "${args[@]}" >&2 || die "portitor add-role failed for role '$pr'" 1
done

# ---- swap allowed_signers field to the IN-CONTAINER path (at rest) ----------
swap_signers_field "$CONTAINER_SIGNERS"

# ---- (5) write the per-instance egress filter (atomic) ---------------------
# Each --allow host becomes one anchored ^host$ line with '.' escaped; hosts are
# validated first so a value can never widen into a wildcard / open proxy.
# api.anthropic.com is the agent's lifeline — EVERY box runs the agent, so it is
# ALWAYS in the allow-list; --allow only ADDS extras (module proxy, etc.). The old
# empty-default form dropped anthropic the moment any --allow was passed, silently
# blocking the agent's API — a box with a --allow set could never reach Anthropic.
ALLOW=(api.anthropic.com ${ALLOW[@]+"${ALLOW[@]}"})
mktmp etmp "$CONFIG_DIR/.egress-filter"
{
	echo "# Per-instance egress allow-list for '$INSTANCE' (extended regex, FilterDefaultDeny=Yes)."
	echo "# Generated by faber-stack from --allow; each line is an anchored ^host\$. Do not edit."
	for h in "${ALLOW[@]}"; do
		[[ "$h" =~ $HOST_RE ]] || die "invalid --allow host '$h' (allowed: A-Za-z0-9._-; no regex metacharacters)" 2
		printf '^%s$\n' "${h//./\\.}"
	done
} >"$etmp"
# The egress-filter is bind-mounted and tinyproxy loads it at START; a plain
# `compose up -d` won't restart it on a content-only change. Record whether the
# allow-list actually changed so step 8 can force-recreate egress to apply it.
EGRESS_FILTER_CHANGED=0
cmp -s "$etmp" "$EGRESS_FILTER" 2>/dev/null || EGRESS_FILTER_CHANGED=1
mv "$etmp" "$EGRESS_FILTER"

# ---- (6) export the interpolation env for compose --------------------------
export INSTANCE CONFIG_DIR GH_TOKEN AGENT_AUTHORIZED_KEY PORTITOR_IMAGE

# ---- (7) build / refresh images --------------------------------------------
# The gate image is SELF-CONTAINED (built from the dot context $GATE_CTX): its
# Dockerfile fetches + SSHSIG-verifies the portitor release binary (the PORTITOR_VERSION
# arg can pin one) and adds `br` — no portitor checkout. It is PER-INSTANCE
# ($PORTITOR_IMAGE = portitor-$INSTANCE) so a rebuild for this repo can never disturb
# another instance's gate. Built when missing; under --build it is ALSO audited for
# staleness against the installed portitor and rebuilt --no-cache if it lags (a stale
# gate silently runs old policy semantics), after warning which containers that removes.
ensure_gate_image() {
	# Missing → build it fresh (any verb).
	if ! docker image inspect "$PORTITOR_IMAGE" >/dev/null 2>&1; then
		docker build -t "$PORTITOR_IMAGE" "$GATE_CTX" \
			|| die "failed to build gate image $PORTITOR_IMAGE from $GATE_CTX (needs network to fetch + verify portitor)" 1
		return 0
	fi
	$BUILD || return 0   # only --build audits freshness; plain up trusts the cached image
	# --force-portitor-rebuild rebuilds unconditionally — e.g. to pick up a gate
	# Dockerfile change (new base/gh) that leaves the baked portitor version
	# unchanged, which the version audit below would otherwise call "current".
	if $FORCE_PORTITOR_REBUILD; then
		echo "faber-stack: --force-portitor-rebuild set — rebuilding $PORTITOR_IMAGE unconditionally (version match ignored)." >&2
	else
		local baked installed
		baked="$(docker run --rm --entrypoint portitor "$PORTITOR_IMAGE" --version 2>/dev/null | awk 'NR==1{print $2}')"
		installed="$("$PORTITOR_BIN" --version 2>/dev/null | awk 'NR==1{print $2}')"
		if [[ -n "$baked" && "$baked" == "$installed" ]]; then
			echo "faber-stack: gate image $PORTITOR_IMAGE is current (portitor $baked)" >&2; return 0
		fi
		echo "faber-stack: gate $PORTITOR_IMAGE bakes portitor '${baked:-unknown}' but installed is '${installed:-unknown}' — rebuild needed for current policy." >&2
		local cs; cs="$(docker ps -a --filter "ancestor=$PORTITOR_IMAGE" --format '    {{.Names}}  [{{.State}}]')"
		if [[ -n "$cs" ]]; then
			echo "faber-stack: rebuild does 'rmi $PORTITOR_IMAGE'; these use it (torn down + recreated on up):" >&2
			printf '%s\n' "$cs" >&2
		else
			echo "faber-stack: no containers currently use $PORTITOR_IMAGE." >&2
		fi
		if [[ -r /dev/tty ]]; then
			local ans; printf 'faber-stack: rmi + --no-cache rebuild the gate now? [Y/n] ' >&2
			read -r ans </dev/tty || ans=n
			case "$ans" in ""|[Yy]|[Yy][Ee][Ss]) : ;; *) die "aborted: gate image is stale and the rebuild was declined" 1 ;; esac
		else
			die "gate image stale and no TTY to confirm — re-run with --force-portitor-rebuild (or without --build to use it as-is)" 1
		fi
	fi
	compose down >/dev/null 2>&1 || true   # free the image — this instance only (-p $INSTANCE)
	docker rmi "$PORTITOR_IMAGE" >/dev/null 2>&1 \
		|| die "failed to rmi stale gate image $PORTITOR_IMAGE (a container still holds it — stop it and retry)" 1
	docker build --no-cache -t "$PORTITOR_IMAGE" "$GATE_CTX" \
		|| die "failed to rebuild gate image $PORTITOR_IMAGE from $GATE_CTX" 1
	echo "faber-stack: rebuilt gate image $PORTITOR_IMAGE." >&2
}
ensure_gate_image
docker image inspect egress-proxy >/dev/null 2>&1 || docker build -t egress-proxy "$EGRESS_CTX" \
	|| die "failed to build the egress-proxy image from $EGRESS_CTX" 1

# ---- (8) bring the stack up -------------------------------------------------
# restart tears the containers down first (mirror volume persists).
[[ "$VERB" == restart ]] && compose down >/dev/null 2>&1 || true
compose up -d || die "docker compose up failed" 1
# A changed egress allow-list only reaches tinyproxy on a restart: the filter is
# bind-mounted (content isn't part of compose's recreate check) and read at start.
# Recreate egress explicitly when it changed (harmless no-op on a fresh create).
[[ "${EGRESS_FILTER_CHANGED:-0}" == 1 ]] \
	&& { compose up -d --force-recreate egress \
		|| die "failed to recreate egress to apply the new allow-list" 1; }

# ---- (9) wait for the gate to be READY, pinning its host key as the probe --
# `compose up -d` returns when the container is STARTED, not when its sshd is
# accepting — the gate entrypoint runs `ssh-keygen -A`, `gh auth login`, config
# validation, and `exec sshd` LAST. A one-shot ssh-keyscan fired in that window
# gets nothing and leaves a STALE (or absent) pin; the box then fails host-key
# verification (StrictHostKeyChecking=yes) on the fresh gate's new key, or the
# security bind can't read the pin at all. So retry the keyscan until the gate
# answers: the first success is a total readiness barrier (sshd up ⟹ the
# entrypoint finished ⟹ gh auth is persisted), and we pin the CURRENT key. Do it
# BEFORE add-repo so a good pin also gates the mirror fetch, which needs the
# gate's gh auth. ssh-keyscan runs on the internal net via the egress image
# (present locally, ships openssh-client) so it never triggers a network pull.
mkdir -p "$PROJECT/keys"
PIN="$PROJECT/keys/portitor_host_key.pub"
mktmp ptmp "$PROJECT/keys/.portitor_host_key.pub"
pinned=""
for _ in $(seq 1 30); do
	if docker run --rm --network "$NET" egress-proxy \
			ssh-keyscan -t ed25519 "$GATE_CT" >"$ptmp" 2>/dev/null && [[ -s "$ptmp" ]]; then
		mv "$ptmp" "$PIN"; pinned=1; break
	fi
	sleep 1
done
if [[ -n "$pinned" ]]; then
	echo "faber-stack: pinned $GATE_CT host key -> $PIN" >&2
else
	echo "faber-stack: WARNING — gate $GATE_CT did not answer in 30s; host key unpinned (stack is up; re-pin any time):" >&2
	echo "  docker run --rm --network $NET egress-proxy ssh-keyscan -t ed25519 $GATE_CT > $PIN" >&2
fi

# ---- (10) mirror the repo IN the container (needs GitHub + rw /srv/git) -----
# Gated by the readiness barrier above (sshd up ⟹ gh auth persisted), so the
# upstream fetch has its credential. Idempotent: skip if the bare mirror already
# exists. A mirror failure (e.g. bad PAT scope) does NOT tear the stack down —
# the gate is up; report + name the retry.
if docker exec -u git "$GATE_CT" test -d "/srv/git/$REPO.git" 2>/dev/null; then
	echo "faber-stack: mirror /srv/git/$REPO.git already present — skipping add-repo." >&2
else
	if ! docker exec -u git "$GATE_CT" portitor add-repo --repo "$REPO" \
			--upstream "https://github.com/$SLUG.git" >&2; then
		echo "faber-stack: WARNING — the stack is UP but 'add-repo' (mirror) failed." >&2
		echo "  Check the PAT scope (Contents+PR on $SLUG), then retry just the mirror:" >&2
		echo "  docker exec -u git $GATE_CT portitor add-repo --repo $REPO --upstream https://github.com/$SLUG.git" >&2
	fi
fi

# ---- (11) print the faber substrate this instance now satisfies ------------
cat >&2 <<EOF

faber-stack: instance '$INSTANCE' is up. Orchestrator substrate it satisfies:

  network:
    name: $NET
    proxy: http://$EGRESS_CT:8888
    no_proxy: [$GATE_CT, localhost, 127.0.0.1]
  remote:
    url: ssh://git@$GATE_CT/srv/git
    host_key_file: ./keys/portitor_host_key.pub   # pinned at $PIN

  config dir: $CONFIG_DIR   (mounted :ro at /etc/portitor)
  mirror:     /srv/git/$REPO.git   (volume $REPOS_VOL)
  egress:     $(grep -v '^#' "$EGRESS_FILTER" | tr '\n' ' ')
EOF
exit 0
