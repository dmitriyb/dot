#!/usr/bin/env bash
# portitor — thin client wrapper for the agent.
#
# The agent has no gh and no GitHub credential; every GitHub action goes through
# the portitor service over SSH (the forced `portitor shell` dispatches it). This
# wrapper forwards the command + stdin (comment/review bodies) to portitor, and
# injects `--repo $DCA_REPO` for `pr` subcommands (the multi-repo proxy needs to
# know which repo) when the caller didn't pass one.
#
#   portitor pr <comment|review|merge|close|fetch> --pr N   (body on stdin)
set -euo pipefail

args=("$@")
if [[ "${1:-}" == "pr" && -n "${DCA_REPO:-}" && " $* " != *" --repo "* ]]; then
	args=("$@" --repo "$DCA_REPO")
fi
exec ssh "git@${PORTITOR_HOST:-portitor}" portitor "${args[@]}"
