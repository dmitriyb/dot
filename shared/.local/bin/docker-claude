#!/usr/bin/env bash
set -euo pipefail

BASE_IMAGE="claude-dev-base"
PERSONAL_IMAGE="claude-dev-personal"
WORK_IMAGE="claude-dev-work"
MODE=""
REBUILD=false
NO_CACHE=false
AGENT_MODE=false

# Parse flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--personal)
            MODE="personal"
            shift
            ;;
        -w|--work)
            MODE="work"
            shift
            ;;
        --direct)
            MODE="direct"
            shift
            ;;
        -r|--rebuild)
            REBUILD=true
            shift
            ;;
        --no-cache)
            NO_CACHE=true
            REBUILD=true
            shift
            ;;
        -a|--agent)
            AGENT_MODE=true
            shift
            ;;
        --workspace)
            WORKSPACE="$2"
            shift 2
            ;;
        *)
            echo "Unknown flag: $1"
            echo "Usage: docker-claude (-p|--personal | -w|--work | --direct) [-a|--agent] [-r] [--no-cache] [--workspace <path>]"
            exit 1
            ;;
    esac
done

# Portable `readlink -f` (BSD/macOS readlink lacks -f): walk the symlink chain.
resolve_path() {
    local p="$1" target
    while [ -L "$p" ]; do
        target="$(readlink "$p")"
        case "$target" in
            /*) p="$target" ;;
            *)  p="$(cd "$(dirname "$p")" && pwd)/$target" ;;
        esac
    done
    printf '%s\n' "$p"
}

# Build images if missing or rebuild requested
SCRIPT_DIR="$(cd "$(dirname "$(resolve_path "$0")")" && cd ../../.. && pwd)/docker/claude"
BUILD_ARGS=(--build-arg HOST_UID="$(id -u)")

build_base() {
    echo "Building $BASE_IMAGE..."
    if [[ "$NO_CACHE" == true ]]; then
        docker build --no-cache "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
    else
        docker build "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
    fi
}

build_personal() {
    echo "Building $PERSONAL_IMAGE..."
    docker build -f "$SCRIPT_DIR/Dockerfile.personal" -t "$PERSONAL_IMAGE" "$SCRIPT_DIR"
}

build_work() {
    # Generate dedicated SSH key for IDEA Remote Development if missing
    local key_path="$HOME/.ssh/docker_claude_id_ed25519"
    if [[ ! -f "$key_path" ]]; then
        echo "Generating SSH key for Docker Claude IDEA access..."
        ssh-keygen -t ed25519 -f "$key_path" -N "" -C "docker-claude"
    fi
    local pubkey
    pubkey=$(cat "$key_path.pub")

    echo "Building $WORK_IMAGE..."
    docker build \
        --build-arg "DOCKER_CLAUDE_PUBKEY=$pubkey" \
        -f "$SCRIPT_DIR/Dockerfile.work" -t "$WORK_IMAGE" "$SCRIPT_DIR"
}

if [[ "$REBUILD" == true ]]; then
    build_base
    if [[ -z "$MODE" ]]; then
        build_personal
        build_work
        exit 0
    fi
    [[ "$MODE" == "personal" ]] && build_personal
    [[ "$MODE" == "work" || "$MODE" == "direct" ]] && build_work
else
    if ! docker image inspect "$BASE_IMAGE" &>/dev/null; then
        build_base
    fi
    if [[ "$MODE" == "personal" ]] && ! docker image inspect "$PERSONAL_IMAGE" &>/dev/null; then
        build_personal
    fi
    if [[ "$MODE" == "work" || "$MODE" == "direct" ]] && ! docker image inspect "$WORK_IMAGE" &>/dev/null; then
        build_work
    fi
fi

if [[ -z "$MODE" ]]; then
    echo "Error: specify account mode."
    echo "Usage: docker-claude (-p|--personal | -w|--work | --direct) [-r] [--workspace <path>]"
    exit 1
fi

# Platform-specific default workspace
if [[ -z "${WORKSPACE:-}" ]]; then
    if [[ "$(uname)" == "Darwin" ]]; then
        WORKSPACE="$HOME/work"
    else
        WORKSPACE="$HOME/Work"
    fi
fi


# Platform-specific "not found" exit code from the keychain CLI.
if [[ "$(uname)" == "Darwin" ]]; then
    KEYCHAIN_NOTFOUND_RC=44   # errSecItemNotFound
else
    KEYCHAIN_NOTFOUND_RC=1    # secret-tool / libsecret
fi

# Pure passthrough: dispatch to the right OS keychain tool, return its stdout
# and exit code verbatim. No policy.
_keychain_read() {
    local service="$1" account="${2:-}"
    if [[ "$(uname)" == "Darwin" ]]; then
        if [[ -n "$account" ]]; then
            security find-generic-password -s "$service" -a "$account" -w 2>/dev/null
        else
            security find-generic-password -s "$service" -w 2>/dev/null
        fi
    else
        if [[ -n "$account" ]]; then
            secret-tool lookup service "$service" account "$account" 2>/dev/null
        else
            secret-tool lookup service "$service" 2>/dev/null
        fi
    fi
}

# Required secret: prints an Error and aborts if missing or unreadable.
keychain_require() {
    local service="$1" account="$2" label="$3" hint="$4" value rc=0
    value=$(_keychain_read "$service" "$account") || rc=$?
    if (( rc == 0 )); then
        printf '%s' "$value"
    elif (( rc == KEYCHAIN_NOTFOUND_RC )); then
        echo "Error: $label not found in keychain (service=$service${account:+, account=$account})." >&2
        if [[ -n "$hint" ]]; then
            echo "$hint" >&2
        fi
        exit 1
    else
        echo "Error: keychain lookup failed for $label (service=$service${account:+, account=$account}, rc=$rc)." >&2
        exit "$rc"
    fi
}

# Optional secret: prints a Warning and returns empty if missing or unreadable.
keychain_optional() {
    local service="$1" account="$2" label="$3" hint="$4" value rc=0
    value=$(_keychain_read "$service" "$account") || rc=$?
    if (( rc == 0 )); then
        printf '%s' "$value"
    elif (( rc == KEYCHAIN_NOTFOUND_RC )); then
        echo "Warning: $label not found in keychain (service=$service${account:+, account=$account}); continuing without it." >&2
        if [[ -n "$hint" ]]; then
            echo "$hint" >&2
        fi
    else
        echo "Warning: keychain lookup failed for $label (rc=$rc); continuing without it." >&2
    fi
}

# Fill GH_ARGS with "-e GH_TOKEN=<token>" if a token is stored for $1, else
# leave GH_ARGS empty. GH_TOKEN makes the in-container `gh` CLI stateless —
# no hosts.yml written, auth owned by host keychain.
resolve_gh_args() {
    local label="$1" token
    token=$(keychain_optional gh "$label" "gh token for '$label' account" \
"In-container 'gh' CLI will be unauthenticated.
  macOS: security add-generic-password -s gh -a $label -w '<PAT>'
  Linux: secret-tool store --label='gh $label' service gh account $label")
    GH_ARGS=()
    if [[ -n "$token" ]]; then
        GH_ARGS=(-e "GH_TOKEN=$token")
    fi
}

# Committed list of SHA-256 hashes identifying the sign-only / no-touch resident
# key(s). Only hashes are stored, never the key name. See the file for details.
SIGNING_HASH_FILE="$HOME/.ssh/signing-key-hashes"

_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | awk '{print $1}'
    else
        shasum -a 256 | awk '{print $1}'
    fi
}

# True if the given key handle's application suffix is listed in SIGNING_HASH_FILE.
_is_signing_key() {
    local suffix h
    suffix="${1##*_sk_rk_}"
    h="$(printf '%s' "$suffix" | _sha256)"
    grep -vE '^[[:space:]]*(#|$)' "$SIGNING_HASH_FILE" 2>/dev/null | grep -qix "$h"
}

# Ephemeral signing agent for agent-mode containers. Sets SIGN_SOCK and loads ONLY
# the no-touch sign-only key (identified by hash). The resident key is pulled off
# the YubiKey at launch (PIN + 1 touch); its handle file is removed as soon as it
# is loaded. The agent is killed and its socket removed on script exit (via trap),
# so the normal environment keeps no signing agent and no sk files at rest.
start_signing_agent() {
    if [[ ! -s "$SIGNING_HASH_FILE" ]] || ! grep -qiE '^[[:space:]]*[0-9a-f]{64}[[:space:]]*$' "$SIGNING_HASH_FILE"; then
        echo "Error: no signing-key hash configured in $SIGNING_HASH_FILE." >&2
        echo "Add one with: printf '%s' '<app-suffix>' | sha256sum" >&2
        exit 1
    fi
    SIGN_SOCK="$(mktemp -u "${TMPDIR:-/tmp}/dc-agent.XXXXXX.sock")"
    eval "$(ssh-agent -a "$SIGN_SOCK")" >/dev/null
    SIGN_PID="$SSH_AGENT_PID"
    trap 'kill "$SIGN_PID" 2>/dev/null; rm -f "$SIGN_SOCK"' EXIT
    local dir key; dir="$(mktemp -d)"
    ( cd "$dir" && ssh-keygen -K -N "" >/dev/null )   # download resident creds (PIN + touch); -N "" skips passphrase
    shopt -s nullglob
    for key in "$dir"/id_*_sk_rk_*; do
        [[ "$key" == *.pub ]] && continue
        if _is_signing_key "$key"; then
            SSH_AUTH_SOCK="$SIGN_SOCK" ssh-add "$key" >/dev/null 2>&1
        fi
    done
    rm -rf "$dir"
    if [[ "$(SSH_AUTH_SOCK="$SIGN_SOCK" ssh-add -L 2>/dev/null | grep -c .)" != 1 ]]; then
        echo "Warning: signing agent does not hold exactly one key." >&2
    fi
}

# Persistent volumes for fish history and tmux resurrect (targeted mounts
# so image-baked binaries like claude and nvim plugins aren't shadowed)
# SSH agent forwarding
SSH_AGENT_ARGS=(-v "$SSH_AUTH_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent)
# Docker Desktop (macOS) mounts sockets as root:root — need group access
if [[ "$(uname)" == "Darwin" ]]; then
    SSH_AGENT_ARGS+=(--group-add 0)
fi

if [[ "$MODE" == "personal" ]]; then
    TOKEN=$(keychain_require anthropic personal "personal Anthropic OAuth token" \
"Generate a setup token from an authenticated Claude Code instance:
  claude setup-token
Then store it:
  macOS: security add-generic-password -s anthropic -a personal -w '<token>'
  Linux: secret-tool store --label='anthropic' service anthropic account personal")
    PERSONAL_REPO_VOLUME="claude-personal-repos"
    resolve_gh_args personal

    if [[ "$AGENT_MODE" == true ]]; then
        # Agent mode: forward an ephemeral no-touch signing-only agent. Transport
        # uses GH_TOKEN over HTTPS (see entrypoint), so the key signs but can't auth.
        start_signing_agent
        PERSONAL_AGENT_ARGS=(-v "$SIGN_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent -e AGENT_MODE=1)
        if [[ "$(uname)" == "Darwin" ]]; then
            PERSONAL_AGENT_ARGS+=(--group-add 0)
        fi
        # NOT exec: control returns here on container exit so the trap tears down
        # the signing agent and removes its socket.
        docker run -it --rm \
            --memory=8g --cpus=4 \
            -e CLAUDE_CODE_OAUTH_TOKEN="$TOKEN" \
            -v "$PERSONAL_REPO_VOLUME":/workspace \
            -v "$FISH_DATA_VOLUME":/home/dev/.local/share/fish \
            -v "$TMUX_DATA_VOLUME":/home/dev/.local/share/tmux \
            "${PERSONAL_AGENT_ARGS[@]}" \
            ${GH_ARGS[@]+"${GH_ARGS[@]}"} \
            "$PERSONAL_IMAGE"
        exit 0
    fi

    exec docker run -it --rm \
        --memory=8g --cpus=4 \
        -e CLAUDE_CODE_OAUTH_TOKEN="$TOKEN" \
        -v "$PERSONAL_REPO_VOLUME":/workspace \
        -v claude-fish-data-personal:/home/dev/.local/share/fish \
        -v claude-tmux-data-personal:/home/dev/.local/share/tmux \
        "${SSH_AGENT_ARGS[@]}" \
        ${GH_ARGS[@]+"${GH_ARGS[@]}"} \
        "$PERSONAL_IMAGE"
fi

# Common work args (shared between wire and direct modes)
WORK_REPO_VOLUME="claude-work-repos"
WORK_COMMON_ARGS=(
    -it --rm
    --memory=8g --cpus=4
    -e JETBRAINS_MCP_STREAM_URL=http://host.docker.internal:64342/stream
    -v "$WORK_REPO_VOLUME":/workspace
    -v claude-fish-data-work:/home/dev/.local/share/fish
    -v claude-tmux-data-work:/home/dev/.local/share/tmux
    "${SSH_AGENT_ARGS[@]}"
    -p 2222:2222
)

if [[ "$MODE" == "work" ]]; then
    # Wire proxy mode (default work mode)
    if ! command -v wire &>/dev/null; then
        echo "Error: wire CLI not found. Install it first."
        exit 1
    fi
    WIRE_KEY=$(wire proxy start --ensure-updated --return-key)
    if [[ -z "$WIRE_KEY" ]]; then
        echo "Error: failed to start wire proxy or get key."
        exit 1
    fi
    WIRE_PORT=$(wire config 2>&1 | awk '/Proxy port:/{print $3}')
    WIRE_BASE_URL="http://host.docker.internal:${WIRE_PORT}/wire/${WIRE_KEY}/claude-code/anthropic"
    resolve_gh_args work

    exec docker run \
        "${WORK_COMMON_ARGS[@]}" \
        -e ANTHROPIC_API_KEY=wire-proxy \
        -e ANTHROPIC_BASE_URL="$WIRE_BASE_URL" \
        ${GH_ARGS[@]+"${GH_ARGS[@]}"} \
        "$WORK_IMAGE"
fi

if [[ "$MODE" == "direct" ]]; then
    # Direct API key mode (from OS keychain)
    KEY=$(keychain_require "Claude Code" "" "work Claude Code API key" \
"Log into Claude Code with your work account first (claude login).
The key is stored automatically in the OS keychain.")
    resolve_gh_args work

    exec docker run \
        "${WORK_COMMON_ARGS[@]}" \
        -e ANTHROPIC_API_KEY="$KEY" \
        ${GH_ARGS[@]+"${GH_ARGS[@]}"} \
        "$WORK_IMAGE"
fi
