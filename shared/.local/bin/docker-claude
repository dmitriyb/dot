#!/usr/bin/env bash
set -eEuo pipefail

# `set -e` exits silently otherwise; -E reaches subshells, BASHPID stops double reports.
trap 'rc=$?; [[ $BASHPID == $$ ]] && echo "docker-claude: aborted (rc=$rc) at ${BASH_SOURCE[0]##*/}:$LINENO: $BASH_COMMAND" >&2' ERR

BASE_IMAGE="claude-dev-base"
PERSONAL_IMAGE="claude-dev-personal"
WORK_IMAGE="claude-dev-work"
WORK_SSH_PORT=2222
PERSONAL_SSH_PORT=2223
KNOWN_HOSTS_FILE="$HOME/.ssh/known_hosts.docker-claude"
MODE=""
REBUILD=false
NO_CACHE=false
STOP=false

usage() {
  cat <<'EOF'
docker-claude — single entrypoint for the containerized Claude cockpit.

  Isolated personal/work Claude Code containers with your dotfiles, entered over SSH
  with agent forwarding, and separate personal/work images. Which modes a host may
  build or run is declared in ~/.config/dot/host.conf (docker_claude.modes).

usage:
  docker-claude personal [-r | --no-cache | --stop]
  docker-claude work [-r | --no-cache | --stop]
  docker-claude -r | --no-cache          # rebuild base + this host's allowed images

commands:
  personal           personal account, Anthropic OAuth token from the secret store
  work               work account via the wire proxy (needs the `jbcentral` CLI)

options:
  -r, --rebuild      rebuild the image(s) before running
  --no-cache         rebuild with no Docker cache (implies --rebuild)
  --stop             stop and remove the mode's running container
  -h, --help         show this help

A second invocation while the container runs opens another SSH session into it.

aliases: dc=docker-claude, dcp=personal, dcw=work.
EOF
}

# Locate the shared lib before it can be sourced. stow may fold the symlink onto the
# file, onto .local/bin, or onto .local, so resolve every component, not just the leaf.
resolve_path() {
  local p="$1" target dir
  while :; do
    dir="$(cd "$(dirname "$p")" && pwd -P)" || return 1
    p="$dir/$(basename "$p")"
    [ -L "$p" ] || break
    target="$(readlink "$p")"
    case "$target" in
    /*) p="$target" ;;
    *) p="$dir/$target" ;;
    esac
  done
  printf '%s\n' "$p"
}
LIBEXEC="$(dirname "$(resolve_path "$0")")/../libexec/docker-claude"
source "$LIBEXEC/agent-common.sh"

# Subcommands are the public interface; they map onto the legacy flags for back-compat.
case "${1:-}" in
personal)
  shift
  set -- --personal "$@"
  ;;
work)
  shift
  set -- --work "$@"
  ;;
help)
  usage
  exit 0
  ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  -p | --personal)
    MODE="personal"
    shift
    ;;
  -w | --work)
    MODE="work"
    shift
    ;;
  -r | --rebuild)
    REBUILD=true
    shift
    ;;
  --no-cache)
    NO_CACHE=true
    REBUILD=true
    shift
    ;;
  --stop)
    STOP=true
    shift
    ;;
  *)
    echo "Unknown flag: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
done

# Checked before anything touches Docker, so a disallowed image is never built either.
if ! ALLOWED_MODES="$(host_conf docker_claude.modes)"; then
  echo "Error: docker_claude.modes missing in $HOST_CONF — re-run dot's setup.sh." >&2
  exit 1
fi
mode_allowed() { [[ ",$ALLOWED_MODES," == *",$1,"* ]]; }
if [[ -n "$MODE" ]] && ! mode_allowed "$MODE"; then
  echo "Error: mode '$MODE' is not enabled on this host (docker_claude.modes=$ALLOWED_MODES in $HOST_CONF)." >&2
  exit 1
fi

case "$MODE" in
personal) IMAGE="$PERSONAL_IMAGE" PORT="$PERSONAL_SSH_PORT" CONTAINER="claude-personal" SSH_ALIAS="docker-personal" ;;
work) IMAGE="$WORK_IMAGE" PORT="$WORK_SSH_PORT" CONTAINER="claude-work" SSH_ALIAS="docker-work" ;;
esac

container_state() { docker container inspect -f '{{.State.Status}}' "$1" 2>/dev/null || true; }

if [[ "$STOP" == true ]]; then
  [[ -n "$MODE" ]] || { echo "Error: --stop needs a mode (personal | work)." >&2; exit 1; }
  if [[ -z "$(container_state "$CONTAINER")" ]]; then
    echo "docker-claude: $CONTAINER is not running."
    exit 0
  fi
  docker rm -f "$CONTAINER" >/dev/null
  [[ -z "$(container_state "$CONTAINER")" ]] || { echo "Error: $CONTAINER still exists after removal." >&2; exit 1; }
  echo "docker-claude: stopped $CONTAINER."
  exit 0
fi

SCRIPT_DIR="$(dot_root "$(dirname "$(resolve_path "$0")")")/docker/claude"
# Rebuilds test the branch you're on, not main. It must be pushed, and Docker caches the
# clone layer — re-test a re-pushed branch of the same name with --no-cache.
DOT_REF="$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
BUILD_ARGS=(--build-arg HOST_UID="$(id -u)" --build-arg DOT_REF="$DOT_REF")

build_base() {
  echo "Building $BASE_IMAGE..."
  if [[ "$NO_CACHE" == true ]]; then
    docker build --no-cache "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
  else
    docker build "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
  fi
}

# One host identity opens both containers: isolation is per-container/port, not per-key.
docker_claude_pubkey() {
  local key_path="$HOME/.ssh/docker_claude_id_ed25519"
  if [[ ! -f "$key_path" ]]; then
    echo "Generating SSH key for Docker Claude Remote Development access..." >&2
    ssh-keygen -t ed25519 -f "$key_path" -N "" -C "docker-claude" >&2
  fi
  cat "$key_path.pub"
}

# Host keys are baked at image build, so each rebuild is a new container identity.
# Reading it from the image rather than off the wire is what lets ~/.ssh/config.d
# keep StrictHostKeyChecking on.
sync_container_host_key() {
  local image="$1" port="$2" key tmp recorded
  key=$(docker run --rm --entrypoint cat "$image" /etc/ssh/ssh_host_ed25519_key.pub | awk '{print $1, $2}')
  if [[ -z "$key" ]]; then
    echo "docker-claude: could not read the SSH host key from $image" >&2
    return 1
  fi
  tmp=$(mktemp)
  [[ -f "$KNOWN_HOSTS_FILE" ]] && { grep -v "^\[localhost\]:$port " "$KNOWN_HOSTS_FILE" || true; } >"$tmp"
  printf '[localhost]:%s %s\n' "$port" "$key" >>"$tmp"
  install -m 600 "$tmp" "$KNOWN_HOSTS_FILE"
  rm -f "$tmp"
  # Read the entry back rather than trusting install's exit code.
  recorded=$(ssh-keygen -F "[localhost]:$port" -f "$KNOWN_HOSTS_FILE" 2>/dev/null) || return 1
  [[ "$recorded" == *"$key"* ]]
}

build_personal() {
  local pubkey
  pubkey=$(docker_claude_pubkey)

  echo "Building $PERSONAL_IMAGE..."
  docker build \
    --build-arg "DOCKER_CLAUDE_PUBKEY=$pubkey" \
    -f "$SCRIPT_DIR/Dockerfile.personal" -t "$PERSONAL_IMAGE" "$SCRIPT_DIR"
}

build_work() {
  local pubkey
  pubkey=$(docker_claude_pubkey)

  echo "Building $WORK_IMAGE..."
  docker build \
    --build-arg "DOCKER_CLAUDE_PUBKEY=$pubkey" \
    -f "$SCRIPT_DIR/Dockerfile.work" -t "$WORK_IMAGE" "$SCRIPT_DIR"
}

if [[ "$REBUILD" == true ]]; then
  if [[ -n "$MODE" && "$(container_state "$CONTAINER")" == running ]]; then
    echo "Error: $CONTAINER is running; stop it first: docker-claude $MODE --stop" >&2
    exit 1
  fi
  build_base
  if [[ -z "$MODE" ]]; then
    mode_allowed personal && build_personal
    mode_allowed work && build_work
    exit 0
  fi
  "build_$MODE"
else
  if ! docker image inspect "$BASE_IMAGE" &>/dev/null; then
    build_base
  fi
  if [[ -n "$MODE" ]] && ! docker image inspect "$IMAGE" &>/dev/null; then
    "build_$MODE"
  fi
fi

if [[ -z "$MODE" ]]; then
  echo "Error: specify an account mode (personal | work)." >&2
  usage >&2
  exit 1
fi

# A dead agent otherwise surfaces only later, as a failed signature inside the container.
agent_preflight() {
  local rc=0
  if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
    echo "Error: SSH_AUTH_SOCK is not set — no ssh-agent to forward into the container." >&2
    exit 1
  fi
  ssh-add -l >/dev/null 2>&1 || rc=$?
  case $rc in
  0) ;;
  1) echo "Warning: the ssh-agent at $SSH_AUTH_SOCK holds no keys; signing in the container fails until keys are loaded." >&2 ;;
  *)
    echo "Error: no ssh-agent reachable at $SSH_AUTH_SOCK (ssh-add -l rc=$rc)." >&2
    echo "On a remote host, reconnect with the RemoteForward config (docker/claude/README.md, Remote server)." >&2
    exit 1
    ;;
  esac
}
agent_preflight

if ! START_TIMEOUT="$(host_conf docker_claude.start_timeout)" || [[ ! "$START_TIMEOUT" =~ ^[0-9]+$ ]]; then
  echo "Error: docker_claude.start_timeout (whole seconds) missing or invalid in $HOST_CONF." >&2
  exit 1
fi
PERSIST="$(host_conf docker_claude.persist)" || PERSIST=false

# The container's sshd is the readiness signal: it starts only after the entrypoint's setup.
wait_for_sshd() {
  local deadline=$((SECONDS + START_TIMEOUT))
  until ssh -a -o BatchMode=yes -o ConnectTimeout=2 "$SSH_ALIAS" true 2>/dev/null; do
    if [[ "$(container_state "$CONTAINER")" != running ]]; then
      echo "Error: $CONTAINER exited during startup; last log lines:" >&2
      docker logs --tail 30 "$CONTAINER" >&2 || true
      return 1
    fi
    if ((SECONDS >= deadline)); then
      echo "Error: $CONTAINER's sshd did not answer within ${START_TIMEOUT}s (docker_claude.start_timeout)." >&2
      return 1
    fi
    sleep 1
  done
}

STARTED=false
stop_started_container() {
  [[ "$STARTED" == true ]] && docker rm -f "$CONTAINER" >/dev/null 2>&1
  return 0
}

start_container() {
  local -a run_args=() secret_names=() secret_values=()
  case "$MODE" in
  personal)
    local token gh
    token=$(keychain_require anthropic personal "personal Anthropic OAuth token" \
      "Generate a setup token from an authenticated Claude Code instance:
  claude setup-token")
    gh=$(keychain_optional gh personal "gh token for 'personal' account" \
      "In-container 'gh' CLI will be unauthenticated.")
    secret_names=(claude_code_oauth_token gh_token)
    secret_values=("$token" "$gh")
    run_args=(--memory=8g --cpus=4
      -v claude-personal-repos:/workspace
      -v claude-fish-data-personal:/home/dev/.local/share/fish
      -v claude-tmux-data-personal:/home/dev/.local/share/tmux)
    # The host's real state dir, so the in-container agent reads runs live rather than a copy.
    # Workflow config stays unmounted: the agent edits it in its own /workspace/dot clone.
    [[ -d "$HOME/.local/state/faber" ]] && run_args+=(-v "$HOME/.local/state/faber":/home/dev/.local/state/faber)
    # Aggregates only: no session/account labels; the per-run instance id stops concurrent
    # containers' counters colliding. Opt out: DOCKER_CLAUDE_NO_TELEMETRY=1. See plans/.
    if [[ -z "${DOCKER_CLAUDE_NO_TELEMETRY:-}" ]]; then
      run_args+=(
        -e CLAUDE_CODE_ENABLE_TELEMETRY=1
        -e OTEL_METRICS_EXPORTER=otlp
        -e OTEL_EXPORTER_OTLP_PROTOCOL=grpc
        -e OTEL_EXPORTER_OTLP_ENDPOINT="${DOCKER_CLAUDE_OTEL_ENDPOINT:-http://host.docker.internal:4317}"
        -e OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
        -e OTEL_RESOURCE_ATTRIBUTES="account=personal,surface=dcp,service.instance.id=$(uuidgen | tr '[:upper:]' '[:lower:]')"
        -e OTEL_METRICS_INCLUDE_SESSION_ID=false
        -e OTEL_METRICS_INCLUDE_ACCOUNT_UUID=false
        -e OTEL_METRICS_INCLUDE_VERSION=false
      )
      # Linux: host.docker.internal is Docker-Desktop-only; map the host gateway.
      [[ "$(uname)" != "Darwin" ]] && run_args+=(--add-host=host.docker.internal:host-gateway)
    fi
    ;;
  work)
    if ! command -v jbcentral &>/dev/null; then
      echo "Error: jbcentral CLI not found. Install it first." >&2
      exit 1
    fi
    local key port base_url gh
    key=$(central proxy start --ensure-updated --return-key)
    if [[ -z "$key" ]]; then
      echo "Error: failed to start wire proxy or get key." >&2
      exit 1
    fi
    port=$(central config 2>&1 | awk '/Proxy port:/{print $3}')
    # The base URL embeds the jbcentral key, so it travels as a secret, never as -e.
    base_url="http://host.docker.internal:${port}/wire/${key}/claude-code/anthropic"
    gh=$(keychain_optional gh work "gh token for 'work' account" \
      "In-container 'gh' CLI will be unauthenticated.")
    secret_names=(anthropic_base_url gh_token)
    secret_values=("$base_url" "$gh")
    run_args=(--memory=16g --cpus=8
      -e JETBRAINS_MCP_STREAM_URL=http://host.docker.internal:64342/stream
      -e ANTHROPIC_API_KEY=jbcentral-proxy
      -v claude-work-repos:/workspace
      -v claude-fish-data-work:/home/dev/.local/share/fish
      -v claude-tmux-data-work:/home/dev/.local/share/tmux)
    ;;
  esac

  sync_container_host_key "$IMAGE" "$PORT"
  # A stopped leftover would block the fixed name.
  [[ -n "$(container_state "$CONTAINER")" ]] && docker rm -f "$CONTAINER" >/dev/null
  docker run -d --name "$CONTAINER" \
    --tmpfs "/run/secrets:uid=$(id -u),gid=$(id -g),mode=0700" \
    -p "127.0.0.1:$PORT:$PORT" \
    "${run_args[@]}" \
    "$IMAGE" >/dev/null
  STARTED=true
  if [[ "$PERSIST" != true ]]; then
    trap stop_started_container EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
  fi

  local i
  for i in "${!secret_names[@]}"; do
    inject_secret "$CONTAINER" "${secret_names[$i]}" "${secret_values[$i]}"
  done
}

if [[ "$(container_state "$CONTAINER")" == running ]]; then
  echo "docker-claude: $CONTAINER is already running; opening another session." >&2
else
  start_container
fi
wait_for_sshd

rc=0
ssh -A -t "$SSH_ALIAS" || rc=$?
exit $rc
