#!/usr/bin/env bash
set -euo pipefail

BASE_IMAGE="claude-dev-base"
PERSONAL_IMAGE="claude-dev-personal"
WORK_IMAGE="claude-dev-work"
MODE=""
REBUILD=false
NO_CACHE=false
AGENT_MODE=false
PORTITOR_OP=false
PORTITOR_VERB=up
PORTITOR_INIT_REPO=""
PORTITOR_INIT_CONFIG=""

usage() {
    cat <<'EOF'
docker-claude — single entrypoint for the containerized Claude workflows.

  Interactive cockpit (personal/work) + the autonomous agent runners (dca/dce) +
  the shared portitor proxy. dca/dce/warm are payloads dispatched by this command.

usage:
  docker-claude personal [-a] [-r | --no-cache] [--workspace <path>]
  docker-claude work | direct [-r | --no-cache]
  docker-claude dca  <args…>          # one-shot autonomous agent task
  docker-claude dce  <args…>          # whole-epic orchestration
  docker-claude warm <args…>          # warm the offline Go module cache
  docker-claude portitor init --repo <path> [--config-dir <path>]
  docker-claude portitor [up | down | status | restart]

commands:
  personal           personal account, Anthropic OAuth token from the keychain
  work               work account via the wire proxy (needs the `wire` CLI)
  direct             work account with a direct API key from the keychain
  dca | dce | warm   run the agent payloads — see `docker-claude dca --help`, etc.
  portitor <verb>    lifecycle of the shared portitor + egress proxy stack
                     (init | up | down | status | restart). `up` needs a GitHub
                     token: env GH_TOKEN or keychain service=portitor account=default
                     (override: PORTITOR_KEYCHAIN_ACCOUNT). `init` persists the
                     portitor host paths to ~/.config/docker-claude/portitor.env.

options (interactive commands):
  -a, --agent        personal only: forward an ephemeral no-touch SSH signing agent
                     (commits are signed; the key cannot auth)
  -r, --rebuild      rebuild the image(s) before running
  --no-cache         rebuild with no Docker cache (implies --rebuild)
  --workspace <path> host dir to mount as the workspace (default: ~/Work, ~/work on macOS)
  -h, --help         show this help

aliases: dc=docker-claude, dcp=personal, dcw=work, dcwd=direct, dca, dce, dcwarm.

examples:
  docker-claude portitor up          # bring up the shared proxy (dca/dce need it)
  docker-claude personal --agent     # interactive personal session w/ signing agent
  docker-claude dca --repo my-svc --skill implement --bead @123 --dry-run
EOF
}

# Resolve our own real path (needed before the shared lib is sourced), locate the
# off-PATH payload dir, and load the shared lib (keychain + signing + dot_root).
resolve_path() {
    local p="$1" target
    while [ -L "$p" ]; do
        target="$(readlink "$p")"
        case "$target" in
            /*) p="$target" ;;
            *)  p="$(cd "$(dirname "$p")" && pwd)/$target" ;;
        esac
    done
    printf '%s\n' "$p"
}
LIBEXEC="$(dirname "$(resolve_path "$0")")/../libexec/docker-claude"
source "$LIBEXEC/agent-common.sh"

# Subcommand dispatch — the public interface. Agent payloads exec out to their own
# scripts (one process, no overhead); interactive + portitor commands map onto the
# flag parser below for back-compat.
case "${1:-}" in
    dca)      shift; exec "$LIBEXEC/dca" "$@" ;;
    dce)      shift; exec "$LIBEXEC/dce" "$@" ;;
    warm)     shift; exec "$LIBEXEC/dca-warm" "$@" ;;
    personal) shift; set -- --personal "$@" ;;
    work)     shift; set -- --work "$@" ;;
    direct)   shift; set -- --direct "$@" ;;
    portitor) shift; set -- --portitor "$@" ;;
    help)     usage; exit 0 ;;
esac

# Parse flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -p|--personal)
            MODE="personal"
            shift
            ;;
        -w|--work)
            MODE="work"
            shift
            ;;
        --direct)
            MODE="direct"
            shift
            ;;
        -r|--rebuild)
            REBUILD=true
            shift
            ;;
        --no-cache)
            NO_CACHE=true
            REBUILD=true
            shift
            ;;
        -a|--agent)
            AGENT_MODE=true
            shift
            ;;
        --portitor)
            # Lifecycle of the shared portitor proxy stack (declarative, compose).
            # `init` persists the host paths; the rest map to docker compose.
            PORTITOR_OP=true
            shift
            if [[ "${1:-}" =~ ^(up|down|status|restart|init)$ ]]; then PORTITOR_VERB="$1"; shift; fi
            if [[ "$PORTITOR_VERB" == init ]]; then
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --repo)       PORTITOR_INIT_REPO="$2"; shift 2 ;;
                        --config-dir) PORTITOR_INIT_CONFIG="$2"; shift 2 ;;
                        *) break ;;
                    esac
                done
            fi
            ;;
        --workspace)
            WORKSPACE="$2"
            shift 2
            ;;
        *)
            echo "Unknown flag: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# Build images if missing or rebuild requested. (resolve_path + agent-common.sh are
# loaded at the top, before subcommand dispatch.)
SCRIPT_DIR="$(dot_root "$(dirname "$(resolve_path "$0")")")/docker/claude"
# Bake the dot branch you're currently on so a rebuild tests your working branch, not main.
# The branch must be pushed; Docker caches the clone layer, so re-test a re-pushed branch
# of the same name with --no-cache.
DOT_REF="$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
BUILD_ARGS=(--build-arg HOST_UID="$(id -u)" --build-arg DOT_REF="$DOT_REF")

# Persisted portitor host paths, written by `--portitor init`. Sourced by the
# lifecycle so `up`/`restart` need no env var; each line self-guards with :- so a
# shell-set PORTITOR_REPO/PORTITOR_CONFIG_DIR still wins per invocation.
PORTITOR_CONF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/docker-claude/portitor.env"

# portitor_init: persist the portitor host paths to PORTITOR_CONF_FILE. --repo is
# required (the repo built into the `portitor` image); --config-dir is optional
# (the /etc/portitor host dir), defaulting to the keys-dir location. Writes a
# self-guarding env file; does not touch docker.
portitor_init() {
    local repo="$PORTITOR_INIT_REPO" config="$PORTITOR_INIT_CONFIG"
    [[ -n "$repo" ]] || { echo "docker-claude --portitor init: --repo <path> is required" >&2; return 1; }
    repo="$(cd "$repo" 2>/dev/null && pwd)" \
        || { echo "docker-claude --portitor init: repo path not found: $PORTITOR_INIT_REPO" >&2; return 1; }
    [[ -f "$repo/Dockerfile" ]] || echo "docker-claude --portitor init: warning: no Dockerfile in $repo (\`--portitor up\` will fail to build the image)" >&2
    # Default + absolutize the config dir (it may not exist yet, so don't require cd).
    local keys_dir="${DCA_KEYS_DIR:-$HOME/.dca-keys}"
    config="${config:-$keys_dir/portitor-config}"
    [[ "$config" = /* ]] || config="$PWD/$config"
    mkdir -p "$(dirname "$PORTITOR_CONF_FILE")"
    cat >"$PORTITOR_CONF_FILE" <<EOF
# docker-claude portitor config — written by \`docker-claude --portitor init\`.
# Each line self-guards with :- so a shell-set env still overrides per invocation.
export PORTITOR_REPO="\${PORTITOR_REPO:-$repo}"
export PORTITOR_CONFIG_DIR="\${PORTITOR_CONFIG_DIR:-$config}"
EOF
    echo "docker-claude --portitor init: wrote $PORTITOR_CONF_FILE"
    echo "  PORTITOR_REPO=$repo"
    echo "  PORTITOR_CONFIG_DIR=$config"
}

# portitor_lifecycle: bring the shared proxy stack up/down via docker compose.
# Self-contained (inline keychain read) so it runs before the container helpers.
# up: build the portitor + egress images if missing, gather GH_TOKEN (env or
# keychain service=portitor) + the role public keys + the config dir, then
# `docker compose up -d`. down/status/restart map to compose. The portitor-repos
# volume persists, so up after down needs no re-mirror.
portitor_lifecycle() {
    local verb="$1" compose="$SCRIPT_DIR/docker-compose.yml"
    local keys_dir="${DCA_KEYS_DIR:-$HOME/.dca-keys}"
    # Pick up the persisted paths (repo + config dir) before defaulting below.
    # Precedence: shell env > persisted file > built-in default (all use :-).
    [[ -f "$PORTITOR_CONF_FILE" ]] && source "$PORTITOR_CONF_FILE"
    # Export the env compose interpolates — for EVERY verb, so down/status parse.
    export PORTITOR_CONFIG_DIR="${PORTITOR_CONFIG_DIR:-$keys_dir/portitor-config}"
    local auth="" f
    for f in "$keys_dir"/*.pub; do [[ -f "$f" ]] && auth+="$(awk '{print $1, $2}' "$f")"$'\n'; done
    export AGENT_AUTHORIZED_KEY="$auth"
    if [[ -z "${GH_TOKEN:-}" ]]; then
        local acct="${PORTITOR_KEYCHAIN_ACCOUNT:-default}"
        if [[ "$(uname)" == "Darwin" ]]; then
            GH_TOKEN="$(security find-generic-password -s portitor -a "$acct" -w 2>/dev/null || true)"
        else
            GH_TOKEN="$(secret-tool lookup service portitor account "$acct" 2>/dev/null || true)"
        fi
    fi
    export GH_TOKEN="${GH_TOKEN:-}"
    case "$verb" in
        status) docker compose -f "$compose" ps; return $? ;;
        down)   docker compose -f "$compose" down; return $? ;;
    esac
    # up / restart need the token + the images.
    [[ -n "$GH_TOKEN" ]] || { echo "docker-claude --portitor: no GH_TOKEN (set it or store keychain service=portitor account=${PORTITOR_KEYCHAIN_ACCOUNT:-default})" >&2; return 1; }
    local portitor_repo="${PORTITOR_REPO:-$HOME/Work/portitor}"
    docker image inspect portitor &>/dev/null || docker build -t portitor "$portitor_repo"
    docker image inspect dca-egress-proxy &>/dev/null || docker build -t dca-egress-proxy "$SCRIPT_DIR/egress"
    [[ "$verb" == "restart" ]] && docker compose -f "$compose" down
    docker compose -f "$compose" up -d
}

if [[ "$PORTITOR_OP" == true ]]; then
    if [[ "$PORTITOR_VERB" == init ]]; then
        portitor_init
        exit $?
    fi
    portitor_lifecycle "$PORTITOR_VERB"
    exit $?
fi

build_base() {
    echo "Building $BASE_IMAGE..."
    if [[ "$NO_CACHE" == true ]]; then
        docker build --no-cache "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
    else
        docker build "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
    fi
}

build_personal() {
    echo "Building $PERSONAL_IMAGE..."
    docker build -f "$SCRIPT_DIR/Dockerfile.personal" -t "$PERSONAL_IMAGE" "$SCRIPT_DIR"
}

build_work() {
    # Generate dedicated SSH key for IDEA Remote Development if missing
    local key_path="$HOME/.ssh/docker_claude_id_ed25519"
    if [[ ! -f "$key_path" ]]; then
        echo "Generating SSH key for Docker Claude IDEA access..."
        ssh-keygen -t ed25519 -f "$key_path" -N "" -C "docker-claude"
    fi
    local pubkey
    pubkey=$(cat "$key_path.pub")

    echo "Building $WORK_IMAGE..."
    docker build \
        --build-arg "DOCKER_CLAUDE_PUBKEY=$pubkey" \
        -f "$SCRIPT_DIR/Dockerfile.work" -t "$WORK_IMAGE" "$SCRIPT_DIR"
}

if [[ "$REBUILD" == true ]]; then
    build_base
    if [[ -z "$MODE" ]]; then
        build_personal
        build_work
        exit 0
    fi
    [[ "$MODE" == "personal" ]] && build_personal
    [[ "$MODE" == "work" || "$MODE" == "direct" ]] && build_work
else
    if ! docker image inspect "$BASE_IMAGE" &>/dev/null; then
        build_base
    fi
    if [[ "$MODE" == "personal" ]] && ! docker image inspect "$PERSONAL_IMAGE" &>/dev/null; then
        build_personal
    fi
    if [[ "$MODE" == "work" || "$MODE" == "direct" ]] && ! docker image inspect "$WORK_IMAGE" &>/dev/null; then
        build_work
    fi
fi

if [[ -z "$MODE" ]]; then
    echo "Error: specify an account mode (-p | -w | --direct), or --portitor." >&2
    usage >&2
    exit 1
fi

# Platform-specific default workspace
if [[ -z "${WORKSPACE:-}" ]]; then
    if [[ "$(uname)" == "Darwin" ]]; then
        WORKSPACE="$HOME/work"
    else
        WORKSPACE="$HOME/Work"
    fi
fi


# Register the gh PAT (if stored for $1) as a /run/secrets/gh_token mount. The
# in-container `gh` CLI reads GH_TOKEN from the env (set by the entrypoint from that
# file) — stateless (no hosts.yml) and NOT visible in `docker inspect`/host `ps`.
resolve_gh_args() {
    local label="$1" token
    token=$(keychain_optional gh "$label" "gh token for '$label' account" \
"In-container 'gh' CLI will be unauthenticated.
  macOS: security add-generic-password -s gh -a $label -w '<PAT>'
  Linux: secret-tool store --label='gh $label' service gh account $label")
    add_secret_mount gh_token "$token"
}

# Persistent volumes for fish history and tmux resurrect (targeted mounts
# so image-baked binaries like claude and nvim plugins aren't shadowed)
# SSH agent forwarding
SSH_AGENT_ARGS=(-v "$SSH_AUTH_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent)
# Docker Desktop (macOS) mounts sockets as root:root — need group access
if [[ "$(uname)" == "Darwin" ]]; then
    SSH_AGENT_ARGS+=(--group-add 0)
fi

if [[ "$MODE" == "personal" ]]; then
    TOKEN=$(keychain_require anthropic personal "personal Anthropic OAuth token" \
"Generate a setup token from an authenticated Claude Code instance:
  claude setup-token
Then store it:
  macOS: security add-generic-password -s anthropic -a personal -w '<token>'
  Linux: secret-tool store --label='anthropic' service anthropic account personal")
    PERSONAL_REPO_VOLUME="claude-personal-repos"
    resolve_gh_args personal
    add_secret_mount claude_code_oauth_token "$TOKEN"

    if [[ "$AGENT_MODE" == true ]]; then
        # Agent mode: forward an ephemeral no-touch signing-only agent. Transport
        # uses GH_TOKEN over HTTPS (see entrypoint), so the key signs but can't auth.
        start_personal_signing_agent
        PERSONAL_AGENT_ARGS=(-v "$SIGN_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent -e AGENT_MODE=1)
        if [[ "$(uname)" == "Darwin" ]]; then
            PERSONAL_AGENT_ARGS+=(--group-add 0)
        fi
        # NOT exec: control returns here on container exit so the trap tears down the
        # signing agent and cleanup_secrets shreds the mounted token files.
        docker run -it --rm \
            --memory=8g --cpus=4 \
            -v "$PERSONAL_REPO_VOLUME":/workspace \
            -v "$FISH_DATA_VOLUME":/home/dev/.local/share/fish \
            -v "$TMUX_DATA_VOLUME":/home/dev/.local/share/tmux \
            "${PERSONAL_AGENT_ARGS[@]}" \
            ${SECRET_ARGS[@]+"${SECRET_ARGS[@]}"} \
            "$PERSONAL_IMAGE"
        cleanup_secrets
        exit 0
    fi

    # NOT exec (was): keep the parent alive so cleanup_secrets runs after the session.
    docker run -it --rm \
        --memory=8g --cpus=4 \
        -v "$PERSONAL_REPO_VOLUME":/workspace \
        -v claude-fish-data-personal:/home/dev/.local/share/fish \
        -v claude-tmux-data-personal:/home/dev/.local/share/tmux \
        "${SSH_AGENT_ARGS[@]}" \
        ${SECRET_ARGS[@]+"${SECRET_ARGS[@]}"} \
        "$PERSONAL_IMAGE"
    rc=$?; cleanup_secrets; exit $rc
fi

# Common work args (shared between wire and direct modes)
WORK_REPO_VOLUME="claude-work-repos"
WORK_COMMON_ARGS=(
    -it --rm
    --memory=8g --cpus=4
    -e JETBRAINS_MCP_STREAM_URL=http://host.docker.internal:64342/stream
    -v "$WORK_REPO_VOLUME":/workspace
    -v claude-fish-data-work:/home/dev/.local/share/fish
    -v claude-tmux-data-work:/home/dev/.local/share/tmux
    "${SSH_AGENT_ARGS[@]}"
    -p 2222:2222
)

if [[ "$MODE" == "work" ]]; then
    # Wire proxy mode (default work mode)
    if ! command -v wire &>/dev/null; then
        echo "Error: wire CLI not found. Install it first."
        exit 1
    fi
    WIRE_KEY=$(wire proxy start --ensure-updated --return-key)
    if [[ -z "$WIRE_KEY" ]]; then
        echo "Error: failed to start wire proxy or get key."
        exit 1
    fi
    WIRE_PORT=$(wire config 2>&1 | awk '/Proxy port:/{print $3}')
    WIRE_BASE_URL="http://host.docker.internal:${WIRE_PORT}/wire/${WIRE_KEY}/claude-code/anthropic"
    resolve_gh_args work
    # The base URL embeds the wire key — mount it as a secret (not -e / not logged).
    add_secret_mount anthropic_base_url "$WIRE_BASE_URL"

    docker run \
        "${WORK_COMMON_ARGS[@]}" \
        -e ANTHROPIC_API_KEY=wire-proxy \
        ${SECRET_ARGS[@]+"${SECRET_ARGS[@]}"} \
        "$WORK_IMAGE"
    rc=$?; cleanup_secrets; exit $rc
fi

if [[ "$MODE" == "direct" ]]; then
    # Direct API key mode (from OS keychain)
    KEY=$(keychain_require "Claude Code" "" "work Claude Code API key" \
"Log into Claude Code with your work account first (claude login).
The key is stored automatically in the OS keychain.")
    resolve_gh_args work
    add_secret_mount anthropic_api_key "$KEY"

    docker run \
        "${WORK_COMMON_ARGS[@]}" \
        ${SECRET_ARGS[@]+"${SECRET_ARGS[@]}"} \
        "$WORK_IMAGE"
    rc=$?; cleanup_secrets; exit $rc
fi
