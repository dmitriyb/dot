#!/usr/bin/env bash
set -euo pipefail

BASE_IMAGE="claude-dev-base"
PERSONAL_IMAGE="claude-dev-personal"
WORK_IMAGE="claude-dev-work"
MODE=""
REBUILD=false
NO_CACHE=false
AGENT_MODE=false

usage() {
  cat <<'EOF'
docker-claude — single entrypoint for the containerized Claude cockpit.

  Isolated personal/work Claude Code containers with your dotfiles, SSH agent
  forwarding, and separate personal/work images.

usage:
  docker-claude personal [-a] [-r | --no-cache]
  docker-claude work [-r | --no-cache]

commands:
  personal           personal account, Anthropic OAuth token from the keychain
  work               work account via the wire proxy (needs the `jbcentral` CLI)

options:
  -a, --agent        personal only: forward an ephemeral no-touch SSH signing agent
                     (commits are signed; the key cannot auth)
  -r, --rebuild      rebuild the image(s) before running
  --no-cache         rebuild with no Docker cache (implies --rebuild)
  -h, --help         show this help

aliases: dc=docker-claude, dcp=personal, dcw=work.

examples:
  docker-claude personal --agent     # interactive personal session w/ signing agent
  docker-claude work                 # work account via the wire proxy
EOF
}

# Resolve our own real path (needed before the shared lib is sourced), then load
# the shared lib (keychain + signing + dot_root) from the sibling libexec dir.
resolve_path() {
  local p="$1" target
  while [ -L "$p" ]; do
    target="$(readlink "$p")"
    case "$target" in
    /*) p="$target" ;;
    *) p="$(cd "$(dirname "$p")" && pwd)/$target" ;;
    esac
  done
  printf '%s\n' "$p"
}
LIBEXEC="$(dirname "$(resolve_path "$0")")/../libexec/docker-claude"
source "$LIBEXEC/agent-common.sh"

# Subcommand dispatch — the public interface. The account subcommands map onto the
# flag parser below for back-compat.
case "${1:-}" in
personal)
  shift
  set -- --personal "$@"
  ;;
work)
  shift
  set -- --work "$@"
  ;;
help)
  usage
  exit 0
  ;;
esac

# Parse flags
while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  -p | --personal)
    MODE="personal"
    shift
    ;;
  -w | --work)
    MODE="work"
    shift
    ;;
  -r | --rebuild)
    REBUILD=true
    shift
    ;;
  --no-cache)
    NO_CACHE=true
    REBUILD=true
    shift
    ;;
  -a | --agent)
    AGENT_MODE=true
    shift
    ;;
  *)
    echo "Unknown flag: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
done

# Build images if missing or rebuild requested. (resolve_path + agent-common.sh are
# loaded at the top, before subcommand dispatch.)
SCRIPT_DIR="$(dot_root "$(dirname "$(resolve_path "$0")")")/docker/claude"
# Bake the dot branch you're currently on so a rebuild tests your working branch, not main.
# The branch must be pushed; Docker caches the clone layer, so re-test a re-pushed branch
# of the same name with --no-cache.
DOT_REF="$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
BUILD_ARGS=(--build-arg HOST_UID="$(id -u)" --build-arg DOT_REF="$DOT_REF")

build_base() {
  echo "Building $BASE_IMAGE..."
  if [[ "$NO_CACHE" == true ]]; then
    docker build --no-cache "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
  else
    docker build "${BUILD_ARGS[@]}" -f "$SCRIPT_DIR/Dockerfile.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
  fi
}

# Echo the host's dedicated Remote-Development pubkey, generating the keypair once
# if missing. Shared by work AND personal — one host identity opens both containers
# (isolation is per-container/per-port, not per-key).
docker_claude_pubkey() {
  local key_path="$HOME/.ssh/docker_claude_id_ed25519"
  if [[ ! -f "$key_path" ]]; then
    echo "Generating SSH key for Docker Claude Remote Development access..." >&2
    ssh-keygen -t ed25519 -f "$key_path" -N "" -C "docker-claude" >&2
  fi
  cat "$key_path.pub"
}

build_personal() {
  local pubkey
  pubkey=$(docker_claude_pubkey)

  echo "Building $PERSONAL_IMAGE..."
  docker build \
    --build-arg "DOCKER_CLAUDE_PUBKEY=$pubkey" \
    -f "$SCRIPT_DIR/Dockerfile.personal" -t "$PERSONAL_IMAGE" "$SCRIPT_DIR"
}

build_work() {
  local pubkey
  pubkey=$(docker_claude_pubkey)

  echo "Building $WORK_IMAGE..."
  docker build \
    --build-arg "DOCKER_CLAUDE_PUBKEY=$pubkey" \
    -f "$SCRIPT_DIR/Dockerfile.work" -t "$WORK_IMAGE" "$SCRIPT_DIR"
}

if [[ "$REBUILD" == true ]]; then
  build_base
  if [[ -z "$MODE" ]]; then
    build_personal
    build_work
    exit 0
  fi
  [[ "$MODE" == "personal" ]] && build_personal
  [[ "$MODE" == "work" ]] && build_work
else
  if ! docker image inspect "$BASE_IMAGE" &>/dev/null; then
    build_base
  fi
  if [[ "$MODE" == "personal" ]] && ! docker image inspect "$PERSONAL_IMAGE" &>/dev/null; then
    build_personal
  fi
  if [[ "$MODE" == "work" ]] && ! docker image inspect "$WORK_IMAGE" &>/dev/null; then
    build_work
  fi
fi

if [[ -z "$MODE" ]]; then
  echo "Error: specify an account mode (-p | -w)." >&2
  usage >&2
  exit 1
fi

# Register the gh PAT (if stored for $1) as a /run/secrets/gh_token mount. The
# in-container `gh` CLI reads GH_TOKEN from the env (set by the entrypoint from that
# file) — stateless (no hosts.yml) and NOT visible in `docker inspect`/host `ps`.
resolve_gh_args() {
  local label="$1" token
  token=$(keychain_optional gh "$label" "gh token for '$label' account" \
    "In-container 'gh' CLI will be unauthenticated.
  macOS: security add-generic-password -s gh -a $label -w '<PAT>'
  Linux: secret-tool store --label='gh $label' service gh account $label")
  add_secret_mount gh_token "$token"
}

# Persistent volumes for fish history and tmux resurrect (targeted mounts
# so image-baked binaries like claude and nvim plugins aren't shadowed)
# SSH agent forwarding
SSH_AGENT_ARGS=(-v "$SSH_AUTH_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent)
# Docker Desktop (macOS) mounts sockets as root:root — need group access
if [[ "$(uname)" == "Darwin" ]]; then
  SSH_AGENT_ARGS+=(--group-add 0)
fi

if [[ "$MODE" == "personal" ]]; then
  TOKEN=$(keychain_require anthropic personal "personal Anthropic OAuth token" \
    "Generate a setup token from an authenticated Claude Code instance:
  claude setup-token
Then store it:
  macOS: security add-generic-password -s anthropic -a personal -w '<token>'
  Linux: secret-tool store --label='anthropic' service anthropic account personal")
  PERSONAL_REPO_VOLUME="claude-personal-repos"
  resolve_gh_args personal
  add_secret_mount claude_code_oauth_token "$TOKEN"

  # Personal usage telemetry -> the per-workstation edge collector (otel-edge,
  # localhost:4317 on the host), which buffers and forwards to the home
  # collector. Aggregates only: session/account labels disabled; the per-run
  # service.instance.id UUID keeps concurrent containers' cumulative counters
  # from colliding (dashboards sum() over it). Opt out per run with
  # DOCKER_CLAUDE_NO_TELEMETRY=1. See plans/claude-usage-otel-aggregation.md.
  PERSONAL_OTEL_ARGS=()
  if [[ -z "${DOCKER_CLAUDE_NO_TELEMETRY:-}" ]]; then
    PERSONAL_OTEL_ARGS=(
      -e CLAUDE_CODE_ENABLE_TELEMETRY=1
      -e OTEL_METRICS_EXPORTER=otlp
      -e OTEL_EXPORTER_OTLP_PROTOCOL=grpc
      -e OTEL_EXPORTER_OTLP_ENDPOINT="${DOCKER_CLAUDE_OTEL_ENDPOINT:-http://host.docker.internal:4317}"
      -e OTEL_RESOURCE_ATTRIBUTES="account=personal,surface=dcp,service.instance.id=$(uuidgen | tr '[:upper:]' '[:lower:]')"
      -e OTEL_METRICS_INCLUDE_SESSION_ID=false
      -e OTEL_METRICS_INCLUDE_ACCOUNT_UUID=false
      -e OTEL_METRICS_INCLUDE_VERSION=false
    )
    # Linux: host.docker.internal is Docker-Desktop-only; map the host gateway.
    [[ "$(uname)" != "Darwin" ]] && PERSONAL_OTEL_ARGS+=(--add-host=host.docker.internal:host-gateway)
  fi

  if [[ "$AGENT_MODE" == true ]]; then
    # Agent mode: forward an ephemeral no-touch signing-only agent. Transport
    # uses GH_TOKEN over HTTPS (see entrypoint), so the key signs but can't auth.
    start_personal_signing_agent
    PERSONAL_AGENT_ARGS=(-v "$SIGN_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent -e AGENT_MODE=1)
    if [[ "$(uname)" == "Darwin" ]]; then
      PERSONAL_AGENT_ARGS+=(--group-add 0)
    fi
    # NOT exec: control returns here on container exit so the trap tears down the
    # signing agent and cleanup_secrets shreds the mounted token files.
    docker run -it --rm \
      --memory=8g --cpus=4 \
      -v "$PERSONAL_REPO_VOLUME":/workspace \
      -v "$FISH_DATA_VOLUME":/home/dev/.local/share/fish \
      -v "$TMUX_DATA_VOLUME":/home/dev/.local/share/tmux \
      "${PERSONAL_AGENT_ARGS[@]}" \
      ${PERSONAL_OTEL_ARGS[@]+"${PERSONAL_OTEL_ARGS[@]}"} \
      ${SECRET_ARGS[@]+"${SECRET_ARGS[@]}"} \
      "$PERSONAL_IMAGE"
    cleanup_secrets
    exit 0
  fi

  # NOT exec (was): keep the parent alive so cleanup_secrets runs after the session.
  # -p on 127.0.0.1 only: sshd for IDE Remote Development, reachable from this host
  # but not the LAN (work uses 2222; personal uses 2223 so both can run at once).
  docker run -it --rm \
    --memory=8g --cpus=4 \
    -v "$PERSONAL_REPO_VOLUME":/workspace \
    -v claude-fish-data-personal:/home/dev/.local/share/fish \
    -v claude-tmux-data-personal:/home/dev/.local/share/tmux \
    "${SSH_AGENT_ARGS[@]}" \
    -p 127.0.0.1:2223:2223 \
    ${PERSONAL_OTEL_ARGS[@]+"${PERSONAL_OTEL_ARGS[@]}"} \
    ${SECRET_ARGS[@]+"${SECRET_ARGS[@]}"} \
    "$PERSONAL_IMAGE"
  rc=$?
  cleanup_secrets
  exit $rc
fi

# Common work args (wire mode)
WORK_REPO_VOLUME="claude-work-repos"
WORK_COMMON_ARGS=(
  -it --rm
  --memory=8g --cpus=4
  -e JETBRAINS_MCP_STREAM_URL=http://host.docker.internal:64342/stream
  -v "$WORK_REPO_VOLUME":/workspace
  -v claude-fish-data-work:/home/dev/.local/share/fish
  -v claude-tmux-data-work:/home/dev/.local/share/tmux
  "${SSH_AGENT_ARGS[@]}"
  -p 2222:2222
)

if [[ "$MODE" == "work" ]]; then
  # jbcentral proxy mode (default work mode)
  if ! command -v jbcentral &>/dev/null; then
    echo "Error: jbcentral CLI not found. Install it first."
    exit 1
  fi
  JBCENTRAL_KEY=$(central proxy start --ensure-updated --return-key)
  if [[ -z "$JBCENTRAL_KEY" ]]; then
    echo "Error: failed to start wire proxy or get key."
    exit 1
  fi
  JBCENTRAL_PORT=$(central config 2>&1 | awk '/Proxy port:/{print $3}')
  JBCENTRAL_BASE_URL="http://host.docker.internal:${JBCENTRAL_PORT}/wire/${JBCENTRAL_KEY}/claude-code/anthropic"
  resolve_gh_args work
  # The base URL embeds the jbcentral key — mount it as a secret (not -e / not logged).
  add_secret_mount anthropic_base_url "$JBCENTRAL_BASE_URL"

  docker run \
    "${WORK_COMMON_ARGS[@]}" \
    -e ANTHROPIC_API_KEY=jbcentral-proxy \
    ${SECRET_ARGS[@]+"${SECRET_ARGS[@]}"} \
    "$WORK_IMAGE"
  rc=$?
  cleanup_secrets
  exit $rc
fi

