#!/usr/bin/env bash
# dca-warm — populate the offline Go module-cache volume for a repo.
#
# This is the ONLINE step (full internet), run on the host OUTSIDE the egress lock.
# Afterwards `dca` (stack=go) builds/tests with GOPROXY=off against this volume, so
# the locked run never touches a module proxy (which would be an exfil channel).
# A bead that needs a NEW dep fails the locked run loudly -> re-run dca-warm.
#
#   dca-warm --repo <name> [--stack go] [--owner <gh-owner>]
set -euo pipefail
source "$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)/agent-common.sh"
die() { echo "dca-warm: $*" >&2; exit 1; }

REPO="" STACK=go OWNER="${DCA_GH_OWNER:-dmitriyb}"
while [[ $# -gt 0 ]]; do
	case "$1" in
		--repo | --repository) REPO="$2"; shift 2 ;;
		--stack) STACK="$2"; shift 2 ;;
		--owner) OWNER="$2"; shift 2 ;;
		-h | --help) echo "usage: dca-warm --repo <name> [--stack go] [--owner <gh-owner>]" >&2; exit 0 ;;
		*) die "unknown flag: $1" ;;
	esac
done
[[ -n "$REPO" ]] || die "--repo is required"
[[ "$STACK" == go ]] || die "only the go stack has a module cache (got '$STACK')"

VOL="${DCA_GOMODCACHE_VOL:-dca-gomodcache}"
IMAGE="claude-dev-agent-$STACK"
docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image $IMAGE not built yet (run a dca build first)"
docker volume create "$VOL" >/dev/null
# Fresh volumes are root-owned; the agent runs as the dev user (HOST_UID). chown
# once so both the warm and the locked dca runs can read/write the cache.
docker run --rm --user 0 -v "$VOL":/gomodcache "$IMAGE" \
	chown -R "$(id -u):$(id -g)" /gomodcache

# The PAT is used ON THE HOST only (to clone the private repo for its go.mod) and
# is NEVER passed into a container — same invariant as the agent run. go mod
# download needs no GitHub auth (modules come from the public proxy); the token is
# only to read the repo's go.mod/go.sum. So we clone on the host and hand the
# warm container the SOURCE, not a credential.
TOKEN=$(keychain_require portitor "${PORTITOR_KEYCHAIN_ACCOUNT:-dca-sandbox}" "GitHub PAT (host-side clone only)" \
	"store it: secret-tool store --label=portitor service portitor account <account>")

SRC=$(mktemp -d); trap 'rm -rf "$SRC"' EXIT
echo "dca-warm: cloning $OWNER/$REPO on the host (token stays on the host)…"
git clone --depth 1 "https://x-access-token:${TOKEN}@github.com/${OWNER}/${REPO}.git" "$SRC/r" 2>&1 | tail -1
[ -f "$SRC/r/go.mod" ] || die "no go.mod in $OWNER/$REPO"

echo "dca-warm: warming $VOL (online go mod download — NO token in the container)…"
docker run --rm -v "$VOL":/gomodcache -e GOMODCACHE=/gomodcache -v "$SRC/r":/r:ro \
	"$IMAGE" bash -lc '
		set -e
		cp -r /r /tmp/b && cd /tmp/b
		go mod download all
		echo "dca-warm: cached $(ls /gomodcache/cache/download 2>/dev/null | wc -l) module domains"
	'
echo "dca-warm: done — dca (stack=go) now builds offline against volume $VOL."
