#!/usr/bin/env bash
# start-cleanup <bead-id> [--dry-run]
#
# Deterministic prelude for the `cleanup` skill, run OUTSIDE the agent: sync,
# guard the cleanup bead (require spex:cleanup, predecessor closed), branch off
# the default, claim the bead, and write the agent's bundle. Shared logic lives
# in prelude-common.sh.
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/prelude-common.sh"

prelude_parse_args cleanup "$@"
preflight

json=$(br show "$ID" --json)
[ "$(jq 'length' <<<"$json")" -gt 0 ] || die "bead $ID not found"

# A cleanup bead must carry spex:cleanup; otherwise it is an implement bead.
jq -e '.[0].labels | index("spex:cleanup")' <<<"$json" >/dev/null \
	|| die "bead $ID is not a cleanup bead (no spex:cleanup label) — use start-implement $ID"

status=$(jq -r '.[0].status' <<<"$json")
case "$status" in
	open | ready) ;;
	*) die "bead $ID status is '$status', expected open or ready" ;;
esac

# The blocks: dependency names the predecessor whose code is being removed; it
# must already be closed (its work has shipped) before cleanup runs.
pred=$(jq -r '.[0].dependencies[]? | select(.dependency_type == "blocks") | .id' <<<"$json" | head -n1)
[ -n "$pred" ] || die "cleanup bead $ID has no blocks: dependency identifying the predecessor"

pjson=$(br show "$pred" --json)
pstatus=$(jq -r '.[0].status' <<<"$pjson")
ptitle=$(jq -r '.[0].title' <<<"$pjson")
[ "$pstatus" = closed ] || die "predecessor $pred status is '$pstatus', expected closed before cleanup"

title=$(jq -r '.[0].title' <<<"$json")
branch="cleanup/$(printf '%s' "$ptitle" | slugify)"

land cleanup "$branch" "origin/$(default_branch)" "$ID" "$title" "$pred" "" ""
