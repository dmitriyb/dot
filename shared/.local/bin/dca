#!/usr/bin/env bash
# dca — autonomous one-shot Claude agent runner (NEW architecture; plan §7a).
#
# Distinct from docker-claude (the interactive cockpit): headless, lean per-stack
# image, GitHub + landing only through portitor, one role signing key + a portitor
# push key, egress locked. Runs ONE execution-skill task per container, then exits.
#
#   dca --repo <name> --skill <implement|cleanup> --bead <id>
#       [--stack go] [--effort low|medium|high] [-r|--rebuild] [--no-cache] [--dry-run]
#
# Scope of THIS slice (Phase 4 slice 2): image select/build, Anthropic token,
# role signing agent, and assembling the container launch + the dca->container
# env contract. Parts owned by later slices are parameterized and marked TODO:
#   - the in-container flow (entrypoint `dca-run`) ............ slice 3
#   - egress lock (network restricted to portitor + Anthropic)  slice 4
#   - portitor push key + known_hosts, per-role key selection .. slice 8
set -euo pipefail

source "$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)/agent-common.sh"

usage() {
	cat >&2 <<EOF
dca — autonomous one-shot Claude agent runner (headless, egress-locked).

Runs ONE execution-skill task in an isolated container, then exits. Builds its
own lean per-stack image on demand (claude-dev-agent-base + claude-dev-agent-<stack>).
For a whole epic use \`dce\`; for the interactive cockpit use \`docker-claude\`.

usage:
  dca --repo <name> --skill <implement|cleanup> --bead <id>
  dca --repo <name> --skill <fix|review>        --pr <n>
  dca --repo <name> --skill <implement-epic>    --epic <id>            (via dce)
  dca --repo <name> --skill <review-epic|fix-epic> --epic <id> --pr <n>
      [--stack go] [--effort low|medium|high] [-r|--rebuild] [--no-cache] [--dry-run]

skills (role in parentheses; determines the signing key + authority):
  implement, cleanup   (implementer)  need --bead
  fix                  (implementer)  needs --pr
  review               (reviewer)     needs --pr   — closes beads on a clean pass
  implement-epic       (implementer)  needs --epic
  fix-epic             (implementer)  need --epic --pr
  review-epic          (reviewer)     need --epic --pr

flags:
  --repo <name>        target repository (required)
  --skill <skill>      one of the skills above (required)
  --bead/--pr/--epic   the task target (per skill, above)
  --stack <name>       toolchain layer; needs docker/claude/Dockerfile.agent.<name>
                       (default: go — the only stack with an offline cache today)
  --effort <level>     low | medium | high (default: medium)
  -r, --rebuild        rebuild the base + stack images before running
  --no-cache           rebuild with no Docker cache (implies --rebuild)
  --dry-run            preview only — no build, no keychain, no key touch
  -h, --help           show this help

prerequisite: the shared proxy must be up — \`docker-claude --portitor up\`.
go stack: pre-warm the offline module cache first — \`dca-warm --repo <name>\`.

env knobs:
  DCA_KEYS_DIR              dir of sandbox role keys (default: ~/.dca-keys)
  DCA_GIT_NAME/DCA_GIT_EMAIL  committer identity (default: host git config)
  DCA_GOMODCACHE_VOL        go module-cache volume (default: dca-gomodcache)
  PORTITOR_KEYCHAIN_ACCOUNT keychain account for the portitor PAT (default: default)
  DCA_NETWORK / DCA_EGRESS_PROXY  internal net + egress proxy names
EOF
}
die() { echo "dca: $*" >&2; exit 1; }

REPO="" SKILL="" BEAD="" PR="" EPIC="" STACK="go" EFFORT="medium"
REBUILD=false NO_CACHE=false DRY_RUN=false
while [[ $# -gt 0 ]]; do
	case "$1" in
		--repo | --repository) REPO="$2"; shift 2 ;;
		--skill) SKILL="$2"; shift 2 ;;
		--bead) BEAD="$2"; shift 2 ;;
		--pr) PR="$2"; shift 2 ;;
		--epic) EPIC="$2"; shift 2 ;;
		--stack) STACK="$2"; shift 2 ;;
		--effort) EFFORT="$2"; shift 2 ;;
		-r | --rebuild) REBUILD=true; shift ;;
		--no-cache) NO_CACHE=true; REBUILD=true; shift ;;
		--dry-run) DRY_RUN=true; shift ;;
		-h | --help) usage; exit 0 ;;
		*) echo "dca: unknown flag: $1" >&2; usage; exit 2 ;;
	esac
done

[[ -n "$REPO" ]] || die "--repo is required"
[[ -n "$SKILL" ]] || die "--skill is required"
case "$SKILL" in
	implement | cleanup) [[ -n "$BEAD" ]] || die "--bead is required for $SKILL" ;;
	fix | review) [[ -n "$PR" ]] || die "--pr is required for $SKILL" ;;
	implement-epic) [[ -n "$EPIC" ]] || die "--epic is required for $SKILL" ;;
	review-epic | fix-epic) [[ -n "$EPIC" && -n "$PR" ]] || die "--epic and --pr are required for $SKILL" ;;
	*) die "unknown skill '$SKILL'" ;;
esac

# ---- role identity (one no-touch key per role, forwarded as an ssh-agent) ----
role_for_skill() {
	case "$1" in
		implement | cleanup | fix | implement-epic | fix-epic) echo implementer ;; # commit feature work; never close beads
		review | review-epic) echo reviewer ;;                                      # review verdict + bead close
	esac
}
ROLE="$(role_for_skill "$SKILL")"
DCA_KEYS_DIR="${DCA_KEYS_DIR:-$HOME/.dca-keys}"
ROLE_KEY="$DCA_KEYS_DIR/$ROLE" # sandbox file key; falls back to the resident YubiKey key

# Committer identity for the agent's commits. Defaults to the host git identity
# (the responsible account); override (e.g. a dedicated bot) via DCA_GIT_NAME/EMAIL.
# For a GitHub "Verified" badge, this email must be on a GitHub account that has
# the role key registered as a Signing key (the role determines authority via the
# fingerprint regardless; this only affects GitHub's display).
GIT_NAME="${DCA_GIT_NAME:-$(git config user.name 2>/dev/null || true)}"
GIT_EMAIL="${DCA_GIT_EMAIL:-$(git config user.email 2>/dev/null || true)}"

# ---- images: lean base + per-stack layer ----
SCRIPT_DIR="$(cd "$(dirname "$(resolve_path "$0")")" && cd ../../.. && pwd)/docker/claude"
DOT_REF="$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
DOT_SHA="$(git -C "$SCRIPT_DIR" rev-parse HEAD 2>/dev/null || echo dev)" # cache-bust the image's dot clone
BASE_IMAGE="claude-dev-agent-base"
STACK_IMAGE="claude-dev-agent-$STACK"
[[ -f "$SCRIPT_DIR/Dockerfile.agent.$STACK" ]] || die "no stack image for '$STACK' (expected docker/claude/Dockerfile.agent.$STACK)"

# ---- portitor + network knobs (finalized in later slices) ----
PORTITOR_HOST="${PORTITOR_HOST:-portitor}"      # portitor's name on the internal network
DCA_NETWORK="${DCA_NETWORK:-dca-net}"           # --internal net: agent reaches ONLY portitor + the egress proxy
EGRESS_PROXY="${DCA_EGRESS_PROXY:-dca-egress}"  # allow-listing forward proxy (Anthropic only)

# Host result dir, mounted into the container at /dca-result. The in-container
# skill writes result.json here (PR number, review verdict, flagged beads); the
# dce orchestrator reads it on the host between phases. Caller (dce) sets
# DCA_RESULT_DIR to a known path; a standalone dca run gets a temp dir.
RESULT_HOST="${DCA_RESULT_DIR:-$(mktemp -d "${TMPDIR:-/tmp}/dca-result.XXXXXX")}"
mkdir -p "$RESULT_HOST"

# dca -> container contract (consumed by the `dca-run` entrypoint).
# Common args; the Anthropic token and signing socket are added on a real run.
RUN_ARGS=(
	--rm
	--memory=8g --cpus=4
	--network "$DCA_NETWORK"
	-e DCA_SKILL="$SKILL"
	-e DCA_ROLE="$ROLE"
	-e DCA_BEAD="$BEAD"
	-e DCA_PR="$PR"
	-e DCA_EPIC="$EPIC"
	-e DCA_REPO="$REPO"
	-e DCA_EFFORT="$EFFORT"
	-v "$RESULT_HOST":/dca-result
	-e DCA_RESULT_DIR=/dca-result
	-e DCA_GIT_NAME="$GIT_NAME"
	-e DCA_GIT_EMAIL="$GIT_EMAIL"
	-e PORTITOR_HOST="$PORTITOR_HOST"
	-e HTTPS_PROXY="http://$EGRESS_PROXY:8888"
	-e HTTP_PROXY="http://$EGRESS_PROXY:8888"
	-e NO_PROXY="$PORTITOR_HOST,localhost,127.0.0.1"
)

# Offline Go module cache: the egress lock stays (no module proxy — that would be
# an exfil channel). The agent builds/tests from a pre-warmed volume with
# GOPROXY=off; a missing dep fails the run loudly -> re-run `dca-warm --repo <name>`.
GOMODCACHE_VOL="${DCA_GOMODCACHE_VOL:-dca-gomodcache}"
if [[ "$STACK" == go ]]; then
	RUN_ARGS+=(
		-v "$GOMODCACHE_VOL":/gomodcache
		-e GOMODCACHE=/gomodcache
		-e GOPROXY=off
		-e GOSUMDB=off
	)
fi

# Side-effect-free preview: no build, no keychain, no key touch.
if [[ "$DRY_RUN" == true ]]; then
	echo "dca (dry-run): skill=$SKILL role=$ROLE bead=${BEAD:-–} pr=${PR:-–} epic=${EPIC:-–} repo=$REPO stack=$STACK"
	echo "  result dir: $RESULT_HOST (container /dca-result)"
	echo "  image:   $STACK_IMAGE  (base $BASE_IMAGE, DOT_REF=$DOT_REF)"
	echo "  network: $DCA_NETWORK (internal)   portitor: $PORTITOR_HOST   egress: $EGRESS_PROXY → api.anthropic.com only"
	echo "  role key: $ROLE_KEY$( [[ -f "$ROLE_KEY" ]] && echo ' (file)' || echo ' (missing → resident YubiKey)')"
	echo "  docker run ${RUN_ARGS[*]} \\"
	echo "    -e CLAUDE_CODE_OAUTH_TOKEN=<keychain anthropic/personal> \\"
	echo "    -v <signing-agent-sock>:/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent \\"
	echo "    $STACK_IMAGE dca-run"
	echo "  remaining: portitor deployment — gh/GH_TOKEN + authorized_keys wrap (slice 8 portitor side)"
	exit 0
fi

# ---- real run ----
# Fail fast if the shared proxy isn't up + reachable, rather than dying later at
# clone. Start it with: docker-claude --portitor up
preflight_portitor() {
	docker ps --format '{{.Names}}' | grep -qx "$PORTITOR_HOST" \
		|| die "portitor ('$PORTITOR_HOST') is not running — start it: docker-claude --portitor up"
	docker network inspect "$DCA_NETWORK" >/dev/null 2>&1 \
		|| die "network '$DCA_NETWORK' not found — start the proxy: docker-claude --portitor up"
}
preflight_portitor

build_base() {
	echo "dca: building $BASE_IMAGE (DOT_REF=$DOT_REF)..."
	local cache=(); [[ "$NO_CACHE" == true ]] && cache=(--no-cache)
	docker build "${cache[@]}" \
		--build-arg HOST_UID="$(id -u)" --build-arg DOT_REF="$DOT_REF" --build-arg DOT_SHA="$DOT_SHA" \
		-f "$SCRIPT_DIR/Dockerfile.agent.base" -t "$BASE_IMAGE" "$SCRIPT_DIR"
}
build_stack() {
	echo "dca: building $STACK_IMAGE..."
	docker build --build-arg AGENT_BASE="$BASE_IMAGE" \
		-f "$SCRIPT_DIR/Dockerfile.agent.$STACK" -t "$STACK_IMAGE" "$SCRIPT_DIR"
}
# ensure_egress: an --internal network (agent gets no direct internet) + the
# allow-listing egress proxy attached to both that network and a bridge, so the
# agent's only outbound path is Anthropic. Idempotent.
ensure_egress() {
	docker network inspect "$DCA_NETWORK" >/dev/null 2>&1 \
		|| docker network create --internal "$DCA_NETWORK" >/dev/null
	if ! docker ps --format '{{.Names}}' | grep -qx "$EGRESS_PROXY"; then
		echo "dca: starting egress proxy ($EGRESS_PROXY, Anthropic-only)..."
		docker image inspect dca-egress-proxy >/dev/null 2>&1 \
			|| docker build -t dca-egress-proxy "$SCRIPT_DIR/egress"
		docker rm -f "$EGRESS_PROXY" >/dev/null 2>&1 || true
		docker run -d --name "$EGRESS_PROXY" --restart unless-stopped dca-egress-proxy >/dev/null
		docker network connect "$DCA_NETWORK" "$EGRESS_PROXY"
	fi
}
if [[ "$REBUILD" == true ]]; then
	build_base; build_stack
else
	docker image inspect "$BASE_IMAGE" &>/dev/null || build_base
	docker image inspect "$STACK_IMAGE" &>/dev/null || build_stack
fi

TOKEN=$(keychain_require anthropic personal "personal Anthropic OAuth token" \
"Generate one from an authenticated Claude Code instance: claude setup-token
  Linux: secret-tool store --label='anthropic' service anthropic account personal
  macOS: security add-generic-password -s anthropic -a personal -w '<token>'")
RUN_ARGS+=(-e CLAUDE_CODE_OAUTH_TOKEN="$TOKEN")

# Forward the role's no-touch key as a single-key agent. Sandbox: a file key in
# $DCA_KEYS_DIR; production: the resident YubiKey key. Same key signs the commits
# AND authenticates SSH to portitor (one fingerprint -> one role).
if [[ -f "$ROLE_KEY" ]]; then
	start_file_agent "$ROLE_KEY"
	RUN_ARGS+=(-e DCA_SIGNING_KEY="$(awk '{print $1, $2}' "$ROLE_KEY.pub")")
else
	start_signing_agent "$ROLE" # this role's resident no-touch key only (PIN at launch)
fi
SIGN_ARGS=(-v "$SIGN_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent)
[[ "$(uname)" == "Darwin" ]] && SIGN_ARGS+=(--group-add 0)

# Internal network + egress proxy so the agent can reach only portitor + Anthropic.
ensure_egress

docker run "${RUN_ARGS[@]}" "${SIGN_ARGS[@]}" "$STACK_IMAGE" dca-run
echo "dca: result dir: $RESULT_HOST"
