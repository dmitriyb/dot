#!/usr/bin/env bash
# dca-run — in-container entrypoint for one autonomous dca task (Phase 4 slice 3).
#
# Consumes the env contract `dca` sets, runs the full one-shot flow, then exits:
#   1. clone the repo FROM portitor (the mirror; no upstream credential here)
#   2. idempotent beads rebuild
#   3. start-<skill> <bead>  → deterministic prelude + bundle on a feature branch
#   4. headless claude with the skill (/<skill>) + the bundle as context; the
#      agent works, commits, pushes to portitor, and self-corrects in-session
#   5. outcome: portitor accepted the branch (+ auto-PR) → done; else save the
#      session/state to the handoff volume and exit for manual resume
#
# Guardrails are managed-settings (deny bypass, un-overridable) + portitor (the
# hard gate), so the headless agent runs without permission prompts.
#
# Live dependencies (portitor reachable + push key/known_hosts) land in slices
# 4/8 + deployment; this script is the flow and is marked where it needs them.
set -euo pipefail

: "${DCA_SKILL:?dca-run: DCA_SKILL not set}"
: "${DCA_REPO:?dca-run: DCA_REPO not set}"
# Input is a bead id (implement/cleanup), a PR number (review/fix), or an epic id
# (+ a PR for the review/fix epic phases).
case "$DCA_SKILL" in
	implement | cleanup) : "${DCA_BEAD:?dca-run: DCA_BEAD not set}"; INPUT="$DCA_BEAD" ;;
	review | fix) : "${DCA_PR:?dca-run: DCA_PR not set}"; INPUT="$DCA_PR" ;;
	implement-epic) : "${DCA_EPIC:?dca-run: DCA_EPIC not set}"; INPUT="$DCA_EPIC" ;;
	review-epic | fix-epic) : "${DCA_EPIC:?dca-run: DCA_EPIC not set}"; : "${DCA_PR:?dca-run: DCA_PR not set}"; INPUT="$DCA_EPIC#$DCA_PR" ;;
	*) echo "dca-run: unknown skill $DCA_SKILL" >&2; exit 2 ;;
esac
EFFORT="${DCA_EFFORT:-medium}"
PORTITOR_HOST="${PORTITOR_HOST:-portitor}"

# Load mounted secrets into the env: /run/secrets/<lowercase_var> → <UPPERCASE_VAR>
# (e.g. claude_code_oauth_token → CLAUDE_CODE_OAUTH_TOKEN). Keeps tokens out of the
# container's Config.Env; dca mounts them read-only instead of passing -e.
if [ -d /run/secrets ]; then
	for _sf in /run/secrets/*; do
		[ -f "$_sf" ] || continue
		export "$(basename "$_sf" | tr '[:lower:]' '[:upper:]')=$(cat "$_sf")"
	done
	unset _sf
fi
export HARNESS_DIR="${HARNESS_DIR:-${XDG_RUNTIME_DIR:-/tmp}/harness}"
WORKDIR="${DCA_WORKDIR:-/workspace/$DCA_REPO}"
STATE_DIR="${DCA_STATE_DIR:-/workspace/.dca-state}" # TODO(slice 8): mount as a volume so handoff survives container exit

log() { echo "dca-run: $*" >&2; }

# fail_handoff: preserve what's needed to resume interactively, then exit non-zero.
fail_handoff() {
	log "FAILED: $*"
	mkdir -p "$STATE_DIR"
	[ -d "$HARNESS_DIR" ] && cp -a "$HARNESS_DIR" "$STATE_DIR/harness" 2>/dev/null || true
	{ echo "skill=$DCA_SKILL"; echo "input=${INPUT:-}"; echo "repo=$DCA_REPO"; echo "workdir=$WORKDIR"; echo "reason=$*"; } > "$STATE_DIR/handoff.txt" 2>/dev/null || true
	log "state saved to $STATE_DIR — resume manually in the container"
	exit 1
}

# SSH to portitor uses the forwarded agent key. Pin the host key if provided
# (production: fail closed). Trust-on-first-use is allowed ONLY when the sandbox
# explicitly opts in (DCA_ALLOW_HOSTKEY_TOFU=1, set by dca for file-key runs) —
# otherwise a missing host key aborts rather than silently accepting any server.
mkdir -p "$HOME/.ssh"
if [ -n "${DCA_PORTITOR_HOSTKEY:-}" ]; then
	printf '%s\n' "$DCA_PORTITOR_HOSTKEY" >>"$HOME/.ssh/known_hosts"
	export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$HOME/.ssh/known_hosts"
elif [ "${DCA_ALLOW_HOSTKEY_TOFU:-0}" = 1 ]; then
	echo "dca-run: WARNING: DCA_PORTITOR_HOSTKEY unset — using accept-new (sandbox TOFU)" >&2
	export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new"
else
	fail_handoff "no portitor host key (DCA_PORTITOR_HOSTKEY unset). Pin it, or set DCA_ALLOW_HOSTKEY_TOFU=1 for an explicit sandbox run."
fi

# 1. Clone from portitor's mirror (the only git remote the agent can reach).
ORIGIN="ssh://git@${PORTITOR_HOST}/srv/git/${DCA_REPO}.git"
log "cloning $ORIGIN"
git clone "$ORIGIN" "$WORKDIR" || fail_handoff "clone from portitor failed"
cd "$WORKDIR"

# Sign commits with the role's forwarded agent key (no touch): user.signingkey is
# the public key; the private key lives only in the forwarded agent. The file-key
# path passes the pubkey in DCA_SIGNING_KEY; the resident-YubiKey path forwards the
# agent but passes nothing, so read the pubkey straight from the agent — same as the
# personal container's agent mode (entrypoint.personal.fish). This drives BOTH the
# signing config AND the committer identity below, so a resident run isn't left
# unsigned or identity-less.
if [ -z "${DCA_SIGNING_KEY:-}" ]; then
	DCA_SIGNING_KEY="$(ssh-add -L 2>/dev/null | head -n1 | awk '{print $1, $2}')"
fi
if [ -n "${DCA_SIGNING_KEY:-}" ]; then
	git config gpg.format ssh
	git config user.signingkey "key::$DCA_SIGNING_KEY"
	git config commit.gpgsign true
	git config user.name "${DCA_GIT_NAME:-dca-${DCA_ROLE:-agent}}"
	git config user.email "${DCA_GIT_EMAIL:-dca-${DCA_ROLE:-agent}@portitor.local}"
fi

# 2. Idempotent beads rebuild (start-* preflight also does this; explicit on boot).
beads-rebuild "$WORKDIR" || true

# 3. Deterministic prelude → bundle. implement/cleanup branch+claim off a bead;
#    review/fix check out the PR branch; the epic phases use start-epic (one branch
#    for the whole epic, beads stay open). start-<skill> handles the difference.
case "$DCA_SKILL" in
	implement-epic)
		log "prelude: start-epic $DCA_EPIC"
		start-epic "$DCA_EPIC" || fail_handoff "prelude (start-epic) failed" ;;
	review-epic | fix-epic)
		log "prelude: start-epic $DCA_EPIC --pr $DCA_PR"
		start-epic "$DCA_EPIC" --pr "$DCA_PR" || fail_handoff "prelude (start-epic --pr) failed" ;;
	*)
		log "prelude: start-$DCA_SKILL $INPUT"
		"start-$DCA_SKILL" "$INPUT" || fail_handoff "prelude (start-$DCA_SKILL) failed" ;;
esac

[ -f "$HARNESS_DIR/CONTEXT.md" ] || fail_handoff "prelude produced no bundle"
BRANCH="$(sed -n 's/^BRANCH=//p' "$HARNESS_DIR/bundle.env")"

# 4. Headless agent run. /<skill> activates the skill; the bundle is the context.
#    bypassPermissions: no prompts (managed-settings + portitor are the guardrails).
PROMPT="/$DCA_SKILL"$'\n\n'"$(cat "$HARNESS_DIR/CONTEXT.md")"
# Optional adversarial/extra instruction (dca --instruction). Appended verbatim so the
# agent attempts it; the gate still judges the result (used to demo/test rejections).
if [ -n "${DCA_EXTRA_INSTRUCTION:-}" ]; then
	PROMPT="$PROMPT"$'\n\n'"ADDITIONAL INSTRUCTION: $DCA_EXTRA_INSTRUCTION"
	log "extra instruction: $DCA_EXTRA_INSTRUCTION"
fi
log "running claude (effort=$EFFORT, branch=$BRANCH)"
claude -p "$PROMPT" \
	--effort "$EFFORT" \
	--permission-mode bypassPermissions \
	${DCA_MAX_BUDGET_USD:+--max-budget-usd "$DCA_MAX_BUDGET_USD"} \
	|| fail_handoff "agent run errored"

# 4b. Ensure a result.json exists for the dce orchestrator, even if the skill
#     didn't write one (the epic skills write the authoritative one with PR/verdict).
if [ -n "${DCA_RESULT_DIR:-}" ] && [ ! -f "$DCA_RESULT_DIR/result.json" ]; then
	printf '{"skill":"%s","epic":"%s","pr":"%s","branch":"%s","status":"done"}\n' \
		"$DCA_SKILL" "${DCA_EPIC:-}" "${DCA_PR:-}" "$BRANCH" >"$DCA_RESULT_DIR/result.json" 2>/dev/null || true
fi

# 5. Outcome: the agent pushed during its run; portitor gates + auto-opens the PR.
#    Verify the branch was accepted on the proxy. TODO(slice 5/6): query portitor
#    for the receipt (PR #) and print it; TODO(slice 8): push needs the role/push
#    key + known_hosts for this to run live.
if git ls-remote --exit-code origin "refs/heads/$BRANCH" >/dev/null 2>&1; then
	log "DONE: $BRANCH accepted by portitor (PR receipt query = slice 5/6)"
else
	fail_handoff "branch $BRANCH not accepted by portitor (rejected or never pushed)"
fi
