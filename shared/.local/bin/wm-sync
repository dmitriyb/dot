#!/usr/bin/env python3
"""Render the workspace blocks in both window managers' configs from one source.

usage:
  wm-sync [--check] [--diff]

options:
  --check   exit 1 if any generated block is out of date; write nothing.
            Use in verification -- a clean tree means both WMs agree.
  --diff    print a unified diff of what would change, then write.

The single source of truth is shared/.config/wm/workspaces.toml. Every letter
workspace's chord, monitor role, auto-placement rule and comment is defined there once
and rendered into:

  arch/.config/omarchy/custom-hyprland.lua   the WORKSPACES table (Hyprland, Linux)
  mac/.config/aerospace/aerospace.toml       bindings, monitor assignment, app rules

Only the regions between `BEGIN generated:<name>` and `END generated:<name>` are
touched; everything hand-written around them is preserved byte for byte.

Why this exists: the same workspace identity used to be spelled out in both configs
with nothing tying them together, so they drifted -- macOS had nine auto-placement
rules while Linux had five. One knob now derives both, the way faber-stack derives
every object name from --instance.

Repo location is resolved from this script's own path (it is stowed to ~/.local/bin,
so the symlink leads back into the checkout) -- the same trick docker-claude uses to
find its libexec. Requires python3.11+ for tomllib, which is stdlib.
"""

from __future__ import annotations

import difflib
import os
import sys
import tomllib

SOURCE_REL = "shared/.config/wm/workspaces.toml"
HYPR_REL = "arch/.config/omarchy/custom-hyprland.lua"
AERO_REL = "mac/.config/aerospace/aerospace.toml"

EDIT_HINT = "edit shared/.config/wm/workspaces.toml, then run wm-sync"


def die(msg: str) -> None:
    print(f"wm-sync: {msg}", file=sys.stderr)
    sys.exit(1)


def repo_root() -> str:
    """dot/ checkout root, found by resolving this script back through its stow symlink."""
    # shared/.local/bin/wm-sync -> up 4 = repo root. realpath works on macOS too, where
    # `readlink -f` does not exist (the reason theme-set hand-rolls its own resolver).
    here = os.path.realpath(__file__)
    root = os.path.normpath(os.path.join(os.path.dirname(here), "..", "..", ".."))
    if not os.path.isfile(os.path.join(root, SOURCE_REL)):
        die(f"cannot locate {SOURCE_REL} from {here} (resolved root: {root})")
    return root


def load(path: str) -> tuple[list[dict], dict[str, str]]:
    with open(path, "rb") as fh:
        data = tomllib.load(fh)

    workspaces = data.get("workspace") or []
    monitors = data.get("monitors") or {}
    if not workspaces:
        die(f"{path} defines no [[workspace]] entries")

    seen: set[str] = set()
    for ws in workspaces:
        letter = ws.get("letter")
        if not letter or len(letter) != 1 or not letter.isalpha():
            die(f"bad or missing letter in {ws!r}")
        if letter in seen:
            die(f"duplicate letter {letter!r}")
        seen.add(letter)
        role = ws.get("role")
        if role not in monitors:
            die(f"workspace {letter}: role {role!r} has no [monitors] entry")
    return workspaces, monitors


def replace_block(text: str, name: str, body: list[str], comment: str) -> str:
    """Swap the lines between the BEGIN/END markers for `name`, keeping the markers."""
    begin = f"{comment} BEGIN generated:{name}"
    end = f"{comment} END generated:{name}"
    lines = text.splitlines()

    try:
        i = next(n for n, line in enumerate(lines) if line.strip().startswith(begin))
        j = next(n for n, line in enumerate(lines) if line.strip().startswith(end))
    except StopIteration:
        die(f"marker {begin!r} / {end!r} not found -- add it to the target file first")
    if j <= i:
        die(f"marker {end!r} precedes {begin!r}")

    # Rewrite the BEGIN line too, so the edit hint stays correct if it is ever reworded.
    head = lines[:i] + [f"{begin} -- {EDIT_HINT}"]
    return "\n".join(head + body + lines[j:]) + "\n"


def lua_workspaces(workspaces: list[dict]) -> list[str]:
    out = ["local WORKSPACES = {"]
    for ws in workspaces:
        parts = [f'letter = "{ws["letter"]}"', f'note = "{ws["note"]}"']
        classes = ws.get("linux") or []
        if classes:
            rendered = ", ".join(f"[[{c}]]" for c in classes)
            parts.append(f"classes = {{ {rendered} }}")
        out.append("  { " + ", ".join(parts) + " },")
    out.append("}")
    return out


def aero_monitors(workspaces: list[dict], monitors: dict[str, str]) -> list[str]:
    out = ["[workspace-to-monitor-force-assignment]"]
    width = max(len(monitors[ws["role"]]) for ws in workspaces) + 2
    for ws in workspaces:
        pattern = f"'{monitors[ws['role']]}'"
        out.append(f"{ws['letter']} = {pattern:<{width}} # {ws['note']}")
    return out


def aero_bindings(workspaces: list[dict]) -> list[str]:
    out = []
    for ws in workspaces:
        low = ws["letter"].lower()
        out.append(f"alt-{low} = 'workspace {ws['letter']}'  # {ws['note']}")
        # --focus-follows-window so `move` behaves like Hyprland's, which follows. Without
        # it the same chord moves the window on macOS but leaves focus behind on Linux.
        out.append(
            f"alt-shift-{low} = 'move-node-to-workspace {ws['letter']} --focus-follows-window'"
        )
    return out


def aero_window_rules(workspaces: list[dict]) -> list[str]:
    out = []
    for ws in workspaces:
        app = ws.get("mac")
        if not app:
            continue
        if out:
            out.append("")
        out.append("[[on-window-detected]]")
        out.append(f"if.app-id = '{app}'")
        out.append(f"run = 'move-node-to-workspace {ws['letter']}'  # {ws['note']}")
    return out


def main() -> int:
    args = set(sys.argv[1:])
    if args & {"-h", "--help"}:
        print(__doc__.strip())
        return 0
    check = "--check" in args
    show_diff = "--diff" in args
    if args - {"--check", "--diff"}:
        die(f"unknown option(s): {' '.join(sorted(args - {'--check', '--diff'}))}")

    root = repo_root()
    workspaces, monitors = load(os.path.join(root, SOURCE_REL))

    targets = {
        HYPR_REL: ("--", {"workspaces": lua_workspaces(workspaces)}),
        AERO_REL: (
            "#",
            {
                "monitors": aero_monitors(workspaces, monitors),
                "bindings": aero_bindings(workspaces),
                "window-rules": aero_window_rules(workspaces),
            },
        ),
    }

    stale = False
    for rel, (comment, blocks) in targets.items():
        path = os.path.join(root, rel)
        if not os.path.isfile(path):
            die(f"missing target {rel}")
        original = open(path, encoding="utf-8").read()

        updated = original
        for name, body in blocks.items():
            updated = replace_block(updated, name, body, comment)

        if updated == original:
            print(f"  ok       {rel}")
            continue

        stale = True
        if show_diff or check:
            sys.stdout.writelines(
                difflib.unified_diff(
                    original.splitlines(keepends=True),
                    updated.splitlines(keepends=True),
                    fromfile=f"a/{rel}",
                    tofile=f"b/{rel}",
                )
            )
        if check:
            print(f"  STALE    {rel}")
            continue
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(updated)
        print(f"  updated  {rel}")

    if check and stale:
        print("\nwm-sync --check: generated blocks are out of date", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
