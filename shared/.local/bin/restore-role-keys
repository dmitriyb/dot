#!/usr/bin/env bash
# restore-role-keys — re-materialize resident-key handles from the YubiKey with
# the no-touch policy they were CREATED with, for the keys you name.
#
# Why this exists: `ssh-keygen -K` downloads resident-key handles but stamps
# every one "user presence required" regardless of how the credential was
# created — a stock-OpenSSH limitation with no -O override on -K. The no-touch
# policy is a CLIENT-SIDE flag in the handle file (FIDO2 stores no
# per-credential UP policy; the client requests UP per assertion), so restoring
# it is a one-bit edit of the freshly downloaded file. The credential on the
# authenticator is never modified.
#
# Because clearing that bit makes a key sign without a touch, nothing is
# restored implicitly: every key is named on the command line, or picked from
# the list of what the authenticator holds.
#
# Usage: restore-role-keys [<application> ...]   e.g. restore-role-keys implementer reviewer merger
#        restore-role-keys                         list the resident keys and pick by index
# <application> is the key's FIDO application without the `ssh:` prefix.
# Needs: the YubiKey plugged in; asks PIN + one touch for the download.
# Writes: ~/.ssh/<downloaded handle name>{,.pub}, 0600/0644; existing files are
# overwritten (they are re-derivable from the authenticator at any time).
set -euo pipefail

usage() {
	cat >&2 <<'EOF2'
Usage: restore-role-keys [<application> ...]

Re-downloads the YubiKey's resident keys and restores the client-side no-touch
flag on the ones you choose (raw `ssh-keygen -K` stamps every handle
touch-required). A restored key signs WITHOUT a touch.

  restore-role-keys implementer reviewer merger   restore these (application ssh:<name>)
  restore-role-keys                               list what the key holds, pick by index

Needs the YubiKey plugged in; asks PIN + one touch. Writes the handles and their
.pub files to ~/.ssh (existing files overwritten).
EOF2
	exit "${1:-0}"
}
for a in "$@"; do
	case "$a" in
		-h | --help) usage 0 ;;
		-*) echo "restore-role-keys: unknown option: $a" >&2; usage 2 ;;
	esac
done
[[ $# -gt 0 || -t 0 ]] || { echo "restore-role-keys: name the keys to restore, or run it on a terminal to pick them" >&2; usage 2; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

echo "restore-role-keys: downloading resident keys (PIN + one touch)…" >&2
(cd "$tmp" && ssh-keygen -K -N "") >&2

# The handle format is OpenSSH's; one helper reads the application and rewrites
# the flags byte, so both sides agree on the layout.
handle() {
	python3 - "$@" <<'PY'
import base64, struct, sys, pathlib

def rd_s(b, o):
    n = struct.unpack('>I', b[o:o+4])[0]
    return b[o+4:o+4+n], o+4+n

def parse(path):
    b64 = ''.join(l for l in path.read_text().splitlines() if not l.startswith('----'))
    blob = bytearray(base64.b64decode(b64))
    off = len(b'openssh-key-v1\x00')
    for _ in range(3):                      # cipher, kdf, kdfopts
        _, off = rd_s(blob, off)
    off += 4                                # nkeys
    _, off = rd_s(blob, off)                # public blob
    o = off + 4 + 8                         # priv len + check ints
    keytype, o = rd_s(blob, o)
    if keytype == b'sk-ecdsa-sha2-nistp256@openssh.com':
        _, o = rd_s(blob, o)                # curve
    _, o = rd_s(blob, o)                    # public key
    app, o = rd_s(blob, o)
    return blob, app.decode(), o

mode, args = sys.argv[1], sys.argv[2:]
if mode == "list":
    for p in args:
        _, app, _ = parse(pathlib.Path(p))
        print(f"{p}\t{app}")
elif mode == "flags":
    blob, _, o = parse(pathlib.Path(args[0]))
    print(f"{blob[o]:02x}")
elif mode == "restore":
    src, dst = pathlib.Path(args[0]), pathlib.Path(args[1])
    blob, app, o = parse(src)
    if not blob[o] & 0x20:
        sys.exit(f"restore-role-keys: {app}: not a resident key (flags 0x{blob[o]:02x})")
    blob[o] &= ~0x01 & 0xff                 # clear user-presence-required, keep the rest
    enc = base64.b64encode(bytes(blob)).decode()
    body = '\n'.join(enc[i:i+70] for i in range(0, len(enc), 70))
    dst.write_text(f"-----BEGIN OPENSSH PRIVATE KEY-----\n{body}\n-----END OPENSSH PRIVATE KEY-----\n")
PY
}

shopt -s nullglob
files=()
for f in "$tmp"/id_*_sk_rk*; do [[ "$f" == *.pub ]] || files+=("$f"); done
[[ ${#files[@]} -gt 0 ]] || { echo "restore-role-keys: the authenticator holds no resident keys" >&2; exit 1; }
declare -a FILE APP FP
while IFS=$'\t' read -r f app; do
	FILE+=("$f"); APP+=("$app")
	FP+=("$(ssh-keygen -lf "$f.pub" | awk '{print $2}')")
done < <(handle list "${files[@]}")
listing() { for i in "${!FILE[@]}"; do printf '  %d  %-28s %s\n' "$((i + 1))" "${APP[$i]}" "${FP[$i]}" >&2; done; }

chosen=()
if [[ $# -gt 0 ]]; then
	for name in "$@"; do
		hit=""
		for i in "${!APP[@]}"; do [[ "${APP[$i]}" == "ssh:$name" ]] && hit="$i"; done
		[[ -n "$hit" ]] || { echo "restore-role-keys: no resident key with application ssh:$name; the authenticator holds:" >&2; listing; exit 1; }
		chosen+=("$hit")
	done
else
	echo "restore-role-keys: resident keys on the authenticator:" >&2
	listing
	echo "Indices to restore, space-separated (each will sign WITHOUT a touch); empty line to quit:" >&2
	read -r line || line=""
	[[ -n "${line// /}" ]] || { echo "restore-role-keys: nothing chosen" >&2; exit 0; }
	for n in $line; do
		[[ "$n" =~ ^[0-9]+$ && "$n" -ge 1 && "$n" -le ${#FILE[@]} ]] || { echo "restore-role-keys: '$n' is not an index from the list" >&2; exit 2; }
		chosen+=("$((n - 1))")
	done
fi

ssh_dir="$HOME/.ssh"
mkdir -p "$ssh_dir"; chmod 0700 "$ssh_dir"
restored=()
for i in "${chosen[@]}"; do
	dst="$ssh_dir/$(basename "${FILE[$i]}")"
	handle restore "${FILE[$i]}" "$dst"; chmod 0600 "$dst"
	cp "${FILE[$i]}.pub" "$dst.pub"; chmod 0644 "$dst.pub"
	# Re-read what was written: the handle still yields this key, and touch is off.
	[[ "$(ssh-keygen -y -f "$dst" | ssh-keygen -lf - | awk '{print $2}')" == "${FP[$i]}" ]] \
		|| { echo "restore-role-keys: $dst does not yield ${FP[$i]}" >&2; exit 1; }
	(( (16#$(handle flags "$dst") & 1) == 0 )) || { echo "restore-role-keys: $dst still requires a touch" >&2; exit 1; }
	echo "${APP[$i]}: installed $dst (${FP[$i]}, no-touch restored)" >&2
	restored+=("$dst")
done

echo "restore-role-keys: verify — each should print SIGN-OK with NO touch prompt:" >&2
for k in "${restored[@]}"; do
	ssh-agent sh -c 'ssh-add -q "$1" && echo x | ssh-keygen -Y sign -n test -f "$1.pub" - >/dev/null && echo "SIGN-OK $1"' sh "$k"
done
