#!/usr/bin/env bash
# start-epic <epic-id> [--pr <n>] [--dry-run]
#
# Deterministic prelude for WHOLE-EPIC mode (see plan), used by ALL phases:
#   - implement (no --pr): branch `epic/<id>` off origin/<default>, beads stay open.
#   - review/fix (--pr N): fetch the epic PR state (pr.json) + checkout its branch.
# In every phase it (re)builds the same deterministic context, token-free:
#   - resolve the epic's member beads (label `epic:<id>`),
#   - dependency-order them (toposort over in-epic deps; bvr metrics annotate),
#   - pre-bake EACH bead's spec slice (spex map context) into its own dir,
#   - assemble a thin epic map (goal + sibling one-liners + bvr highlights).
# Beads are NEVER claimed/closed here — the reviewer closes them in a batch at the
# end. Shared logic lives in prelude-common.sh.
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/prelude-common.sh"

EPIC="" PR="" DRY=0
while [ $# -gt 0 ]; do
	case "$1" in
		--dry-run | -n) DRY=1; shift ;;
		--pr) PR="${2:-}"; shift 2 ;;
		-*) die "unknown flag: $1" ;;
		*) EPIC="$1"; shift ;;
	esac
done
[ -n "$EPIC" ] || { echo "usage: start-epic <epic-id> [--pr N] [--dry-run]" >&2; exit 2; }
need git; need jq; need br
ID="$EPIC"
preflight

ALL=$(br list --json 2>/dev/null) || die "br list --json failed"
mapfile -t MEMBERS < <(epic_members "$ID")
[ "${#MEMBERS[@]}" -gt 0 ] || die "epic $ID has no members (label 'epic:$ID'). Tag them: br label add <bead> epic:$ID"

declare -A INSET=()
for m in "${MEMBERS[@]}"; do INSET[$m]=1; done

edges="$(mktemp)"; members_jsonl="$(mktemp)"
trap 'rm -f "$edges" "$members_jsonl"' EXIT
for m in "${MEMBERS[@]}"; do
	printf '%s\n' "$m" >>"$edges"
	while read -r d; do
		if [ -n "$d" ] && [ -n "${INSET[$d]:-}" ]; then printf '%s\t%s\n' "$m" "$d" >>"$edges"; fi
	done < <(epic_deps "$m")
done
mapfile -t ORDER < <(toposort <"$edges")

BVR_TRIAGE=""
command -v bvr >/dev/null 2>&1 && BVR_TRIAGE=$(bvr --robot-insights 2>/dev/null || true)

# ---- branch resolution per phase ---------------------------------------------
if [ -n "$PR" ]; then
	branch="" # resolved from pr.json after the bundle dir exists
else
	branch="epic/$(printf '%s' "$ID" | slugify)"; branch="${branch%-}"
fi

# ---- (re)build per-bead contexts in execution order --------------------------
rm -rf "$HARNESS_DIR"; mkdir -p "$HARNESS_DIR/beads"
: >"$HARNESS_DIR/order.txt"
i=0
for bead in "${ORDER[@]}"; do
	i=$((i + 1)); n=$(printf '%02d' "$i")
	bjson=$(jq -c --arg id "$bead" '(.issues // .) | .[] | select(.id==$id)' <<<"$ALL")
	title=$(jq -r '.title // ""' <<<"$bjson")
	record=$(jq -r '(.labels // [])[]? | select(startswith("spex:")) | select(.!="spex:cleanup") | ltrimstr("spex:")' <<<"$bjson" | head -n1)
	deps=$(epic_deps "$bead" | while read -r d; do if [ -n "${INSET[$d]:-}" ]; then echo "$d"; fi; done | paste -sd, -)
	specs=$(resolve_spec "$record")
	bd="$HARNESS_DIR/beads/$n-$bead"; mkdir -p "$bd"
	printf '%s\n' "$specs" | sed '/^$/d' >"$bd/spec-files.txt"
	{
		echo "BEAD_ID=$bead"; echo "ORDINAL=$i"; echo "TITLE=$title"
		[ -n "$record" ] && echo "RECORD_ID=$record"
		[ -n "$deps" ] && echo "DEPS=$deps"
	} >"$bd/meta.env"
	echo "$n-$bead" >>"$HARNESS_DIR/order.txt"
	jq -nc --arg id "$bead" --arg t "$title" --arg r "$record" --arg deps "$deps" --arg dir "beads/$n-$bead" --argjson ord "$i" \
		'{ordinal:$ord, id:$id, title:$t, dir:$dir, record:(if $r=="" then null else $r end),
		  deps:(if $deps=="" then [] else ($deps|split(",")) end)}' >>"$members_jsonl"
done

# ---- review/fix: fetch PR state + resolve the PR branch -----------------------
if [ -n "$PR" ]; then
	pr_fetch "$PR" >"$HARNESS_DIR/pr.json" || die "portitor pr fetch $PR failed"
	branch=$(jq -r '.headRefName // empty' "$HARNESS_DIR/pr.json")
	[ -n "$branch" ] || die "could not resolve PR #$PR head branch from pr.json"
fi

if [ -n "$PR" ]; then
	jq -s --arg epic "$ID" --arg branch "$branch" --argjson pr "$PR" \
		'{epic:$epic, branch:$branch, pr:$pr, count:length, order:.}' "$members_jsonl" >"$HARNESS_DIR/epic.json"
else
	jq -s --arg epic "$ID" --arg branch "$branch" \
		'{epic:$epic, branch:$branch, count:length, order:.}' "$members_jsonl" >"$HARNESS_DIR/epic.json"
fi

epic_title=$(jq -r --arg id "$ID" '(.issues // .) | .[] | select(.id==$id) | .title // ""' <<<"$ALL")
{
	echo "# Epic map — $ID"
	[ -n "$epic_title" ] && echo "Goal: $epic_title"
	echo
	echo "## Beads (execution order, deps respected)"
	jq -r '.order[] | "- \(.ordinal). \(.id) — \(.title)\(if (.deps|length)>0 then "  [deps: "+(.deps|join(", "))+"]" else "" end)  → \(.dir)/"' "$HARNESS_DIR/epic.json"
	if [ -n "$BVR_TRIAGE" ]; then
		echo; echo "## Graph highlights (bvr)"
		jq -r '{Keystones,Bottlenecks,CriticalPath,Cycles} | to_entries[] | select(.value!=null and (.value|length)>0) | "- \(.key): \(.value|tostring|.[0:160])"' <<<"$BVR_TRIAGE" 2>/dev/null | head -6 || true
	fi
} >"$HARNESS_DIR/epic-map.md"

{
	echo "SKILL=${DCA_SKILL:-implement-epic}"
	echo "EPIC_ID=$ID"
	echo "BRANCH=$branch"
	echo "COUNT=${#ORDER[@]}"
	[ -n "$PR" ] && echo "PR=$PR"
} >"$HARNESS_DIR/bundle.env"

{
	echo "# Epic bundle — $ID"
	echo
	echo "Epic \`$ID\` has **${#ORDER[@]} beads**, dependency-ordered + pre-baked. Branch: \`$branch\`${PR:+ (PR #$PR)}."
	echo "Follow your skill (/implement-epic · /review-epic · /fix-epic). The deterministic prelude is done — do NOT re-run triage."
	echo
	echo "## Bundle artifacts ($HARNESS_DIR)"
	echo "- \`epic.json\` — the ordered bead list (ordinal, id, title, deps, dir, record)"
	echo "- \`epic-map.md\` — the thin shared epic map (goal + sibling one-liners + bvr highlights)"
	echo "- \`order.txt\` — the execution order (\`<NN>-<bead-id>\`)"
	echo "- \`beads/<NN-id>/spec-files.txt\` + \`meta.env\` — each bead's pre-baked spec slice + metadata"
	[ -n "$PR" ] && echo "- \`pr.json\` — the epic PR's review state (title/body/reviews/comments/commits)"
	echo
	echo "Work the beads in \`order.txt\` order. Beads stay \`open\` until the reviewer batch-closes at the end."
} >"$HARNESS_DIR/CONTEXT.md"

if [ "$DRY" = 1 ]; then
	echo "start-epic (dry-run${PR:+, review/fix PR #$PR}): epic $ID — ${#ORDER[@]} beads"
	echo "  order: ${ORDER[*]}"
	if [ -n "$PR" ]; then echo "  would checkout PR branch $branch + write pr.json"
	else echo "  would branch $branch off origin/$(default_branch); beads stay open (no claim)"; fi
	echo "  bundle: $HARNESS_DIR"
	exit 0
fi

if [ -n "$PR" ]; then
	checkout_pr_branch "$branch"
	echo "start-epic (review/fix): epic $ID, PR #$PR — ${#ORDER[@]} beads on branch $branch"
else
	git checkout -q -b "$branch" "origin/$(default_branch)"
	echo "start-epic (implement): epic $ID — ${#ORDER[@]} beads on branch $branch; beads remain open"
fi
echo "bundle: $HARNESS_DIR"
