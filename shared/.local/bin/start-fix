#!/usr/bin/env bash
# start-fix <pr-number> [--dry-run]
#
# Deterministic prelude for the `fix` skill, run OUTSIDE the agent: fetch the PR's
# review feedback proxy-side (the agent has no gh), check out the PR branch, and
# write the bundle. Shared logic lives in prelude-common.sh.
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/prelude-common.sh"

prelude_parse_args fix "$@" # ID = PR number
preflight

prjson=$(pr_fetch "$ID") || die "portitor pr fetch --pr $ID failed"
branch=$(jq -r '.headRefName // empty' <<<"$prjson")
[ -n "$branch" ] || die "PR #$ID has no headRefName in the fetch result"

if [ "$DRY" = 1 ]; then
	echo "prelude fix (dry-run): PR #$ID on branch $branch; would checkout + bundle"
	exit 0
fi

checkout_pr_branch "$branch"
rm -rf "$HARNESS_DIR"
mkdir -p "$HARNESS_DIR"
printf '%s\n' "$prjson" >"$HARNESS_DIR/pr.json"
{
	echo "SKILL=fix"
	echo "PR=$ID"
	echo "BRANCH=$branch"
} >"$HARNESS_DIR/bundle.env"
{
	echo "# Prelude bundle — fix"
	echo
	echo "On PR branch \`$branch\` (PR #$ID). The PR's review feedback (review bodies + inline comments) is in \`$HARNESS_DIR/pr.json\`."
	echo
	echo "## Your job"
	echo "Read every actionable item in pr.json (.reviews[] bodies + .comments[] inline), fix each in the code, commit and push the branch (re-push updates the PR via portitor). Reply per item via \`portitor pr comment --pr $ID\` (body on stdin) — portitor mediates GitHub; you have no gh. Commits must be signed; do NOT push to the default branch."
} >"$HARNESS_DIR/CONTEXT.md"

echo "prelude fix: PR #$ID on branch $branch; bundle in $HARNESS_DIR"
