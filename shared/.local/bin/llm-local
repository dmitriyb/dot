#!/usr/bin/env bash
# llm-local — stand up the host-side local model a faber -li project declares.
#
#   llm-local up --project <dir> --instance <name>
#
# Reads <project>/local-llm.json (committed project data, not host state).
# Common fields: model (served id), port, context_length, parallel, sidecar.
# Engine selection: "engine": "lms" (default) or "llama-server".
#
#   lms          — LM Studio: optional model_config (JSON installed over LM
#                  Studio's per-model config, reload forced on drift),
#                  speculative_mtp flag.
#   llama-server — llama.cpp server: gguf (path, absolute or relative to LM
#                  Studio's models dir — reuses its downloads), chat_template
#                  (name of a .jinja under llm-local/model-configs/),
#                  server_args (verbatim llama-server flags: reasoning,
#                  speculation, sampling, caps — config as data).
#
# Both engines end the same way: wait for /v1/models, run a tool-calling
# preflight (temperature 0, 3 attempts) that must return structured
# tool_calls, then join the docker sidecar to the instance network.
set -euo pipefail

die() { echo "llm-local: $1" >&2; exit "${2:-1}"; }
usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' >&2; exit "${1:-0}"; }

[[ $# -gt 0 ]] || usage 2
case "$1" in -h|--help) usage 0 ;; esac
VERB="$1"; shift
[[ "$VERB" == up ]] || die "unknown verb: $VERB (want up)" 2

PROJECT=""; INSTANCE=""
need_val() { [[ $# -ge 2 ]] || die "$1 needs a value" 2; }
while [[ $# -gt 0 ]]; do
	case "$1" in
		--project)  need_val "$@"; PROJECT="$2"; shift 2 ;;
		--instance) need_val "$@"; INSTANCE="$2"; shift 2 ;;
		-h|--help)  usage 0 ;;
		*)          die "unknown flag: $1 (see --help)" 2 ;;
	esac
done
[[ -d "$PROJECT" ]] || die "missing or invalid --project dir: '$PROJECT'" 2

MANIFEST="$PROJECT/local-llm.json"
[[ -f "$MANIFEST" ]] || die "no local-llm.json in $PROJECT" 1
for t in jq curl; do command -v "$t" >/dev/null || die "'$t' not found on PATH" 1; done
jq empty "$MANIFEST" 2>/dev/null || die "not valid JSON: $MANIFEST" 1

MODEL="$(jq -er '.model // empty' "$MANIFEST")" || die "manifest missing 'model'" 1
# No -e on the defaulted fields: jq -e exits 1 when the OUTPUT is false/null,
# which a legitimate "sidecar": false would trip under set -e.
PORT="$(jq -r '.port // 1234' "$MANIFEST")"
CTX="$(jq -r '.context_length // 32768' "$MANIFEST")"
SIDECAR="$(jq -r '.sidecar // false' "$MANIFEST")"
PARALLEL="$(jq -r '.parallel // empty' "$MANIFEST")"
ENGINE="$(jq -r '.engine // "lms"' "$MANIFEST")"
BASE="http://localhost:${PORT}"

# Resolve a name under llm-local/model-configs/: the stowed XDG path first,
# then relative to the manifest's real location in the repo (works pre-stow).
resolve_config() { # <basename with extension>
	local p="${XDG_DATA_HOME:-$HOME/.local/share}/llm-local/model-configs/$1"
	[[ -f "$p" ]] || p="$(cd "$(dirname "$(realpath "$MANIFEST")")/../../.." && pwd)/.local/share/llm-local/model-configs/$1"
	[[ -f "$p" ]] || die "'$1' not found under llm-local/model-configs/" 1
	printf '%s' "$p"
}

echo "llm-local: engine=$ENGINE model=$MODEL port=$PORT context=$CTX sidecar=$SIDECAR" >&2

case "$ENGINE" in
# ------------------------------------------------------------------ lms ----
lms)
	command -v lms >/dev/null || die "'lms' not found on PATH" 1
	MTP="$(jq -r '.speculative_mtp // false' "$MANIFEST")"
	MODEL_CONFIG="$(jq -r '.model_config // empty' "$MANIFEST")"

	# 0) converge the LM Studio per-model config (template, sampling caps,
	#    draft settings). Schema is LM Studio-internal (reverse-engineered
	#    2026-08-19; the GUI rewrites the installed file if those settings are
	#    touched there). A change forces a model reload below so it binds.
	NEED_RELOAD=false
	if [[ -n "$MODEL_CONFIG" ]]; then
		src="$(resolve_config "${MODEL_CONFIG}.json")"
		jq empty "$src" 2>/dev/null || die "model_config is not valid JSON: $src" 1
		lms_internal=""
		for d in "$HOME/.cache/lm-studio/.internal" "$HOME/.lmstudio/.internal"; do
			[[ -d "$d" ]] && { lms_internal="$d"; break; }
		done
		[[ -n "$lms_internal" ]] || die "no LM Studio internal dir found (.cache/lm-studio or .lmstudio)" 1
		dst="$lms_internal/user-concrete-model-default-config/${MODEL}.json"
		if ! cmp -s "$src" "$dst" 2>/dev/null; then
			mkdir -p "$(dirname "$dst")"
			[[ -f "$dst" ]] && cp "$dst" "$dst.bak"
			cp "$src" "$dst"
			NEED_RELOAD=true
			echo "llm-local: installed model config '$MODEL_CONFIG' -> $dst (reload forced)" >&2
		fi
	fi

	# 1) server (idempotent; lms prints its own already-running notice)
	lms server start >/dev/null 2>&1 || die "lms server start failed" 1

	# 2) load unless already resident. Known limit: a resident model keeps the
	# parameters it was loaded with — after changing context_length/parallel in
	# the manifest, `lms unload` once so the next run reloads with the new
	# values. A converged model_config DOES force the reload.
	if $NEED_RELOAD && lms ps 2>/dev/null | grep -qF "$MODEL"; then
		echo "llm-local: unloading $MODEL to apply the new model config" >&2
		lms unload "$MODEL" >/dev/null 2>&1 || die "lms unload $MODEL failed" 1
	fi
	if lms ps 2>/dev/null | grep -qF "$MODEL"; then
		echo "llm-local: $MODEL already loaded (params from its original load)" >&2
	else
		load_args=(--context-length "$CTX")
		[[ -n "$PARALLEL" ]] && load_args+=(--parallel "$PARALLEL")
		[[ "$MTP" == true ]] && load_args+=(--speculative-draft-mtp)
		echo "llm-local: loading $MODEL (${load_args[*]})" >&2
		lms load "$MODEL" "${load_args[@]}" -y >/dev/null 2>&1 || die "lms load $MODEL failed" 1
	fi
	;;
# --------------------------------------------------------- llama-server ----
llama-server)
	command -v llama-server >/dev/null || die "'llama-server' not found on PATH (brew install llama.cpp)" 1
	GGUF="$(jq -er '.gguf // empty' "$MANIFEST")" || die "engine llama-server needs 'gguf' in the manifest" 1
	[[ "$GGUF" = /* ]] || GGUF="$HOME/.cache/lm-studio/models/$GGUF"
	[[ -f "$GGUF" ]] || die "gguf not found: $GGUF" 1
	TPL_NAME="$(jq -r '.chat_template // empty' "$MANIFEST")"
	TPL=""
	[[ -n "$TPL_NAME" ]] && TPL="$(resolve_config "${TPL_NAME}.jinja")"

	state="${XDG_STATE_HOME:-$HOME/.local/state}/llm-local"
	mkdir -p "$state"
	pidfile="$state/llama-server.pid"
	cmdfile="$state/llama-server.cmd"
	logfile="$state/llama-server.log"

	args=(-m "$GGUF" --host 127.0.0.1 --port "$PORT" --alias "$MODEL" -c "$CTX" --jinja)
	[[ -n "$PARALLEL" ]] && args+=(-np "$PARALLEL")
	[[ -n "$TPL" ]] && args+=(--chat-template-file "$TPL")
	while IFS= read -r a; do args+=("$a"); done < <(jq -r '.server_args[]? // empty' "$MANIFEST")

	# Reuse a running server ONLY when its command line AND the template file
	# content match the manifest's — anything else is stale params, the failure
	# mode the lms engine taught us. Otherwise stop it and start fresh.
	tplsum=""; [[ -n "$TPL" ]] && tplsum="$(cksum < "$TPL")"
	want="llama-server ${args[*]} tpl:$tplsum"
	if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null && [[ "$(cat "$cmdfile" 2>/dev/null)" == "$want" ]] \
		&& curl -sf -m 3 "$BASE/health" >/dev/null 2>&1; then
		echo "llm-local: llama-server already running with the declared args" >&2
	else
		if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
			echo "llm-local: restarting llama-server (args changed)" >&2
			kill "$(cat "$pidfile")" 2>/dev/null || true
			sleep 1
		fi
		# Free the port from LM Studio's server if it holds it (local op).
		if command -v lms >/dev/null && curl -sf -m 2 "$BASE/health" >/dev/null 2>&1; then
			echo "llm-local: stopping LM Studio server on :$PORT" >&2
			lms server stop >/dev/null 2>&1 || true
			sleep 1
		fi
		curl -sf -m 2 "$BASE/health" >/dev/null 2>&1 && die "port $PORT still occupied by another server" 1
		echo "llm-local: starting llama-server ($GGUF)" >&2
		nohup llama-server "${args[@]}" >> "$logfile" 2>&1 &
		echo $! > "$pidfile"
		printf '%s' "$want" > "$cmdfile"
	fi

	# Model load can take a while; /health turns ok when the server is ready.
	for _ in $(seq 1 60); do
		curl -sf -m 3 "$BASE/health" >/dev/null 2>&1 && break
		kill -0 "$(cat "$pidfile")" 2>/dev/null || die "llama-server died during startup — see $logfile" 1
		sleep 2
	done
	curl -sf -m 3 "$BASE/health" >/dev/null 2>&1 || die "llama-server not healthy after 120s — see $logfile" 1
	;;
*)
	die "unknown engine '$ENGINE' (lms | llama-server)" 2
	;;
esac

# 3) the API must list the model id
for _ in $(seq 1 30); do
	curl -sf -m 5 "$BASE/v1/models" 2>/dev/null | jq -er --arg m "$MODEL" \
		'.data[]? | select(.id == $m) | .id' >/dev/null && break
	sleep 2
done
curl -sf -m 5 "$BASE/v1/models" | jq -er --arg m "$MODEL" \
	'.data[]? | select(.id == $m) | .id' >/dev/null \
	|| die "$MODEL not served on $BASE" 1

# 4) tool-calling preflight (real generations; seconds on a warm model).
#    temperature 0 for determinism, and up to 3 attempts: a single sample can
#    legitimately answer without a tool call — a one-shot check fails randomly.
echo "llm-local: tool-calling preflight" >&2
TC=""
for attempt in 1 2 3; do
	TC="$(curl -sf -m 180 "$BASE/v1/chat/completions" -H 'Content-Type: application/json' -d "$(jq -cn --arg m "$MODEL" '{
		model: $m,
		temperature: 0,
		messages: [{role: "user", content: "What is the weather in Paris? You MUST use the tool."}],
		tools: [{type: "function", "function": {name: "get_weather",
			parameters: {type: "object", properties: {city: {type: "string"}}, required: ["city"]}}}]
	}')" | jq -r '.choices[0].message.tool_calls // empty')"
	[[ -n "$TC" ]] && break
	echo "llm-local: preflight attempt $attempt produced no tool_calls; retrying" >&2
done
[[ -n "$TC" ]] || die "preflight FAILED 3x: $MODEL emitted no tool_calls — fix quant/template/runtime before spending agent runs" 1
echo "llm-local: preflight ok — $MODEL emits tool_calls" >&2

# 5) sidecar (needs the instance network -> run after faber-stack up)
if [[ "$SIDECAR" == true ]]; then
	[[ -n "$INSTANCE" ]] || die "manifest wants a sidecar but no --instance given" 2
	command -v llm-sidecar >/dev/null || die "'llm-sidecar' not found on PATH" 1
	llm-sidecar up --instance "$INSTANCE" --port "$PORT"
fi

echo "llm-local: up complete" >&2
