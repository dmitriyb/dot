#!/usr/bin/env bash
# secret-get — print one secret from this host's secrets backend (host.conf's
# secrets.backend), so a tool that takes a token command — portitor deploy's
# token_command — never needs to know which backend a host uses.
set -euo pipefail

usage() {
	echo "Usage: secret-get <service> [account]" >&2
	exit "${1:-2}"
}
case "${1:-}" in -h | --help) usage 0 ;; "") usage 2 ;; esac
[[ $# -le 2 ]] || usage 2

lib="$HOME/.local/libexec/docker-claude/agent-common.sh"
[[ -f "$lib" ]] || { echo "secret-get: $lib not found — run dot's setup.sh" >&2; exit 1; }
# shellcheck source=../libexec/docker-claude/agent-common.sh
source "$lib"
backend="$(_secrets_backend)" || exit 1
# Printed at the moment of the read, so a keychain or YubiKey prompt can be
# attributed to it.
echo "secret-get: reading $1${2:+/$2} from $backend" >&2
keychain_require "$1" "${2:-}" "secret $1${2:+/$2}" ""
