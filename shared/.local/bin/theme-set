#!/bin/bash
# Portable theme switcher for macOS (and Linux without omarchy)
# Usage: theme-set [theme-name]

THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/themes"
THEME_NAME="$1"

if [ -z "$THEME_NAME" ] || [ "$THEME_NAME" = "-h" ] || [ "$THEME_NAME" = "--help" ]; then
    echo "Usage: theme-set <theme-name>"
    echo "Run 'theme-list' to see available themes"
    exit 0
fi

if [ ! -d "$THEMES_DIR/$THEME_NAME" ]; then
    echo "Theme not found: $THEME_NAME"
    exit 1
fi

# Update current symlink
ln -sfn "$THEME_NAME" "$THEMES_DIR/current"

# Update starship palette if starship.toml exists
STARSHIP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
if [ -f "$STARSHIP_CONFIG" ]; then
    # Resolve symlink if needed (macOS sed -i doesn't work on symlinks; realpath
    # and readlink -f are absent on stock macOS, so resolve one level by hand —
    # stow symlinks are single-level).
    if [ -L "$STARSHIP_CONFIG" ]; then
        _starship_target="$(readlink "$STARSHIP_CONFIG")"
        case "$_starship_target" in
            /*) STARSHIP_CONFIG="$_starship_target" ;;
            *)  STARSHIP_CONFIG="$(cd "$(dirname "$STARSHIP_CONFIG")" && pwd)/$_starship_target" ;;
        esac
    fi
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "s/^palette = .*/palette = \"$THEME_NAME\"/" "$STARSHIP_CONFIG"
    else
        sed -i "s/^palette = .*/palette = \"$THEME_NAME\"/" "$STARSHIP_CONFIG"
    fi
fi

# Reload fish theme
if command -v fish &>/dev/null; then
    pkill -USR1 fish 2>/dev/null || true
fi

# Reload tmux theme
if command -v tmux &>/dev/null && tmux list-sessions &>/dev/null; then
    tmux source-file ~/.config/tmux/tmux.conf 2>/dev/null
fi

# Reload ghostty config
if pgrep -x ghostty &>/dev/null; then
    killall -SIGUSR2 ghostty 2>/dev/null || true
fi

# Update btop theme symlink and reload
BTOP_THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/btop/themes"
if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/btop" ]; then
    mkdir -p "$BTOP_THEMES_DIR"
    ln -sfn "$THEMES_DIR/current/btop.theme" "$BTOP_THEMES_DIR/current.theme"
    if pgrep -x btop &>/dev/null; then
        pkill -USR2 btop 2>/dev/null || true
    fi
fi

# Update tuicr theme symlink. tuicr has no hot-reload and is launched per review, so
# the new theme applies on its next launch (no signal needed). Guarded on a REAL dir:
# until setup.sh makes ~/.config/tuicr a real directory it's a stow symlink into the
# repo, and writing there would land the runtime symlink inside the repo — so skip it.
TUICR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tuicr"
if [ -d "$TUICR_DIR" ] && [ ! -L "$TUICR_DIR" ]; then
    mkdir -p "$TUICR_DIR/themes"
    ln -sfn "$THEMES_DIR/current/tuicr.toml" "$TUICR_DIR/themes/current.toml"
fi

# Reload neovim colorscheme (if nvr is installed)
if command -v nvr &>/dev/null; then
    THEME_FILE="$THEMES_DIR/$THEME_NAME/neovim.lua"
    if [ -f "$THEME_FILE" ]; then
        # Extract colorscheme name from neovim.lua
        COLORSCHEME=$(grep -o 'colorscheme = "[^"]*"' "$THEME_FILE" | cut -d'"' -f2)
        if [ -n "$COLORSCHEME" ]; then
            nvr --nostart --remote-send "<Cmd>colorscheme $COLORSCHEME<CR>" 2>/dev/null || true
        fi
    fi
fi

echo "Theme: $THEME_NAME"
