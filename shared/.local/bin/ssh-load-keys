#!/usr/bin/env bash
# ssh-load-keys — load the named resident FIDO2 keys from the YubiKey into the
# running ssh-agent, and nothing else.
#
# An allowlist, not a denylist: the main agent is forwarded into containers, so a
# key that is merely forgotten must stay out of it rather than slip in.
set -euo pipefail

usage() {
	cat >&2 <<'EOF2'
Usage: ssh-load-keys <application> ...   load these (application ssh:<name>)
       ssh-load-keys                     list what the YubiKey holds, pick by index

Downloads the YubiKey's resident keys (PIN + one touch), adds only the named
ones to the running ssh-agent, checks the agent holds them, and deletes the
downloaded handle files.
EOF2
	exit "${1:-0}"
}
for a in "$@"; do
	case "$a" in
		-h | --help) usage 0 ;;
		-*) echo "ssh-load-keys: unknown option: $a" >&2; usage 2 ;;
	esac
done
[[ $# -gt 0 || -t 0 ]] || { echo "ssh-load-keys: name the keys to load, or run it on a terminal to pick them" >&2; usage 2; }
[[ -S "${SSH_AUTH_SOCK:-}" ]] || { echo "ssh-load-keys: no ssh-agent (SSH_AUTH_SOCK unset or not a socket)" >&2; exit 1; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

echo "ssh-load-keys: downloading resident keys (PIN + one touch)…" >&2
(cd "$tmp" && ssh-keygen -K -N "" >/dev/null)

shopt -s nullglob
declare -a FILE APP FP
for f in "$tmp"/id_*_sk_rk_*; do
	[[ "$f" == *.pub ]] && continue
	FILE+=("$f")
	APP+=("${f##*_sk_rk_}")
	FP+=("$(ssh-keygen -lf "$f.pub" | awk '{print $2}')")
done
[[ ${#FILE[@]} -gt 0 ]] || { echo "ssh-load-keys: the YubiKey holds no resident keys" >&2; exit 1; }
listing() { for i in "${!FILE[@]}"; do printf '  %d  %-28s %s\n' "$((i + 1))" "${APP[$i]}" "${FP[$i]}" >&2; done; }

chosen=()
if [[ $# -gt 0 ]]; then
	for name in "$@"; do
		hits=()
		for i in "${!APP[@]}"; do [[ "${APP[$i]}" == "$name" ]] && hits+=("$i"); done
		if [[ ${#hits[@]} -ne 1 ]]; then
			echo "ssh-load-keys: ${#hits[@]} resident keys match '$name' (need exactly 1); nothing loaded. The YubiKey holds:" >&2
			listing; exit 1
		fi
		chosen+=("${hits[0]}")
	done
else
	echo "ssh-load-keys: resident keys on the YubiKey:" >&2
	listing
	echo "Indices to load, space-separated; empty line to quit:" >&2
	read -r line || line=""
	[[ -n "${line// /}" ]] || { echo "ssh-load-keys: nothing chosen" >&2; exit 0; }
	for n in $line; do
		[[ "$n" =~ ^[0-9]+$ && "$n" -ge 1 && "$n" -le ${#FILE[@]} ]] || { echo "ssh-load-keys: '$n' is not an index from the list; nothing loaded" >&2; exit 2; }
		chosen+=("$((n - 1))")
	done
fi

for i in "${chosen[@]}"; do
	ssh-add "${FILE[$i]}" || { echo "ssh-load-keys: ssh-add failed for ${APP[$i]}" >&2; exit 1; }
done

agent="$(ssh-add -l 2>/dev/null || true)"
missing=0
for i in "${chosen[@]}"; do
	if grep -qF " ${FP[$i]} " <<<"$agent"; then
		echo "ssh-load-keys: ${APP[$i]} loaded (${FP[$i]})" >&2
	else
		echo "ssh-load-keys: ${APP[$i]} (${FP[$i]}) is NOT in the agent after ssh-add" >&2
		missing=1
	fi
done
exit "$missing"
