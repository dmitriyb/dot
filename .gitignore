# Backup files
.backup/

# faber run artifacts (journals/logs/box results). faber writes a .faber/ run dir
# in its working dir; ignore it anywhere so a run from the repo root never commits it.
.faber/

# Claude Code (user's local config at repo root; NOT the tracked shared/.claude package)
/.claude/

# macOS
.DS_Store

# Editor
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak

__pycache__/
*.pyc

# nix-build default output symlinks (egress-image.nix, goose-image.nix)
result
result-*

# goose-local scratch: runtime workspace mounted into the container
docker/goose-local/workspace/
